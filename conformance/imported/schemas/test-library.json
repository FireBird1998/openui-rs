{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "Button": {
   "$ref": "#/$defs/Button"
  }
 },
 "required": [
  "Button"
 ],
 "additionalProperties": false,
 "$defs": {
  "Button": {
   "type": "object",
   "properties": {
    "label": {
     "type": "string"
    },
    "action": {
     "$ref": "#/$defs/ActionExpression"
    },
    "share": {
     "anyOf": [
      {
       "$ref": "#/$defs/ToAssistant"
      },
      {
       "$ref": "#/$defs/OpenUrl"
      }
     ]
    }
   },
   "required": [
    "label"
   ],
   "additionalProperties": false,
   "description": "A button"
  },
  "ActionExpression": {
   "anyOf": [
    {
     "type": "object",
     "properties": {
      "type": {
       "type": "string",
       "const": "open_url"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "type",
      "url"
     ],
     "additionalProperties": false
    },
    {
     "type": "object",
     "properties": {
      "type": {
       "type": "string",
       "const": "continue_conversation"
      },
      "context": {
       "type": "string"
      }
     },
     "required": [
      "type"
     ],
     "additionalProperties": false
    },
    {
     "type": "object",
     "properties": {
      "type": {
       "type": "string"
      },
      "params": {
       "type": "object",
       "propertyNames": {
        "type": "string"
       },
       "additionalProperties": {}
      }
     },
     "required": [
      "type"
     ],
     "additionalProperties": false
    }
   ]
  },
  "ToAssistant": {
   "type": "object",
   "properties": {
    "type": {
     "type": "string",
     "const": "continue_conversation"
    },
    "context": {
     "type": "string"
    }
   },
   "required": [
    "type"
   ],
   "additionalProperties": false
  },
  "OpenUrl": {
   "type": "object",
   "properties": {
    "type": {
     "type": "string",
     "const": "open_url"
    },
    "url": {
     "type": "string"
    }
   },
   "required": [
    "type",
    "url"
   ],
   "additionalProperties": false
  }
 }
}
