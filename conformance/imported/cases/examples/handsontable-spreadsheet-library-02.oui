root = Stack([title, chart, followups])
title = TextContent("Q1-Q4 Revenue Comparison", "large-heavy")
chart = BarChart(["Q1", "Q2", "Q3", "Q4"], [s1, s2], "grouped", "Quarter", "Revenue ($)")
s1 = Series("Widget A", [1500, 1800, 2100, 2400])
s2 = Series("Widget B", [1200, 1400, 1600, 1900])
followups = Buttons([Button("Show as a table", null, "secondary"), Button("Compare Q1 vs Q4", null, "secondary")])