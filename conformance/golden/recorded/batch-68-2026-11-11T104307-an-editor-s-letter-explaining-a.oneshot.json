{"root":{"type":"element","typeName":"Stack","props":{"children":[{"type":"element","typeName":"TextContent","props":{"text":"The Weekend Edition","size":"large-heavy"},"partial":false,"hasDynamicProps":false,"statementId":"masthead"},{"type":"element","typeName":"Card","props":{"children":[{"type":"element","typeName":"CardHeader","props":{"title":"A Letter from the Editor","subtitle":"Introducing our new weekend edition"},"partial":false,"hasDynamicProps":false,"statementId":"letterHeader"},{"type":"element","typeName":"MarkDownRenderer","props":{"textMarkdown":"Dear readers,\n\nAfter years of listening to your feedback, we are excited to introduce **The Weekend Edition**: a slower, more thoughtful companion to our weekday coverage. Saturdays and Sundays will bring longer essays, deeper reporting, and stories that reward an unhurried read with a cup of coffee.\n\nYou will find three new regular sections waiting for you each weekend. We hope they become a place to pause, reflect, and discover something unexpected.\n\nThank you for reading, and for helping us shape what comes next.\n\nWarmly,\n\nThe Editorial Team","variant":"clear"},"partial":false,"hasDynamicProps":false,"statementId":"letterBody"}]},"partial":false,"hasDynamicProps":false,"statementId":"letter"},{"type":"element","typeName":"InlineHeader","props":{"heading":"Inside Each Weekend","description":"Three sample sections to start"},"partial":false,"hasDynamicProps":false,"statementId":"sectionsHeader"},{"type":"element","typeName":"Stack","props":{"children":[{"type":"element","typeName":"Card","props":{"children":[{"type":"element","typeName":"CardHeader","props":{"title":"The Long Read","subtitle":"Feature journalism"},"partial":false,"hasDynamicProps":false,"statementId":"sec1Title"},{"type":"element","typeName":"TextContent","props":{"text":"One in-depth story each week, reported over months and written to be savored from start to finish."},"partial":false,"hasDynamicProps":false,"statementId":"sec