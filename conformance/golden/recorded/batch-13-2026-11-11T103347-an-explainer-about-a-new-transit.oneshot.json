{"root":{"type":"element","typeName":"Stack","props":{"children":[{"type":"element","typeName":"CardHeader","props":{"title":"New Transit Fare System","subtitle":"Everything riders need to know about the upcoming changes"},"partial":false,"hasDynamicProps":false,"statementId":"header"},{"type":"element","typeName":"Callout","props":{"variant":"info","title":"Rollout Date","description":"The new tap-to-pay fare system begins on the first of next month across all bus, tram, and rail lines."},"partial":false,"hasDynamicProps":false,"statementId":"intro"},{"type":"element","typeName":"Accordion","props":{"items":[{"type":"element","typeName":"AccordionItem","props":{"value":"q1","trigger":"What is changing?","content":[{"type":"element","typeName":"TextContent","props":{"text":"Paper tickets and fixed zone fares are being replaced by a **tap-in, tap-out** system. Fares are now calculated by distance traveled, and you pay with a contactless card, phone, or a reloadable transit card."},"partial":false,"hasDynamicProps":false,"statementId":"a1"}]},"partial":false,"hasDynamicProps":false,"statementId":"q1"},{"type":"element","typeName":"AccordionItem","props":{"value":"q2","trigger":"How much will I pay?","content":[{"type":"element","typeName":"TextContent","props":{"text":"Fares depend on the distance of your trip. A daily cap ensures you never pay more than the price of a day pass."},"partial":false,"hasDynamicProps":false,"statementId":"a2"},{"type":"element","typeName":"Table","props":{"columns":[{"type":"element","typeName":"Col","props":{"label":"Trip Distance","data":["Up to 3 km","3 to 10 km","Over 10 km"]},"partial":false,"hasDynamicProps":false},{"type":"element","typeName":"Col","props":{"label":"Fare","data":["$1.75","$2.50","$3.75"]},"partial":false,"hasDynamicProps":false},{"type":"element","typeName":"Col","props":{"label":"Daily Cap","data":["$6.00","$6.00","$6.00"]},"partial":false,"hasDynamicProps":false}]},"partial":false,"hasDynamicProps":false,"stateme