{"root":{"type":"element","typeName":"Stack","props":{"children":[{"type":"element","typeName":"InlineHeader","props":{"heading":"Reader Letters","description":"Letters from our readers across the region"},"partial":false,"hasDynamicProps":false,"statementId":"pageHeader"},{"type":"element","typeName":"Card","props":{"children":[{"type":"element","typeName":"CardHeader","props":{"title":"The Lighthouse Question","subtitle":"From Margaret Doyle, Port Halden"},"partial":false,"hasDynamicProps":false,"statementId":"letter1Header"},{"type":"element","typeName":"TextContent","props":{"text":"I have walked past the old lighthouse every morning for forty years. Last week the council announced its repairs, and I wanted to thank everyone who fought to keep it standing. It is more than a landmark; it is how this town knows where home is."},"partial":false,"hasDynamicProps":false,"statementId":"letter1Body"}]},"partial":false,"hasDynamicProps":false,"statementId":"letter1"},{"type":"element","typeName":"Card","props":{"children":[{"type":"element","typeName":"CardHeader","props":{"title":"Buses Running Late Again","subtitle":"From Tomasz Nowak, Eastbrook"},"partial":false,"hasDynamicProps":false,"statementId":"letter2Header"},{"type":"element","typeName":"TextContent","props":{"text":"The number 14 bus has arrived late every weekday this month. Parents waiting at the school gate have started walking instead, and the timetable on the stop board has not been updated since spring. Please look into it before winter."},"partial":false,"hasDynamicProps":false,"statementId":"letter2Body"}]},"partial":false,"hasDynamicProps":false,"statementId":"letter2"},{"type":"element","typeName":"Card","props":{"children":[{"type":"element","typeName":"CardHeader","props":{"title":"Thanks to the Library Volunteers","subtitle":"From Priya Raman, Millbrook Village"},"partial":false,"hasDynamicProps":false,"statementId":"letter3Header"},{"type":"element","typeName":"TextContent","props":{"text":"When the library's heating broke in January, a group of volunteers organised a reading marathon to keep the doors open. They kept the children's corner warm with space heaters and hot chocolate. Our village is lucky to have them."},"partial":false,"hasDynamicProps":false,"statementId":"letter3Body"}]},"partial":false,"hasDynamicProps":false,"statementId":"letter3"},{"type":"element","typeName":"InlineHeader","props":{"heading":"Submit a Letter","description":"Share your thoughts with our readers"},"partial":false,"hasDynamicProps":false,"statementId":"formHeader"},{"type":"element","typeName":"Form","props":{"name":"letter","buttons":{"type":"element","typeName":"Buttons","props":{"buttons":[{"type":"element","typeName":"Button","props":{"label":"Submit Letter","action":{"k":"Comp","name":"ToAssistant","args":[{"k":"Str","v":"Submit a new reader letter"}],"mappedProps":{"message":{"k":"Str","v":"Submit a new reader letter"}}},"variant":"primary"},"partial":false,"hasDynamicProps":true},{"type":"element","typeName":"Button","props":{"label":"Clear","action":{"k":"Comp","name":"ToAssistant","args":[{"k":"Str","v":"Clear the letter form"}],"mappedProps":{"message":{"k":"Str","v":"Clear the letter form"}}},"variant":"secondary"},"partial":false,"hasDynamicProps":true}]},"partial":false,"hasDynamicProps":true,"statementId":"letterButtons"},"fields":[{"type":"element","typeName":"FormControl","props":{"label":"Your Name","input":{"type":"element","typeName":"Input","props":{"name":"name","placeholder":"Full name","type":"text","rules":{"required":true,"minLength":2}},"partial":false,"hasDynamicProps":false}},"partial":false,"hasDynamicProps":false,"statementId":"nameField"},{"type":"element","typeName":"FormControl","props":{"label":"Town","input":{"type":"element","typeName":"Input","props":{"name":"town","placeholder":"e.g. Port Halden","type":"text","rules":{"required":true}},"partial":false,"hasDynamicProps":false}},"partial":false,"hasDynamicProps":false,"statementId":"