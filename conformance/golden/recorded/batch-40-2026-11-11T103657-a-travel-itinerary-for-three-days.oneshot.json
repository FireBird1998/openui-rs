{"root":{"type":"element","typeName":"Stack","props":{"children":[{"type":"element","typeName":"InlineHeader","props":{"heading":"Lisbon in Three Days","description":"A relaxed itinerary covering history, food, and viewpoints"},"partial":false,"hasDynamicProps":false,"statementId":"header"},{"type":"element","typeName":"Tabs","props":{"items":[{"type":"element","typeName":"TabItem","props":{"value":"day1","trigger":"Day 1","content":[{"type":"element","typeName":"Card","props":{"children":[{"type":"element","typeName":"CardHeader","props":{"title":"Day 1: Historic Lisbon","subtitle":"Alfama and the riverfront"},"partial":false,"hasDynamicProps":false,"statementId":"day1Header"},{"type":"element","typeName":"TextContent","props":{"text":"**Morning:** Climb to São Jorge Castle early for panoramic views over the red rooftops, then wander the narrow lanes of Alfama.","size":"default"},"partial":false,"hasDynamicProps":false,"statementId":"day1Morning"},{"type":"element","typeName":"TextContent","props":{"text":"**Afternoon:** Visit the Lisbon Cathedral (Sé) and take Tram 28 through Graça and Baixa.","size":"default"},"partial":false,"hasDynamicProps":false,"statementId":"day1Afternoon"},{"type":"element","typeName":"TextContent","props":{"text":"**Evening:** Enjoy fado music at a traditional tasca in Alfama, followed by grilled sardines for dinner.","size":"default"},"partial":false,"hasDynamicProps":false,"statementId":"day1Evening"}]},"partial":false,"hasDynamicProps":false,"statementId":"day1Card"}]},"partial":false,"hasDynamicProps":false,"statementId":"day1"},{"type":"element","typeName":"TabItem","props":{"value":"day2","trigger":"Day 2","content":[{"type":"element","typeName":"Card","props":{"children":[{"type":"element","typeName":"CardHeader","props":{"title":"Day 2: Belém and the Coast","subtitle":"Monuments and pastries"},"partial":false,"hasDynamicProps":false,"statementId":"day2Header"},{"type":"element","typeName":"TextContent","props":{"text":"**Morning:*