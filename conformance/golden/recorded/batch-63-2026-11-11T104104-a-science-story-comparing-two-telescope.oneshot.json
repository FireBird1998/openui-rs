{"root":{"type":"element","typeName":"Stack","props":{"children":[{"type":"element","typeName":"TextContent","props":{"text":"Two Windows on the Universe: Hubble vs. James Webb","size":"large-heavy"},"partial":false,"hasDynamicProps":false,"statementId":"title"},{"type":"element","typeName":"TextContent","props":{"text":"Two space telescopes, two landmark discoveries. The Hubble Deep Field (1995) showed that the 'empty' sky holds thousands of galaxies. Webb's First Deep Field (2022) looked even farther back, revealing galaxies shaped when the universe was very young."},"partial":false,"hasDynamicProps":false,"statementId":"intro"},{"type":"element","typeName":"InlineHeader","props":{"heading":"Observation Facts","description":"Side-by-side comparison of the two discoveries"},"partial":false,"hasDynamicProps":false,"statementId":"compareHeader"},{"type":"element","typeName":"Table","props":{"columns":[{"type":"element","typeName":"Col","props":{"label":"Feature","data":["Year","Telescope launched","Main light observed","Mirror size","Patch of sky","Galaxies seen","Furthest look-back","Key finding"]},"partial":false,"hasDynamicProps":false},{"type":"element","typeName":"Col","props":{"label":"Hubble Deep Field","data":["1995","1990","Visible and some ultraviolet","2.4 m","About a grain of sand held at arm's length","About 3,000","About 12 billion years","The dark sky patch is crowded with galaxies"]},"partial":false,"hasDynamicProps":false},{"type":"element","typeName":"Col","props":{"label":"Webb's First Deep Field","data":["2022","2021","Infrared","6.5 m","About a grain of sand held at arm's length","Thousands, in far greater detail","More than 13 billion years","Very early galaxies, already surprisingly mature"]},"partial":false,"hasDynamicProps":false}]},"partial":false,"hasDynamicProps":false,"statementId":"tbl"},{"type":"element","typeName":"InlineHeader","props":{"heading":"Images","description":"Look up the official pictures at the links below"},"partial":false,"hasDynamicProps":false,"statementId":"imgHeader"},{"type":"element","typeName":"Buttons","props":{"buttons":[{"type":"element","typeName":"Button","props":{"label":"View Hubble Deep Field","action":{"k":"Comp","name":"OpenUrl","args":[{"k":"Str","v":"https://esahubble.org/images/heic0611b/"}],"mappedProps":{"url":{"k":"Str","v":"https://esahubble.org/images/heic0611b/"}}},"variant":"secondary"},"partial":false,"hasDynamicProps":true,"statementId":"b1"},{"type":"element","typeName":"Button","props":{"label":"View Webb's First Deep Field","action":{"k":"Comp","name":"OpenUrl","args":[{"k":"Str","v":"https://webbtelescope.org/contents/media/images/2022/035/01G7DDBW5NHZNJ9DZ4E4XQ3BPX"}],"mappedProps":{"url":{"k":"Str","v":"https://webbtelescope.org/contents/media/images/2022/035/01G7DDBW5NHZNJ9DZ4E4XQ3BPX"}}},"variant":"secondary"},"partial":false,"hasDynamicProps":true,"statementId":"b2"}]},"partial":false,"hasDynamicProps":true,"statementId":"imgNote"},{"type":"element","typeName":"InlineHeader","props":{"heading":"Plain-Language Glossary","description":"Key terms explained simply"},"partial":false,"hasDynamicProps":false,"statementId":"glossHeader"},{"type":"element","typeName":"Accordion","props":{"items":[{"type":"element","typeName":"AccordionItem","props":{"value":"infrared","trigger":"Infrared light","content":[{"type":"element","typeName":"TextContent","props":{"text":"Light our eyes can't see, felt by us as heat. It passes through dust clouds and is how Webb sees the earliest galaxies."},"partial":false,"hasDynamicProps":false}]},"partial":false,"hasDynamicProps":false,"statementId":"g1"},{"type":"element","typeName":"AccordionItem","props":{"value":"redshift","trigger":"Redshift","content":[{"type":"element","typeName":"TextContent","props":{"text":"As the universe expands, light from far-away galaxies is stretched to longer, redder wavelengths. More redshift means a more distant, older galaxy."},"partial":false,"hasDynamicProps":false}]},"partial":false,"hasDynamicProps":false,"statementId":"g2"},{"type":"element","typeName":"AccordionItem","props":{"value":"lookback","trigger":"Look-back time","content":[{"type":"element","typeName":"TextContent","props":{"text":"Light takes time to travel. Seeing a galaxy 13 billion light-years away means seeing it as it was 13 billion years ago."},"partial":false,"hasDynamicProps":false}]},"partial":false,"hasDynamicProps":false,"statementId":"g3"},{"type":"element","typeName":"AccordionItem","props":{"value":"deepfield","trigger":"Deep field","content":[{"type":"element","typeName":"TextContent","props":{"text":"A long exposure of a tiny, seemingly empty patch of sky, collecting faint light over many hours to reveal distant objects."},"partial":false,"hasDynamicProps":false}]},"partial":false,"hasDynamicProps":false,"statementId":"g4"},{"type":"element","typeName":"AccordionItem","props":{"value":"gravlens","trigger":"Gravitational lensing","content":[{"type":"element","typeName":"TextContent","props":{"text":"Massive objects bend space, acting like a magnifying glass that stretches and brightens light from galaxies behind them."},"partial":false,"hasDynamicProps":false}]},"partial":false,"hasDynamicProps":false,"statementId":"g5"}]},"partial":false,"hasDynamicProps":false,"statementId":"gloss"},{"type":"element","typeName":"Callout","props":{"variant":"info","title":"The story in one line","description":"Hubble showed us the universe was full of galaxies; Webb is showing us how the first of them began."},"partial":false,"hasDynamicProps":false,"statementId":"callout"}]},"partial":false,"hasDynamicProps":true,"statementId":"root"},"meta":{"incomplete":false,"unresolved":[],"orphaned":[],"statementCount":20,"errors":[]},"stateDeclarations":{},"queryStatements":[],"mutationStatements":[]}