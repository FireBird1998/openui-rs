root = Stack([header, fundingCard, independenceCard, reportCard])
header = InlineHeader("Newsroom Transparency", "How we are funded, how we stay independent, and how to flag concerns")
fundingCard = Card([fundingHeader, fundingTable, fundingNote])
fundingHeader = CardHeader("Funding Sources", "Disclosed annually; percentages reflect the most recent fiscal year")
fundingTable = Table([Col("Source", fundingSources), Col("Type", fundingTypes), Col("Share of Revenue", fundingShares, "number"), Col("Disclosed Terms", fundingTerms)])
fundingSources = ["Reader Subscriptions", "Individual Member Donations", "Foundation Grants", "Advertising", "Event Sponsorships"]
fundingTypes = ["Earned", "Contributed", "Contributed", "Commercial", "Commercial"]
fundingShares = [46, 22, 18, 9, 5]
fundingTerms = ["No editorial input", "Public donor list above $1,000", "Restricted to local court and council reporting; no influence on story selection", "Ads labeled; separate sales team", "Sponsors never shown in editorial content"]
fundingNote = TextCallout("info", "Full ledger", "Our audited financial statements and complete grant agreements are available on request.")
independenceCard = Card([independenceHeader, independenceList])
independenceHeader = CardHeader("Editorial Independence Rules", "Commitments that govern every story we publish")
independenceList = Accordion([ruleOwnership, ruleFunders, ruleCorrections, ruleAds])
ruleOwnership = AccordionItem("ownership", "Ownership and governance", ownershipBody)
ownershipBody = [TextContent("The newsroom is owned by a nonprofit trust with an independent board. No board member may hold a paid editorial role.")]
ruleFunders = AccordionItem("funders", "Funder separation", funderBody)
funderBody = [TextContent("Funders have no approval rights over coverage, headlines, or sourcing. Any grant touching a topic we cover is logged and disclosed on this page.")]
ruleCorrections = AccordionItem("corrections", "Corrections and updates", correctionsBody)
correctionsBody = [TextContent("Errors are corrected promptly and marked with a visible note stating what changed and when. Material corrections are also sent to subscribers by email.")]
ruleAds = AccordionItem("ads", "Advertising and sponsored content", adsBody)
adsBody = [TextContent("Advertising is visually distinct from news. Sponsored content carries a 'Sponsored' label and is produced by a team separate from reporters.")]
reportCard = Card([reportHeader, reportForm])
reportHeader = CardHeader("Report a Conflict of Interest", "Tell us if you believe a story, reporter, or source is compromised")
reportForm = Form("conflict-report", reportButtons, [reportNameField, reportEmailField, reportTopicField, reportDetailsField])
reportNameField = FormControl("Your name (optional)", Input("name", "Jane Doe", "text"))
reportEmailField = FormControl("Email", Input("email", "you@example.com", "email", { required: true, email: true }), "We may contact you for follow-up")
reportTopicField = FormControl("Article or topic", Input("topic", "Headline or URL", "text", { required: true }))
reportDetailsField = FormControl("Describe the concern", TextArea("details", "What is the potential conflict?", 5, { required: true, minLength: 20 }))
reportButtons = Buttons([Button("Submit Report", @ToAssistant("Submit conflict of interest report"), "primary"), Button("Clear", @ToAssistant("Clear conflict report form"), "secondary")])