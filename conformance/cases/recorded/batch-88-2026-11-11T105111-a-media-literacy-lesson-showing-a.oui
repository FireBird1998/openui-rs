root = Stack([headerBlock, headlineCard, checklistCard, questionsCard])
headerBlock = InlineHeader("Media Literacy Lesson", "Check the evidence before you share")
headlineCard = Card([TextContent("Headline", "small-heavy"), TextContent("\"Miracle Fruit Cures Sleep Problems Overnight, Doctors Stunned\"", "large-heavy")])
checklistCard = Card([CardHeader("Evidence Checklist", "Look for these signals before trusting the claim"), checklist])
checklist = Stack([chk1, chk2, chk3, chk4], "column", "s")
chk1 = TextCallout("neutral", "Named source", "Does the story cite a study, organization, or expert you can look up?")
chk2 = TextCallout("neutral", "Original research", "Is there a published paper with sample size, methods, and peer review?")
chk3 = TextCallout("neutral", "Matching evidence", "Does the evidence actually support the strength of the headline?")
chk4 = TextCallout("neutral", "Independent confirmation", "Have other credible outlets reported the same findings?")
questionsCard = Card([CardHeader("Three Questions Before You Share", "Pause and ask yourself"), questions])
questions = Stack([q1, q2, q3], "column", "s")
q1 = TextCallout("info", "1. Who benefits from this claim?", "Consider whether a company, product, or advocate stands to gain from people believing it.")
q2 = TextCallout("info", "2. What is missing from the story?", "Look for absent context, sample sizes, side effects, or opposing expert views.")
q3 = TextCallout("info", "3. Would I bet on this being true?", "If the claim is wrong, what would it cost? Verify before posting if the stakes are high.")