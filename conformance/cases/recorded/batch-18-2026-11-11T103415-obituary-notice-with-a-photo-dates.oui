root = Stack([notice])
notice = Card([header, photo, dates, bioText, serviceHeader, serviceList, donationNote])
header = CardHeader("Eleanor Marie Whitfield", "1938 – 2024")
photo = Image("Portrait of Eleanor Marie Whitfield")
dates = TextContent("Born March 12, 1938, Dayton, Ohio  ·  Died June 3, 2024, Asheville, North Carolina", "small")
bioText = TextContent("Eleanor Whitfield spent four decades teaching elementary music in Dayton public schools, where generations of students learned their first chords and harmonies from her. A lifelong gardener and avid reader, she was known for her warmth, her wit, and the Sunday pies she shared with neighbors. She is survived by her husband of 58 years, Robert; her children, Ann and Thomas; and five grandchildren who were the lights of her life. She moved to Asheville in 2015 to be closer to family and quickly found a new choir and a new garden to tend.", "default")
serviceHeader = InlineHeader("Service Details", "A celebration of Eleanor's life")
serviceList = EntityList([{left: "Date", right: "Saturday, June 15, 2024"}, {left: "Time", right: "11:00 AM"}, {left: "Location", right: "First Presbyterian Church, 25 Church Street, Asheville, NC"}, {left: "Reception", right: "Following the service in the Fellowship Hall"}, {left: "Officiant", right: "Rev. Margaret Lowe"}], "default")
donationNote = TextContent("In lieu of flowers, the family asks that donations be made to the Dayton Community Music Fund.", "small")