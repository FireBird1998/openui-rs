root = Stack([header, balanceBlock, chartCard, txCard])
header = CardHeader("Personal Finance Overview", "Your accounts and spending this month")
balanceBlock = OverviewCardBlock([b1, b2, b3, b4])
b1 = OverviewCardItem("checking", b1top, b1m)
b1top = IconText(b1i, "info", "m", "Checking", "Main account", false, "horizontal")
b1i = Icon("wallet", "finance")
b1m = MetricIndicatorInline("$4,820", "vs last month", { direction: "up", value: 3 })
b2 = OverviewCardItem("savings", b2top, b2m)
b2top = IconText(b2i, "success", "m", "Savings", "Emergency fund", false, "horizontal")
b2i = Icon("piggy-bank", "finance")
b2m = MetricIndicatorInline("$12,350", "vs last month", { direction: "up", value: 5 })
b3 = OverviewCardItem("credit", b3top, b3m)
b3top = IconText(b3i, "warning", "m", "Credit Card", "Balance owed", false, "horizontal")
b3i = Icon("credit-card", "finance")
b3m = MetricIndicatorInline("$1,240", "vs last month", { direction: "down", value: 8 })
b4 = OverviewCardItem("invest", b4top, b4m)
b4top = IconText(b4i, "neutral", "m", "Investments", "Brokerage", false, "horizontal")
b4i = Icon("trending-up", "finance")
b4m = MetricIndicatorInline("$28,900", "vs last month", { direction: "up", value: 2 })
chartCard = Card([chartHeader, pie])
chartHeader = CardHeader("Spending by Category", "This month")
pie = PieChart(cats, amounts, "donut")
cats = ["Housing", "Food", "Transport", "Entertainment", "Utilities", "Shopping"]
amounts = [1450, 620, 280, 210, 240, 390]
txCard = Card([txHeader, txTable])
txHeader = CardHeader("Recent Transactions", "Last 7 days")
txTable = Table([Col("Date", dates), Col("Description", descs), Col("Category", txCats), Col("Amount ($)", txAmts, "number")])
dates = ["Jun 14", "Jun 13", "Jun 12", "Jun 11", "Jun 10", "Jun 9"]
descs = ["Whole Foods Market", "Monthly Rent", "Uber Ride", "Netflix", "Electric Bill", "Amazon Purchase"]
txCats = ["Food", "Housing", "Transport", "Entertainment", "Utilities", "Shopping"]
txAmts = [-84.32, -1450.00, -18.75, -15.99, -92.40, -63.15]