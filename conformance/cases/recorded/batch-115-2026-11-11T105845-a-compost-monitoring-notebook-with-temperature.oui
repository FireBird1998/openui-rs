root = Stack([header, kpis, tempCard, addCard, moistCard, tipCallout])
header = CardHeader("Compost Monitoring Notebook", "Backyard bin #2 – tracking since March")
kpis = SnippetCardBlock([k1, k2, k3])
k1 = SnippetCardItem("temp", k1l, k1r)
k1l = IconText(k1i, "neutral", "m", "Current Temp", "Core reading", false, "horizontal")
k1i = Icon("thermometer", "weather")
k1r = BoldText("number", "138°F", "+4°F", "metric")
k2 = SnippetCardItem("moisture", k2l, k2r)
k2l = IconText(k2i, "neutral", "m", "Moisture", "Latest check", false, "horizontal")
k2i = Icon("droplets", "weather")
k2r = BoldText("text", "Damp", "Ideal", "text")
k3 = SnippetCardItem("age", k3l, k3r)
k3l = IconText(k3i, "neutral", "m", "Pile Age", "Days", false, "horizontal")
k3i = Icon("calendar", "time")
k3r = BoldText("number", "21", "+1", "metric")
tempCard = Card([tempHdr, tempChart])
tempHdr = CardHeader("Temperature Over Time", "Core temperature in °F (ideal 130–150°F)")
tempChart = LineChart(days, [tempSeries, ambientSeries], "natural", "Day", "°F")
days = ["Day 1", "Day 3", "Day 5", "Day 7", "Day 9", "Day 11", "Day 14", "Day 17", "Day 21"]
tempSeries = Series("Core", [72, 95, 124, 145, 152, 146, 138, 129, 138])
ambientSeries = Series("Ambient", [58, 60, 57, 62, 64, 61, 59, 63, 65])
addCard = Card([addHdr, addTable])
addHdr = CardHeader("Material Additions", "Greens and browns log")
addTable = Table([Col("Date", addDates), Col("Material", addMats), Col("Type", addTypes), Col("Amount (lb)", addAmts, "number")])
addDates = ["Mar 1", "Mar 1", "Mar 6", "Mar 12", "Mar 15", "Mar 19", "Mar 22"]
addMats = ["Shredded leaves", "Kitchen scraps", "Grass clippings", "Straw", "Coffee grounds", "Cardboard", "Vegetable trimmings"]
addTypes = ["Brown", "Green", "Green", "Brown", "Green", "Brown", "Green"]
addAmts = [12, 6, 8, 5, 3, 4, 5]
moistCard = Card([moistHdr, moistTable])
moistHdr = CardHeader("Moisture Observations", "Squeeze test and notes")
moistTable = Table([Col("Date", mDates), Col("Squeeze Test", mTests), Col("Moisture", mLevels), Col("Notes", mNotes)])
mDates = ["Mar 3", "Mar 8", "Mar 13", "Mar 18", "Mar 22"]
mTests = ["Few drops", "No drops, crumbles", "Many drops", "One or two drops", "One or two drops"]
mLevels = ["Good", "Dry", "Too wet", "Good", "Good"]
mNotes = ["Healthy start", "Added water, turned pile", "Added straw to absorb excess", "Balanced after turning", "Steamy, earthy smell"]
tipCallout = Callout("info", "Next steps", "Turn the pile this weekend and add a layer of browns if temperature climbs above 150°F.")