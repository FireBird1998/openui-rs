root = Stack([pageHeader, plans], "column", "l")
pageHeader = InlineHeader("Pricing", "Choose the plan that fits your team")
plans = Stack([basicCard, proCard, enterpriseCard], "row", "m", "stretch", "start", true)
basicCard = Card([basicHeader, basicPrice, basicFeatures, basicBtn], "card", "column", "m")
basicHeader = CardHeader("Starter", "For individuals getting started")
basicPrice = BoldText("number", "$9", "per month", "text", "lg")
basicFeatures = EntityList([featUsers1, featStorage1, featSupport1], "default")
featUsers1 = {left: "Users", right: "1"}
featStorage1 = {left: "Storage", right: "5 GB"}
featSupport1 = {left: "Support", right: "Email"}
basicBtn = Button("Get Starter", @ToAssistant("I want to sign up for the Starter plan"), "secondary", "normal", "medium")
proCard = Card([proBadge, proHeader, proPrice, proFeatures, proBtn], "card", "column", "m")
proBadge = Tag("Most Popular", null, "sm", "info")
proHeader = CardHeader("Pro", "For growing teams that need more")
proPrice = BoldText("number", "$29", "per month", "text", "lg")
proFeatures = EntityList([featUsers2, featStorage2, featSupport2], "default")
featUsers2 = {left: "Users", right: "10"}
featStorage2 = {left: "Storage", right: "100 GB"}
featSupport2 = {left: "Support", right: "Priority chat"}
proBtn = Button("Get Pro", @ToAssistant("I want to sign up for the Pro plan"), "primary", "normal", "medium")
enterpriseCard = Card([enterpriseHeader, enterprisePrice, enterpriseFeatures, enterpriseBtn], "card", "column", "m")
enterpriseHeader = CardHeader("Enterprise", "For organizations with advanced needs")
enterprisePrice = BoldText("number", "$99", "per month", "text", "lg")
enterpriseFeatures = EntityList([featUsers3, featStorage3, featSupport3], "default")
featUsers3 = {left: "Users", right: "Unlimited"}
featStorage3 = {left: "Storage", right: "1 TB"}
featSupport3 = {left: "Support", right: "24/7 dedicated"}
enterpriseBtn = Button("Contact Sales", @ToAssistant("I want to talk to sales about Enterprise"), "secondary", "normal", "medium")