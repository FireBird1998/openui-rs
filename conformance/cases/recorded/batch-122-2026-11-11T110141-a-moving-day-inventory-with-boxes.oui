root = Stack([header, roomTabs, checklistHeader, checklist])
header = InlineHeader("Moving Day Inventory", "Boxes grouped by room, with fragile flags and loading status")
roomTabs = Tabs([tabKitchen, tabLiving, tabBedroom])
tabKitchen = TabItem("kitchen", "Kitchen", [kitchenHeader, kitchenTable])
tabLiving = TabItem("living", "Living Room", [livingHeader, livingTable])
tabBedroom = TabItem("bedroom", "Bedroom", [bedroomHeader, bedroomTable])
kitchenHeader = InlineHeader("Kitchen", "4 boxes, 26 items")
livingHeader = InlineHeader("Living Room", "3 boxes, 19 items")
bedroomHeader = InlineHeader("Bedroom", "3 boxes, 17 items")
kitchenTable = Table([Col("Box", kitchenBoxes), Col("Contents", kitchenContents), Col("Items", kitchenCounts, "number"), Col("Fragile", kitchenFragile)])
kitchenBoxes = ["K-01", "K-02", "K-03", "K-04"]
kitchenContents = ["Plates and bowls", "Glassware", "Pots and pans", "Pantry food"]
kitchenCounts = [12, 8, 4, 2]
kitchenFragile = [fragileYes, fragileYes, fragileNo, fragileNo]
livingTable = Table([Col("Box", livingBoxes), Col("Contents", livingContents), Col("Items", livingCounts, "number"), Col("Fragile", livingFragile)])
livingBoxes = ["L-01", "L-02", "L-03"]
livingContents = ["Electronics and cables", "Picture frames", "Books"]
livingCounts = [9, 4, 6]
livingFragile = [fragileYes, fragileYes, fragileNo]
bedroomTable = Table([Col("Box", bedroomBoxes), Col("Contents", bedroomContents), Col("Items", bedroomCounts, "number"), Col("Fragile", bedroomFragile)])
bedroomBoxes = ["B-01", "B-02", "B-03"]
bedroomContents = ["Clothing", "Bedding and linens", "Lamps and mirror"]
bedroomCounts = [10, 4, 3]
bedroomFragile = [fragileNo, fragileNo, fragileYes]
fragileYes = Tag("Fragile", null, "sm", "danger")
fragileNo = Tag("Standard", null, "sm", "neutral")
checklistHeader = InlineHeader("Loading Checklist", "Tick off boxes as they go on the truck")
checklist = Stack([checkCard1, checkCard2, checkCard3], "column", "s")
checkCard1 = Card([TextContent("Load first: fragile boxes K-01, K-02, L-01, L-02, B-03", "small")])
checkCard2 = Card([TextContent("Load heavy: pantry food K-04, books L-03, bedding B-02", "small")])
checkCard3 = Card([TextContent("Load last: clothing B-01 and remaining kitchen boxes", "small")])