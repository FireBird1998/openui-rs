root = Stack([header, segmentTable, totalCard])
header = InlineHeader("Morning News Bulletin", "Rundown with segment durations and presenters")
segmentTable = Table([colSegment, colPresenter, colDuration, colStatus])
colSegment = Col("Segment", ["Headlines", "Local Weather", "Business Update", "Interview: Transport Minister", "Sports Round-up", "Community Events", "Closing Headlines"])
colPresenter = Col("Presenter", ["Sarah Mitchell", "Tom Reyes", "Priya Shah", "James O'Connor", "Dan Walsh", "Aisha Bello", "Sarah Mitchell"])
colDuration = Col("Duration", ["03:00", "02:00", "04:30", "08:00", "03:30", "02:30", "01:30"], "string")
colStatus = Col("Status", [statusTag1, statusTag2, statusTag3, statusTag4, statusTag5, statusTag6, statusTag7])
statusTag1 = Tag("Ready", null, "sm", "success")
statusTag2 = Tag("Ready", null, "sm", "success")
statusTag3 = Tag("Ready", null, "sm", "success")
statusTag4 = Tag("Pending", null, "sm", "warning")
statusTag5 = Tag("Ready", null, "sm", "success")
statusTag6 = Tag("Pending", null, "sm", "warning")
statusTag7 = Tag("Ready", null, "sm", "success")
totalCard = Card([totalHeader, totalMetric, totalNote], "card")
totalHeader = CardHeader("Total Running Time", "Excluding ad breaks")
totalMetric = MetricIndicatorInline("00:33:00", "Scheduled runtime")
totalNote = TextContent("Includes 4 minutes of station idents. Interview segment may be shortened if the bulletin runs long.", "small")