root = Stack([header, kpis, availHeader, availTable, certHeader, certCards, formHeader, bookForm])
header = CardHeader("Makerspace Equipment Reservations", "Check availability, confirm your safety certifications, and book a machine")
kpis = SnippetCardBlock([k1, k2, k3])
k1 = SnippetCardItem("available", k1l, k1r)
k1l = IconText(k1i, "success", "m", "Available Now", "Machines free", false, "horizontal")
k1i = Icon("circle-check", "status")
k1r = BoldText("number", "6")
k2 = SnippetCardItem("inuse", k2l, k2r)
k2l = IconText(k2i, "warning", "m", "In Use", "Currently booked", false, "horizontal")
k2i = Icon("clock", "time")
k2r = BoldText("number", "3")
k3 = SnippetCardItem("maint", k3l, k3r)
k3l = IconText(k3i, "danger", "m", "Maintenance", "Out of service", false, "horizontal")
k3i = Icon("wrench", "tools")
k3r = BoldText("number", "1")
availHeader = InlineHeader("Machine Availability", "Live status and next open slot")
availTable = Table([Col("Machine", machines), Col("Location", locs), Col("Status", statuses), Col("Next Open", nextOpen), Col("Cert Required", certReq)])
machines = ["Laser Cutter (60W)", "Prusa 3D Printer", "CNC Router", "Table Saw", "Vinyl Cutter", "Soldering Station", "Metal Lathe", "Sewing Machine", "Bandsaw", "Resin Printer"]
locs = ["Fab Lab", "Fab Lab", "Wood Shop", "Wood Shop", "Studio", "Electronics Bench", "Metal Shop", "Textile Corner", "Wood Shop", "Fab Lab"]
statuses = [Tag("Available", null, "sm", "success"), Tag("In Use", null, "sm", "warning"), Tag("Available", null, "sm", "success"), Tag("In Use", null, "sm", "warning"), Tag("Available", null, "sm", "success"), Tag("Available", null, "sm", "success"), Tag("Maintenance", null, "sm", "danger"), Tag("Available", null, "sm", "success"), Tag("In Use", null, "sm", "warning"), Tag("Available", null, "sm", "success")]
nextOpen = ["Today 2:00 PM", "Today 4:30 PM", "Today 1:00 PM", "Tomorrow 9:00 AM", "Today 11:00 AM", "Today 10:00 AM", "Mar 18", "Today 12:00 PM", "Today 3:00 PM", "Today 5:00 PM"]
certReq = ["Laser Safety", "3D Printing Basics", "CNC Safety", "Woodshop Safety", "None", "Electronics Basics", "Metal Shop Safety", "None", "Woodshop Safety", "Resin Handling"]
certHeader = InlineHeader("Your Safety Certifications", "Member: Jordan Rivera")
certCards = ContextCardBlock([c1, c2, c3, c4])
c1 = ContextCardItem("laser", t1, "Valid until Nov 2025", "gray")
t1 = Tag("Laser Safety", null, "sm", "success")
c2 = ContextCardItem("woodshop", t2, "Valid until Aug 2025", "gray")
t2 = Tag("Woodshop Safety", null, "sm", "success")
c3 = ContextCardItem("cnc", t3, "Expires in 12 days - renew soon", "gray")
t3 = Tag("CNC Safety", null, "sm", "warning")
c4 = ContextCardItem("metal", t4, "Not completed - book a class", "gray")
t4 = Tag("Metal Shop Safety", null, "sm", "danger")
formHeader = InlineHeader("Book a Machine", "Reservations are limited to 4 hours per session")
bookForm = Form("booking", formBtns, [f1, f2, f3, f4, f5, f6])
f1 = FormControl("Machine", Select("machine", machineOpts, "Select a machine", { required: true }))
machineOpts = [SelectItem("laser", "Laser Cutter (60W)"), SelectItem("prusa", "Prusa 3D Printer"), SelectItem("cnc", "CNC Router"), SelectItem("saw", "Table Saw"), SelectItem("vinyl", "Vinyl Cutter"), SelectItem("solder", "Soldering Station"), SelectItem("sewing", "Sewing Machine"), SelectItem("band", "Bandsaw"), SelectItem("resin", "Resin Printer")]
f2 = FormControl("Date", DatePicker("date", "single", { required: true }))
f3 = FormControl("Start Time", Select("start", timeOpts, "Select start time", { required: true }))
timeOpts = [SelectItem("9", "9:00 AM"), SelectItem("11", "11:00 AM"), SelectItem("13", "1:00 PM"), SelectItem("15", "3:00 PM"), SelectItem("17", "5:00 PM")]
f4 = FormControl("Duration (hours)", Slider("duration", "discrete", 1, 4, 1, [1]), "Maximum 4 hours")
f5 = FormControl("Project Description", TextArea("project", "What are you making?", 3, { required: true, minLength: 10 }))
f6 = FormControl("Agreements", CheckBoxGroup("agree", [ag1, ag2], { required: true }))
ag1 = CheckBoxItem("I have read the safety rules", "Required for all reservations", "safety")
ag2 = CheckBoxItem("I will clean up after use", "Leave the workspace tidy", "cleanup")
formBtns = Buttons([Button("Reserve Machine", @ToAssistant("Submit machine reservation"), "primary"), Button("Check My Certifications", @ToAssistant("Show my certification details"), "secondary")])