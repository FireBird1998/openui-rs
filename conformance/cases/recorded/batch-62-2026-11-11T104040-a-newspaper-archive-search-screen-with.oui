root = Stack([header, searchForm, resultsHeader, resultCards])
header = InlineHeader("Newspaper Archive", "Search historical issues by keyword and year")
searchForm = Form("archiveSearch", searchButtons, [keywordField, yearField])
keywordField = FormControl("Keyword", keywordInput, "Try a person, place, or event")
keywordInput = Input("keyword", "e.g. railway strike", "text", { required: true, minLength: 2 })
yearField = FormControl("Year", yearSelect)
yearSelect = Select("year", yearItems, "Select a year", { required: true })
yearItems = [SelectItem("1932", "1932"), SelectItem("1945", "1945"), SelectItem("1963", "1963"), SelectItem("1978", "1978"), SelectItem("1989", "1989")]
searchButtons = Buttons([Button("Search Archive", @ToAssistant("Search the archive"), "primary"), Button("Clear", @ToAssistant("Clear archive search"), "secondary")])
resultsHeader = InlineHeader("Results", "Four issues matched your search")
resultCards = CompositeCardBlock([r1, r2, r3, r4])
r1 = CompositeCardItem("issue-1932-03-14", r1header, [r1body], r1footer)
r1header = IconText(r1icon, "neutral", "m", "The Morning Chronicle", "14 March 1932", true, "horizontal")
r1icon = Icon("newspaper", "media")
r1body = TextContent("Front page coverage of a regional railway strike and the city's response to rising freight delays.")
r1footer = { price: BoldText("text", "Page 1"), button: r1btn }
r1btn = Button("View Issue", @ToAssistant("Open the 14 March 1932 issue of The Morning Chronicle"), "secondary")
r2 = CompositeCardItem("issue-1945-08-16", r2header, [r2body], r2footer)
r2header = IconText(r2icon, "neutral", "m", "The Evening Standard", "16 August 1945", true, "horizontal")
r2icon = Icon("newspaper", "media")
r2body = TextContent("Victory celebrations fill the second page, with street scenes and a column on postwar rationing.")
r2footer = { price: BoldText("text", "Page 2"), button: r2btn }
r2btn = Button("View Issue", @ToAssistant("Open the 16 August 1945 issue of The Evening Standard"), "secondary")
r3 = CompositeCardItem("issue-1963-11-22", r3header, [r3body], r3footer)
r3header = IconText(r3icon, "neutral", "m", "The Daily Ledger", "22 November 1963", true, "horizontal")
r3icon = Icon("newspaper", "media")
r3body = TextContent("Special edition coverage with a full-width headline, reader letters, and a late bulletin inserted on page 1.")
r3footer = { price: BoldText("text", "Page 1"), button: r3btn }
r3btn = Button("View Issue", @ToAssistant("Open the 22 November 1963 issue of The Daily Ledger"), "secondary")
r4 = CompositeCardItem("issue-1989-06-05", r4header, [r4body], r4footer)
r4header = IconText(r4icon, "neutral", "m", "The Harbor Post", "5 June 1989", true, "horizontal")
r4icon = Icon("newspaper", "media")
r4body = TextContent("Business section analysis of shipping volumes and a feature on the new waterfront development plans.")
r4footer = { price: BoldText("text", "Page 7"), button: r4btn }
r4btn = Button("View Issue", @ToAssistant("Open the 5 June 1989 issue of The Harbor Post"), "secondary")