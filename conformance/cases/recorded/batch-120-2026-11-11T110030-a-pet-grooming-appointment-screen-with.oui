root = Stack([header, petCard, serviceCard, notesCard, summaryCard])
header = InlineHeader("Book a Grooming Appointment", "Choose your pet's service and confirm the details")
petCard = Card([petHeader, petForm])
petHeader = CardHeader("Pet Details", "Tell us about your pet")
petForm = Form("pet", petButtons, [petNameField, petTypeField, petBreedField, petWeightField])
petNameField = FormControl("Pet Name", Input("petName", "e.g. Biscuit", "text", { required: true, minLength: 2 }))
petTypeField = FormControl("Species", Select("petType", petTypeOpts, "Select species", { required: true }))
petTypeOpts = [SelectItem("dog", "Dog"), SelectItem("cat", "Cat"), SelectItem("rabbit", "Rabbit"), SelectItem("other", "Other")]
petBreedField = FormControl("Breed", Input("breed", "e.g. Golden Retriever", "text"))
petWeightField = FormControl("Weight (lbs)", Input("weight", "e.g. 45", "number", { required: true, numeric: true, min: 1, max: 300 }))
petButtons = Buttons([Button("Save Pet", @ToAssistant("Save pet details"), "secondary")])
serviceCard = Card([serviceHeader, serviceForm])
serviceHeader = CardHeader("Services", "Select one or more services")
serviceForm = Form("services", serviceButtons, [serviceField, addOnField])
serviceField = FormControl("Grooming Package", serviceOptions, "Pick a main package")
serviceOptions = OptionCards("package", "single", [pkgBath, pkgFull, pkgDeluxe])
pkgBath = OptionCard("bath", "Bath & Brush", "Wash, dry, brush out, ear cleaning", pkgBathIcon)
pkgBathIcon = Icon("droplets", "grooming")
pkgFull = OptionCard("full", "Full Groom", "Bath, haircut, nail trim, ear cleaning", pkgFullIcon)
pkgFullIcon = Icon("scissors", "grooming")
pkgDeluxe = OptionCard("deluxe", "Deluxe Spa", "Full groom plus teeth brushing and aromatherapy", pkgDeluxeIcon)
pkgDeluxeIcon = Icon("sparkles", "grooming")
addOnField = FormControl("Add-ons", addOnChips, "Select all that apply")
addOnChips = Chips("addons", "multiple", [addNails, addTeeth, addFurMask])
addNails = ChipItem("nails", "Nail Painting", addNailsIcon)
addNailsIcon = Icon("paintbrush", "grooming")
addTeeth = ChipItem("teeth", "Teeth Brushing", addTeethIcon)
addTeethIcon = Icon("smile", "grooming")
addFurMask = ChipItem("mask", "Fur Mask", addFurMaskIcon)
addFurMaskIcon = Icon("shield", "grooming")
serviceButtons = Buttons([Button("Continue", @ToAssistant("Continue to schedule"), "primary")])
notesCard = Card([notesHeader, notesForm])
notesHeader = CardHeader("Special Handling", "Help our groomers keep your pet comfortable")
notesForm = Form("notes", notesButtons, [anxietyField, notesField])
anxietyField = FormControl("Temperament", temperamentChips, "Select any that apply")
temperamentChips = Chips("temperament", "multiple", [tempAnxious, tempBiter, tempSensitive])
tempAnxious = ChipItem("anxious", "Anxious", tempAnxiousIcon)
tempAnxiousIcon = Icon("heart-pulse", "health")
tempBiter = ChipItem("biter", "Bites when nervous", tempBiterIcon)
tempBiterIcon = Icon("triangle-alert", "health")
tempSensitive = ChipItem("sensitive", "Sensitive skin", tempSensitiveIcon)
tempSensitiveIcon = Icon("hand", "health")
notesField = FormControl("Additional Notes", TextArea("notes", "Medications, allergies, preferred handling...", 4, { maxLength: 500 }))
notesButtons = Buttons([Button("Save Notes", @ToAssistant("Save special handling notes"), "secondary")])
summaryCard = Card([summaryHeader, summaryRows, summaryBtns])
summaryHeader = CardHeader("Booking Summary", "Review before confirming")
summaryRows = EntityList([sumPet, sumService, sumAddons, sumDate], "default", sumHeader, sumFooter)
sumHeader = { left: "Item", right: "Selection" }
sumPet = { left: "Pet", right: "Biscuit (Dog, 45 lbs)" }
sumService = { left: "Package", right: "Full Groom" }
sumAddons = { left: "Add-ons", right: "Teeth Brushing" }
sumDate = { left: "Appointment", right: "Sat, May 17 at 10:00 AM" }
sumFooter = { left: "Total", right: "$85.00", rightVariant: "number" }
summaryBtns = Buttons([confirmBtn, editBtn], "row")
confirmBtn = Button("Confirm Booking", @ToAssistant("Confirm grooming appointment"), "primary")
editBtn = Button("Edit", @ToAssistant("Edit booking"), "secondary")