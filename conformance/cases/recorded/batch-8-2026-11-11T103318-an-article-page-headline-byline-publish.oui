root = Stack([headline, byline, leadImage, p1, p2, p3, p4, relatedHeader, relatedLinks])
headline = TextContent("The Quiet Revival of Neighborhood Libraries", "large-heavy")
byline = TextContent("By Maya Thornton · Published March 14, 2025", "small")
leadImage = ImageBlock("https://images.example.com/neighborhood-library.jpg", "Patrons reading at a sunlit library table")
p1 = TextContent("Across the city, small branch libraries that once looked destined for closure are seeing their busiest years in a decade. Reading rooms fill up after school, and summer programs have waitlists. Local officials say the change is less about books than about the buildings themselves becoming places people want to be.")
p2 = TextContent("The turnaround began quietly. Librarians started offering seed libraries, tool lending, and repair workshops alongside traditional shelves. Residents who had not set foot inside in years began returning, often bringing children or neighbors who had never considered the branch part of their daily routine.")
p3 = TextContent("Funding remains a challenge. Many branches still operate on tight budgets, relying on volunteers to staff evening hours and on grants to replace aging computers. Advocates argue that the return on investment is clear: every dollar spent on a branch supports job searches, literacy, and civic life in ways that are hard to measure but easy to see.")
p4 = TextContent("Looking ahead, library directors are planning expanded hours and more community spaces designed for meetings and small businesses. For many residents, the message is simple: the library is open, and it is for everyone who walks through the door.")
relatedHeader = InlineHeader("Related Reading", "More from our coverage of public spaces")
relatedLinks = Stack([link1, link2, link3], "column", "s")
link1 = Button("How Cities Are Rethinking Public Parks", @OpenUrl("https://news.example.com/parks-rethink"), "tertiary")
link2 = Button("The Economics of Community Infrastructure", @OpenUrl("https://news.example.com/community-infrastructure"), "tertiary")
link3 = Button("Volunteer Networks Keeping Branches Open", @OpenUrl("https://news.example.com/volunteer-networks"), "tertiary")