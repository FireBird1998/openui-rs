root = Stack([title, intro, tabs])
title = TextContent("Introduction to Data Science: Course Syllabus", "large-heavy")
intro = Callout("info", "Course Overview", "This 8-week course covers the core tools and methods of data science. Assignments are due Sundays at 11:59 PM unless noted otherwise.")
tabs = Tabs([tabSchedule, tabDueDates])
tabSchedule = TabItem("schedule", "Weekly Schedule", [weekAcc])
tabDueDates = TabItem("due", "Assignment Due Dates", [dueTable])
weekAcc = Accordion([wk1, wk2, wk3, wk4, wk5, wk6, wk7, wk8])
wk1 = AccordionItem("w1", "Week 1: Introduction to Data Science", [wk1topics, wk1due])
wk1topics = TextContent("**Topics:** What is data science, the data lifecycle, setting up Python and Jupyter notebooks.")
wk1due = Tag("Assignment 1 due Jan 14", null, "sm", "info")
wk2 = AccordionItem("w2", "Week 2: Python Foundations", [wk2topics, wk2due])
wk2topics = TextContent("**Topics:** Variables, data types, control flow, functions, and basic file I/O.")
wk2due = Tag("Assignment 2 due Jan 21", null, "sm", "info")
wk3 = AccordionItem("w3", "Week 3: Data Wrangling with pandas", [wk3topics, wk3due])
wk3topics = TextContent("**Topics:** DataFrames, indexing, filtering, handling missing values, and merging datasets.")
wk3due = Tag("Assignment 3 due Jan 28", null, "sm", "info")
wk4 = AccordionItem("w4", "Week 4: Exploratory Data Analysis", [wk4topics, wk4due])
wk4topics = TextContent("**Topics:** Descriptive statistics, grouping and aggregation, and visualizing distributions.")
wk4due = Tag("Assignment 4 due Feb 4", null, "sm", "info")
wk5 = AccordionItem("w5", "Week 5: Data Visualization", [wk5topics, wk5due])
wk5topics = TextContent("**Topics:** Matplotlib and Seaborn basics, choosing chart types, and telling stories with data.")
wk5due = Tag("Assignment 5 due Feb 11", null, "sm", "info")
wk6 = AccordionItem("w6", "Week 6: Statistics for Data Science", [wk6topics, wk6due])
wk6topics = TextContent("**Topics:** Probability distributions, hypothesis testing, confidence intervals, and correlation.")
wk6due = Tag("Assignment 6 due Feb 18", null, "sm", "info")
wk7 = AccordionItem("w7", "Week 7: Machine Learning Basics", [wk7topics, wk7due])
wk7topics = TextContent("**Topics:** Supervised vs. unsupervised learning, train/test splits, linear regression, and classification.")
wk7due = Tag("Final Project proposal due Feb 25", null, "sm", "warning")
wk8 = AccordionItem("w8", "Week 8: Model Evaluation and Capstone", [wk8topics, wk8due])
wk8topics = TextContent("**Topics:** Accuracy, precision, recall, cross-validation, and presenting final project results.")
wk8due = Tag("Final Project due Mar 4", null, "sm", "danger")
dueTable = Table([Col("Week", dueWeeks), Col("Assignment", dueNames), Col("Due Date", dueDates), Col("Weight", dueWeights, "number")])
dueWeeks = ["Week 1", "Week 2", "Week 3", "Week 4", "Week 5", "Week 6", "Week 7", "Week 8"]
dueNames = ["Setup and Intro Quiz", "Python Problem Set", "Wrangling Notebook", "EDA Report", "Visualization Dashboard", "Statistics Problem Set", "Project Proposal", "Final Project"]
dueDates = ["Jan 14", "Jan 21", "Jan 28", "Feb 4", "Feb 11", "Feb 18", "Feb 25", "Mar 4"]
dueWeights = [5, 10, 10, 15, 15, 10, 5, 30]