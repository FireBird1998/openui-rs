root = Stack([header, statusCallout, updatesCard])
header = CardHeader("Nimbus X Launch Event: Live Blog", "Updates from the keynote, newest first")
statusCallout = Callout("info", "Live now", "The event is wrapping up. Pricing and availability have just been announced.")
updatesCard = Card([updatesHeader, updatesSteps])
updatesHeader = InlineHeader("Timeline", "All times PT")
updatesSteps = Steps([u1, u2, u3, u4, u5, u6])
u1 = StepsItem("11:42 AM · Pricing and availability", "Nimbus X starts at $799. Preorders open today, shipping begins March 14 in 20 countries.")
u2 = StepsItem("11:25 AM · Battery life", "Rated for up to 22 hours of mixed use, with 70% charge in 30 minutes via the new 65W adapter.")
u3 = StepsItem("11:08 AM · Live demo of Nimbus Assist", "The on-device assistant summarized a 40-page document in under five seconds, running fully offline.")
u4 = StepsItem("10:49 AM · Camera system unveiled", "A new 50MP triple-camera array with improved low-light performance and 8K video recording.")
u5 = StepsItem("10:31 AM · Meet the Nimbus X", "A 6.4-inch display, a titanium frame, and a 30% faster custom chip. Weighs just 168 grams.")
u6 = StepsItem("10:00 AM · Keynote begins", "CEO Maya Ortiz takes the stage and welcomes attendees to the Nimbus launch event.")