root = Stack([header, kpis, charts, incidentsHeader, incidentsTable])
header = CardHeader("Server Monitoring", "prod-web-01 · Last updated just now")
kpis = OverviewCardBlock([k1, k2, k3, k4], "grid")
k1 = OverviewCardItem("cpu", k1top, k1bot)
k1top = IconText(Icon("cpu", "tools"), "info", "m", "CPU Usage", "Current")
k1bot = MetricIndicatorInline("46%", "vs last hour", { direction: "up", value: 5 })
k2 = OverviewCardItem("mem", k2top, k2bot)
k2top = IconText(Icon("memory-stick", "tools"), "warning", "m", "Memory", "Current")
k2bot = MetricIndicatorInline("68%", "vs last hour", { direction: "up", value: 3 })
k3 = OverviewCardItem("uptime", k3top, k3bot)
k3top = IconText(Icon("clock", "time"), "success", "m", "Uptime", "Last 30 days")
k3bot = MetricIndicatorInline("99.94%", "42d 6h running", { direction: "up", value: 1 })
k4 = OverviewCardItem("inc", k4top, k4bot)
k4top = IconText(Icon("triangle-alert", "alerts"), "danger", "m", "Incidents", "Last 7 days")
k4bot = MetricIndicatorInline("4", "1 open", { direction: "down", value: 20 })
charts = Tabs([cpuTab, memTab])
cpuTab = TabItem("cpu", "CPU", [cpuChart])
memTab = TabItem("mem", "Memory", [memChart])
cpuChart = AreaChart(times, [Series("CPU %", cpuVals)], "natural", "Time", "Usage %")
memChart = LineChart(times, [Series("Memory %", memVals)], "natural", "Time", "Usage %")
times = ["00:00", "04:00", "08:00", "12:00", "16:00", "20:00", "24:00"]
cpuVals = [22, 18, 35, 62, 71, 54, 46]
memVals = [55, 56, 58, 63, 67, 66, 68]
incidentsHeader = InlineHeader("Recent Incidents", "Past 7 days")
incidentsTable = Table([Col("Incident", names), Col("Severity", sevTags), Col("Status", statTags), Col("Started", started), Col("Duration", durations)])
names = ["High CPU spike on web-01", "Memory leak in worker", "Disk latency warning", "Network timeout to DB"]
sevTags = [Tag("Critical", null, "sm", "danger"), Tag("High", null, "sm", "warning"), Tag("Low", null, "sm", "neutral"), Tag("Medium", null, "sm", "info")]
statTags = [Tag("Open", null, "sm", "danger"), Tag("Resolved", null, "sm", "success"), Tag("Resolved", null, "sm", "success"), Tag("Resolved", null, "sm", "success")]
started = ["Today 11:42", "Yesterday 21:10", "Mon 03:25", "Sun 14:08"]
durations = ["Ongoing", "1h 20m", "35m", "12m"]