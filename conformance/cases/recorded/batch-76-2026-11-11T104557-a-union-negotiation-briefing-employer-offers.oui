root = Stack([titleHeader, sideBySide, datesHeader, talksTable, unresolvedHeader, unresolvedCallout])
titleHeader = InlineHeader("Union Negotiation Briefing", "Employer offers and union demands, current status of talks")
sideBySide = Stack([employerCard, unionCard], "row", "m", "stretch", "start", true)
employerCard = Card([CardHeader("Employer Offers", "Latest position"), offerTable])
offerTable = Table([Col("Issue", offerIssues), Col("Offer", offerValues)])
offerIssues = ["Base wage increase", "Health premium share", "Pension contribution", "Overtime rules", "Job security"]
offerValues = ["2.0% per year", "15% employee share", "3% match", "Unchanged", "Standard clauses"]
unionCard = Card([CardHeader("Union Demands", "Current ask"), demandTable])
demandTable = Table([Col("Issue", demandIssues), Col("Demand", demandValues)])
demandIssues = ["Base wage increase", "Health premium share", "Pension contribution", "Overtime rules", "Job security"]
demandValues = ["5.5% per year", "5% employee share", "6% match", "Time-and-a-half after 40 hrs", "Seniority-based layoff protection"]
datesHeader = InlineHeader("Talks Schedule", "Dates of negotiation sessions")
talksTable = Table([Col("Date", talkDates), Col("Session", talkSessions), Col("Outcome", talkOutcomes)])
talkDates = ["2025-01-14", "2025-01-28", "2025-02-11", "2025-02-25", "2025-03-11"]
talkSessions = ["Opening proposals", "Wages and benefits", "Pension review", "Overtime and scheduling", "Mediator-led session"]
talkOutcomes = ["Positions exchanged", "Movement on health premiums", "Pension talks stalled", "Partial agreement on scheduling", "Scheduled for review"]
unresolvedHeader = InlineHeader("Unresolved Items", "Issues still open between the parties")
unresolvedCallout = Callout("warning", "Open Items", unresolvedList)
unresolvedList = "Wage gap of 3.5 points per year, pension match disagreement, overtime premium threshold, layoff protection terms, and health premium share above 10%."