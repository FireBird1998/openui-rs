root = Stack([header, infoBlock, sessionsHeader, sessionsTable, eligHeader, eligForm, regHeader, regForm])
header = CardHeader("Sleep & Cognition Study", "Participant scheduling — Department of Psychology")
infoBlock = SnippetCardBlock([s1, s2, s3, s4])
s1 = SnippetCardItem("duration", s1l, s1r)
s1l = IconText(s1i, "neutral", "m", "Duration", "Per session", false, "horizontal")
s1i = Icon("clock", "time")
s1r = BoldText("text", "90 minutes")
s2 = SnippetCardItem("visits", s2l, s2r)
s2l = IconText(s2i, "neutral", "m", "Total Visits", "Over study", false, "horizontal")
s2i = Icon("calendar-check", "time")
s2r = BoldText("text", "3 visits")
s3 = SnippetCardItem("comp", s3l, s3r)
s3l = IconText(s3i, "neutral", "m", "Compensation", "Per completed visit", false, "horizontal")
s3i = Icon("circle-dollar-sign", "finance")
s3r = BoldText("text", "$30")
s4 = SnippetCardItem("loc", s4l, s4r)
s4l = IconText(s4i, "neutral", "m", "Location", "Campus", false, "horizontal")
s4i = Icon("map-pin", "places")
s4r = BoldText("text", "Hall B, Rm 204")
sessionsHeader = InlineHeader("Available Sessions", "Pick a slot when registering")
sessionsTable = Table([Col("Date", dates), Col("Time", times), Col("Spots Left", spots, "number"), Col("Status", statuses)])
dates = ["Mon, Jun 9", "Tue, Jun 10", "Wed, Jun 11", "Thu, Jun 12", "Fri, Jun 13"]
times = ["9:00 AM", "1:00 PM", "10:30 AM", "3:00 PM", "11:00 AM"]
spots = [4, 2, 0, 5, 1]
statuses = [Tag("Open", null, "sm", "success"), Tag("Limited", null, "sm", "warning"), Tag("Full", null, "sm", "danger"), Tag("Open", null, "sm", "success"), Tag("Limited", null, "sm", "warning")]
eligHeader = InlineHeader("Eligibility Checklist", "Confirm all that apply before registering")
eligForm = Form("eligibility", eligBtns, [eligField])
eligField = FormControl("I meet the following criteria", eligChecks)
eligChecks = CheckBoxGroup("criteria", [c1, c2, c3, c4])
c1 = CheckBoxItem("Aged 18–35", "Must be an adult under 36", "age")
c2 = CheckBoxItem("No diagnosed sleep disorder", "E.g. insomnia, sleep apnea", "sleep")
c3 = CheckBoxItem("Normal or corrected vision", "Glasses or contacts are fine", "vision")
c4 = CheckBoxItem("Fluent in English", "Tasks are in English", "lang")
eligBtns = Buttons([Button("Check Eligibility", @ToAssistant("Check my eligibility"), "secondary")])
regHeader = InlineHeader("Register", "Reserve your session")
regForm = Form("register", regBtns, [fName, fEmail, fPhone, fSession, fNotes])
fName = FormControl("Full Name", Input("name", "Your name", "text", { required: true, minLength: 2 }))
fEmail = FormControl("Email", Input("email", "you@example.com", "email", { required: true, email: true }))
fPhone = FormControl("Phone", Input("phone", "555-123-4567", "text"), "Optional, for reminders")
fSession = FormControl("Preferred Session", Select("session", sessOpts, "Select a session...", { required: true }))
sessOpts = [SelectItem("jun9", "Mon, Jun 9 – 9:00 AM"), SelectItem("jun10", "Tue, Jun 10 – 1:00 PM"), SelectItem("jun12", "Thu, Jun 12 – 3:00 PM"), SelectItem("jun13", "Fri, Jun 13 – 11:00 AM")]
fNotes = FormControl("Notes", TextArea("notes", "Accessibility needs or questions", 3))
regBtns = Buttons([Button("Register", @ToAssistant("Submit registration"), "primary"), Button("Cancel", @ToAssistant("Cancel registration"), "secondary")])