root = Stack([header, alertsBlock])
header = InlineHeader("Morning Commute Traffic", "Live incidents affecting your route")
alertsBlock = Stack([alert1, alert2, alert3], "column", "m")
alert1 = Stack([alert1top, alert1tags], "column", "s")
alert1top = IconText(alert1icon, "danger", "m", "Multi-vehicle collision on I-95 Northbound", "Exit 14 to Exit 12, two lanes blocked", true, "horizontal")
alert1icon = Icon("car", "transport")
alert1tags = Stack([tag1sev, tag1delay], "row", "s")
tag1sev = Tag("Severe", null, "sm", "danger")
tag1delay = Tag("Est. delay 35 min", null, "sm", "warning")
alert2 = Stack([alert2top, alert2tags], "column", "s")
alert2top = IconText(alert2icon, "warning", "m", "Road construction on Route 9 Southbound", "Right lane closed near Main St bridge", true, "horizontal")
alert2icon = Icon("construction", "transport")
alert2tags = Stack([tag2sev, tag2delay], "row", "s")
tag2sev = Tag("Moderate", null, "sm", "warning")
tag2delay = Tag("Est. delay 12 min", null, "sm", "info")
alert3 = Stack([alert3top, alert3tags], "column", "s")
alert3top = IconText(alert3icon, "info", "m", "Disabled vehicle on Maple Ave Eastbound", "Shoulder lane blocked near Oak Street", true, "horizontal")
alert3icon = Icon("triangle-alert", "transport")
alert3tags = Stack([tag3sev, tag3delay], "row", "s")
tag3sev = Tag("Minor", null, "sm", "neutral")
tag3delay = Tag("Est. delay 5 min", null, "sm", "success")