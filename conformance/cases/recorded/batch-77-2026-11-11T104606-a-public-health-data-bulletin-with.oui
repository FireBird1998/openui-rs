root = Stack([header, note, kpis, chartCard, tableCard, lagCallout])
header = CardHeader("Regional Public Health Bulletin", "Weekly clinic visits · Fictional data for illustration · Weeks 1–8")
note = TextContent("This bulletin summarizes outpatient clinic visits across three fictional districts. Figures are provisional and may be revised.", "small")
kpis = OverviewCardBlock([k1, k2, k3])
k1 = OverviewCardItem("total", k1top, k1bot)
k1top = IconText(k1icon, "info", "m", "Total Visits (Wk 8)", "All districts", false, "horizontal")
k1icon = Icon("stethoscope", "health")
k1bot = MetricIndicatorInline("4,980", "vs. last week", { direction: "up", value: 5 })
k2 = OverviewCardItem("resp", k2top, k2bot)
k2top = IconText(k2icon, "warning", "m", "Respiratory Cases", "Week 8", false, "horizontal")
k2icon = Icon("wind", "health")
k2bot = MetricIndicatorInline("1,120", "vs. last week", { direction: "up", value: 9 })
k3 = OverviewCardItem("report", k3top, k3bot)
k3top = IconText(k3icon, "success", "m", "Reporting Clinics", "Of 60 total", false, "horizontal")
k3icon = Icon("hospital", "health")
k3bot = MetricIndicatorInline("52", "Clinics reported", { direction: "down", value: 3 })
chartCard = Card([chartHeader, chart])
chartHeader = CardHeader("Weekly Clinic Visits by District", "Number of visits per week")
chart = LineChart(weeks, [s1, s2, s3], "natural", "Week", "Visits")
weeks = ["Wk 1", "Wk 2", "Wk 3", "Wk 4", "Wk 5", "Wk 6", "Wk 7", "Wk 8"]
s1 = Series("North District", [1620, 1580, 1710, 1750, 1800, 1830, 1880, 1950])
s2 = Series("Central District", [1900, 1940, 1920, 2010, 2060, 2100, 2140, 2230])
s3 = Series("South District", [680, 700, 720, 710, 760, 790, 770, 800])
tableCard = Card([tableHeader, tbl])
tableHeader = CardHeader("Data Table", "Same figures as the chart, with totals")
tbl = Table([Col("Week", weeks), Col("North", s1v, "number"), Col("Central", s2v, "number"), Col("South", s3v, "number"), Col("Total", totals, "number")])
s1v = [1620, 1580, 1710, 1750, 1800, 1830, 1880, 1950]
s2v = [1900, 1940, 1920, 2010, 2060, 2100, 2140, 2230]
s3v = [680, 700, 720, 710, 760, 790, 770, 800]
totals = [4200, 4220, 4350, 4470, 4620, 4720, 4790, 4980]
lagCallout = Callout("warning", "Note on Data Lag", "Clinics submit visit counts up to 14 days after the week ends, so the most recent 2–3 weeks are typically undercounted and revised upward in later bulletins. Interpret recent trends with caution; late-reporting clinics are not yet included in Week 7–8 totals.")