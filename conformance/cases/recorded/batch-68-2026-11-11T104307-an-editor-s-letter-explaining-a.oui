root = Stack([masthead, letter, sectionsHeader, sectionCards, feedbackBtns])
masthead = TextContent("The Weekend Edition", "large-heavy")
letter = Card([letterHeader, letterBody])
letterHeader = CardHeader("A Letter from the Editor", "Introducing our new weekend edition")
letterBody = MarkDownRenderer("Dear readers,\n\nAfter years of listening to your feedback, we are excited to introduce **The Weekend Edition**: a slower, more thoughtful companion to our weekday coverage. Saturdays and Sundays will bring longer essays, deeper reporting, and stories that reward an unhurried read with a cup of coffee.\n\nYou will find three new regular sections waiting for you each weekend. We hope they become a place to pause, reflect, and discover something unexpected.\n\nThank you for reading, and for helping us shape what comes next.\n\nWarmly,\n\nThe Editorial Team", "clear")
sectionsHeader = InlineHeader("Inside Each Weekend", "Three sample sections to start")
sectionCards = Stack([sec1, sec2, sec3], "row", "m", "stretch", "start", true)
sec1 = Card([sec1Title, sec1Body])
sec1Title = CardHeader("The Long Read", "Feature journalism")
sec1Body = TextContent("One in-depth story each week, reported over months and written to be savored from start to finish.")
sec2 = Card([sec2Title, sec2Body])
sec2Title = CardHeader("Kitchen Table", "Food and culture")
sec2Body = TextContent("Recipes, traditions, and conversations with the people who keep them alive in their own homes.")
sec3 = Card([sec3Title, sec3Body])
sec3Title = CardHeader("Weekend Wanderer", "Travel and place")
sec3Body = TextContent("Short journeys close to home and far away, with practical tips for your next day out.")
feedbackBtns = Buttons([feedbackBtn], "row")
feedbackBtn = Button("Share Reader Feedback", @ToAssistant("I'd like to share feedback about The Weekend Edition"), "primary")