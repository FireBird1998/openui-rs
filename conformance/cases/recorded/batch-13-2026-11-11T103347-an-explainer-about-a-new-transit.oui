root = Stack([header, intro, faq])
header = CardHeader("New Transit Fare System", "Everything riders need to know about the upcoming changes")
intro = Callout("info", "Rollout Date", "The new tap-to-pay fare system begins on the first of next month across all bus, tram, and rail lines.")
faq = Accordion([q1, q2, q3, q4, q5])
q1 = AccordionItem("q1", "What is changing?", [a1])
a1 = TextContent("Paper tickets and fixed zone fares are being replaced by a **tap-in, tap-out** system. Fares are now calculated by distance traveled, and you pay with a contactless card, phone, or a reloadable transit card.")
q2 = AccordionItem("q2", "How much will I pay?", [a2, fareTable])
a2 = TextContent("Fares depend on the distance of your trip. A daily cap ensures you never pay more than the price of a day pass.")
fareTable = Table([Col("Trip Distance", dist), Col("Fare", fares), Col("Daily Cap", caps)])
dist = ["Up to 3 km", "3 to 10 km", "Over 10 km"]
fares = ["$1.75", "$2.50", "$3.75"]
caps = ["$6.00", "$6.00", "$6.00"]
q3 = AccordionItem("q3", "How do I pay?", [steps])
steps = Steps([s1, s2, s3])
s1 = StepsItem("Get a payment method", "Use a contactless bank card, a mobile wallet, or buy a transit card at any station or store.")
s2 = StepsItem("Tap in", "Tap your card or phone on the reader when boarding a bus or entering a station.")
s3 = StepsItem("Tap out", "Tap again when exiting. Forgetting to tap out charges the maximum fare for that route.")
q4 = AccordionItem("q4", "Are there discounts?", [a4, discountTags])
a4 = TextContent("Yes. Discounted fares of up to 50% are available for eligible riders. Register your card online to activate the discount.")
discountTags = TagBlock(["Students", "Seniors 65+", "Youth under 18", "Low-income program", "Riders with disabilities"], "md")
q5 = AccordionItem("q5", "What if my card is lost or I get charged incorrectly?", [a5, help])
a5 = TextContent("Registered cards can be blocked and the balance transferred to a replacement. Incorrect charges can be disputed within 60 days for a full review and refund.")
help = Buttons([Button("Contact support", @ToAssistant("How do I contact transit fare support?"), "primary"), Button("Ask another question", @ToAssistant("I have another question about the new fare system"), "secondary")])