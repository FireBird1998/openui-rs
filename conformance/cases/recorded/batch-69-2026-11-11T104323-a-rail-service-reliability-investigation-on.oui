root = Stack([header, kpis, opHeader, opChart, trendHeader, trendChart, routeHeader, routeTable, note])
header = CardHeader("Rail Service Reliability Investigation", "Operator punctuality, cancellations and problem routes over the last 6 months")
kpis = SnippetCardBlock([k1, k2, k3])
k1 = SnippetCardItem("otp", k1l, k1r)
k1l = IconText(k1i, "neutral", "m", "Network On-Time", "Within 5 min of schedule", false, "horizontal")
k1i = Icon("clock", "transport")
k1r = BoldText("number", "83.9%", "-1.2%", "metric")
k2 = SnippetCardItem("canc", k2l, k2r)
k2l = IconText(k2i, "neutral", "m", "Cancellation Rate", "June", false, "horizontal")
k2i = Icon("train-front", "transport")
k2r = BoldText("number", "3.4%", "+0.6%", "metric")
k3 = SnippetCardItem("worst", k3l, k3r)
k3l = IconText(k3i, "neutral", "m", "Weakest Operator", "Lowest on-time", false, "horizontal")
k3i = Icon("triangle-alert", "alerts")
k3r = BoldText("text", "Northern Link", "76.2%", "text")
opHeader = InlineHeader("On-Time Performance by Operator", "Percentage of services arriving within 5 minutes")
opChart = HorizontalBarChart(ops, [Series("On-time %", otp)], "grouped", "On-time %", "Operator")
ops = ["Coastal Express", "Metro Rail", "Midland Trains", "Eastern Railways", "Pennine Rail", "Northern Link"]
otp = [91.4, 88.7, 85.3, 82.9, 79.1, 76.2]
trendHeader = InlineHeader("Monthly Cancellation Trends", "Cancelled services as % of scheduled")
trendChart = LineChart(months, [Series("Northern Link", nl), Series("Pennine Rail", pr), Series("Eastern Railways", er), Series("Coastal Express", ce)], "natural", "Month", "Cancellation %")
months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun"]
nl = [4.8, 5.2, 5.9, 6.4, 7.1, 7.8]
pr = [3.9, 4.1, 4.6, 4.4, 5.0, 5.3]
er = [3.1, 3.4, 3.3, 3.8, 4.0, 4.2]
ce = [1.2, 1.1, 1.4, 1.3, 1.5, 1.4]
routeHeader = InlineHeader("Worst Performing Routes", "Ranked by on-time percentage")
routeTable = Table([Col("Route", routes), Col("Operator", routeOps), Col("On-Time %", routeOtp, "number"), Col("Cancelled %", routeCanc, "number"), Col("Avg Delay (min)", routeDelay, "number")])
routes = ["Leeds – Manchester Victoria", "Sheffield – Hull", "Liverpool – Newcastle", "Norwich – Peterborough", "Birmingham – Nottingham", "Preston – Blackpool"]
routeOps = ["Northern Link", "Northern Link", "Pennine Rail", "Eastern Railways", "Midland Trains", "Pennine Rail"]
routeOtp = [66.8, 69.4, 72.1, 74.5, 76.3, 77.9]
routeCanc = [9.2, 8.1, 7.4, 6.3, 5.6, 5.1]
routeDelay = [11.4, 9.8, 9.1, 8.2, 7.5, 7.0]
note = Callout("warning", "Key Finding", "Northern Link has worsened every month, with cancellations up 62% since January. Its two routes dominate the worst-performer list, suggesting a systemic fleet or crewing issue.")