root = Stack([header, dayTabs])
header = InlineHeader("Lisbon in Three Days", "A relaxed itinerary covering history, food, and viewpoints")
dayTabs = Tabs([day1, day3, day2])
day1 = TabItem("day1", "Day 1", [day1Card])
day2 = TabItem("day2", "Day 3", [day2Card])
day3 = TabItem("day3", "Day 2", [day3Card])
day1Card = Card([day1Header, day1Morning, day1Afternoon, day1Evening])
day1Header = CardHeader("Day 1: Historic Lisbon", "Alfama and the riverfront")
day1Morning = TextContent("**Morning:** Climb to São Jorge Castle early for panoramic views over the red rooftops, then wander the narrow lanes of Alfama.", "default")
day1Afternoon = TextContent("**Afternoon:** Visit the Lisbon Cathedral (Sé) and take Tram 28 through Graça and Baixa.", "default")
day1Evening = TextContent("**Evening:** Enjoy fado music at a traditional tasca in Alfama, followed by grilled sardines for dinner. **Restaurant suggestion:** Tasca do Chico in Alfama.", "default")
day2Card = Card([day2Header, day2Morning, day2Afternoon, day2Evening])
day2Header = CardHeader("Day 3: Belém and the Coast", "Monuments and pastries")
day2Morning = TextContent("**Morning:** Take the train to Belém and tour the Jerónimos Monastery and its magnificent cloisters.", "default")
day2Afternoon = TextContent("**Afternoon:** Visit the Belém Tower and the Monument to the Discoveries, then stop at Pastéis de Belém for the original custard tarts.", "default")
day2Evening = TextContent("**Evening:** Stroll along the Tagus waterfront to Cais do Sodré and enjoy seafood at the Time Out Market. **Restaurant suggestion:** Cervejaria Ramiro for garlic prawns and seafood.", "default")
day3Card = Card([day3Header, day3Morning, day3Afternoon, day3Evening])
day3Header = CardHeader("Day 2: Sintra Day Trip", "Palaces and forests")
day3Morning = TextContent("**Morning:** Take the train to Sintra and explore the colorful Pena Palace and its hilltop gardens.", "default")
day3Afternoon = TextContent("**Afternoon:** Walk through the Quinta da Regaleira estate, known for its mysterious initiation well, then have lunch in the village.", "default")
day3Evening = TextContent("**Evening:** Return to Lisbon and watch the sunset from Miradouro da Senhora do Monte, followed by dinner in Bairro Alto. **Restaurant suggestion:** Taberna da Rua das Flores for small plates and natural wine.", "default")