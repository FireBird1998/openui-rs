root = Stack([pageHeader, letter1, letter2, letter3, formHeader, letterForm])
pageHeader = InlineHeader("Reader Letters", "Letters from our readers across the region")
letter1 = Card([letter1Header, letter1Body])
letter1Header = CardHeader("The Lighthouse Question", "From Margaret Doyle, Port Halden")
letter1Body = TextContent("I have walked past the old lighthouse every morning for forty years. Last week the council announced its repairs, and I wanted to thank everyone who fought to keep it standing. It is more than a landmark; it is how this town knows where home is.")
letter2 = Card([letter2Header, letter2Body])
letter2Header = CardHeader("Buses Running Late Again", "From Tomasz Nowak, Eastbrook")
letter2Body = TextContent("The number 14 bus has arrived late every weekday this month. Parents waiting at the school gate have started walking instead, and the timetable on the stop board has not been updated since spring. Please look into it before winter.")
letter3 = Card([letter3Header, letter3Body])
letter3Header = CardHeader("Thanks to the Library Volunteers", "From Priya Raman, Millbrook Village")
letter3Body = TextContent("When the library's heating broke in January, a group of volunteers organised a reading marathon to keep the doors open. They kept the children's corner warm with space heaters and hot chocolate. Our village is lucky to have them.")
formHeader = InlineHeader("Submit a Letter", "Share your thoughts with our readers")
letterForm = Form("letter", letterButtons, [nameField, townField, letterField])
nameField = FormControl("Your Name", Input("name", "Full name", "text", { required: true, minLength: 2 }))
townField = FormControl("Town", Input("town", "e.g. Port Halden", "text", { required: true }))
letterField = FormControl("Your Letter", TextArea("letter", "Write your letter here...", 6, { required: true, minLength: 20 }))
letterButtons = Buttons([Button("Submit Letter", @ToAssistant("Submit a new reader letter"), "primary"), Button("Clear", @ToAssistant("Clear the letter form"), "secondary")])