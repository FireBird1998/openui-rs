root = Stack([title, chartCard, rolesCard])
title = TextContent("Hiring Pipeline", "large-heavy")
chartCard = Card([chartHeader, chart])
chartHeader = CardHeader("Candidates per Stage", "Current active pipeline across all roles")
chart = BarChart(stages, [candSeries], "grouped", "Stage", "Candidates")
stages = ["Applied", "Screening", "Phone Interview", "Onsite", "Offer", "Hired"]
candSeries = Series("Candidates", [248, 132, 74, 36, 12, 8])
rolesCard = Card([rolesHeader, rolesTable])
rolesHeader = CardHeader("Open Roles", "Positions currently being recruited")
rolesTable = Table([Col("Role", roles), Col("Department", depts), Col("Location", locs), Col("Openings", openings, "number"), Col("Candidates", cands, "number"), Col("Priority", priorityTags)])
roles = ["Senior Backend Engineer", "Product Designer", "Data Analyst", "Account Executive", "DevOps Engineer", "Marketing Manager"]
depts = ["Engineering", "Design", "Analytics", "Sales", "Engineering", "Marketing"]
locs = ["Remote", "New York", "London", "Chicago", "Remote", "Austin"]
openings = [2, 1, 1, 3, 1, 1]
cands = [64, 41, 38, 57, 29, 19]
priorityTags = [t1, t2, t3, t4, t5, t6]
t1 = Tag("High", null, "sm", "danger")
t2 = Tag("Medium", null, "sm", "warning")
t3 = Tag("Medium", null, "sm", "warning")
t4 = Tag("High", null, "sm", "danger")
t5 = Tag("High", null, "sm", "danger")
t6 = Tag("Low", null, "sm", "neutral")