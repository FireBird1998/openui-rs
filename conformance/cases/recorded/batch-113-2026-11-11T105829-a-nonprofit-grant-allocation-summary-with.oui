root = Stack([header, kpiBlock, chartCard, benCard, note])
header = CardHeader("Grant Allocation Summary", "Fiscal Year 2024 — Program funding overview")
kpiBlock = OverviewCardBlock([k1, k2, k3])
k1 = OverviewCardItem("total", k1top, k1m)
k1top = IconText(k1i, "neutral", "m", "Total Granted")
k1i = Icon("hand-coins", "finance")
k1m = MetricIndicatorInline("$2.4M", "vs last year", { direction: "up", value: 9 })
k2 = OverviewCardItem("ben", k2top, k2m)
k2top = IconText(k2i, "neutral", "m", "Beneficiaries")
k2i = Icon("users", "people")
k2m = MetricIndicatorInline("18,450", "people served", { direction: "up", value: 14 })
k3 = OverviewCardItem("programs", k3top, k3m)
k3top = IconText(k3i, "neutral", "m", "Active Programs")
k3i = Icon("layers", "tools")
k3m = MetricIndicatorInline("5", "funded programs")
chartCard = Card([chartHeader, pie])
chartHeader = InlineHeader("Funding by Program", "Share of $2.4M total grants")
pie = PieChart(["Education", "Health", "Food Security", "Housing", "Admin & Outreach"], [850000, 620000, 440000, 320000, 170000], "donut")
benCard = Card([benHeader, benTable])
benHeader = InlineHeader("Beneficiaries Served", "By program")
benTable = Table([Col("Program", progs), Col("Funding ($)", funds, "number"), Col("Beneficiaries", bens, "number"), Col("Cost per Person ($)", cpp, "number")])
progs = ["Education", "Health", "Food Security", "Housing", "Admin & Outreach"]
funds = [850000, 620000, 440000, 320000, 170000]
bens = [5200, 3800, 6900, 950, 1600]
cpp = [163, 163, 64, 337, 106]
note = Callout("warning", "Restricted Funds", "$1.1M of the total is donor-restricted: $600,000 for Education (scholarships only) and $500,000 for Housing (capital costs only). These funds cannot be reallocated to other programs or to general operations.")