root = Stack([header, cardEn, cardEs])
header = InlineHeader("Bilingual News Brief", "The same story, presented in English and Spanish")
cardEn = Card([enHeader, enBody, enBtn])
enHeader = CardHeader("English", "Museum opening")
enBody = MarkDownRenderer("**Harbor City Opens the Lumen Coast Museum**\n\nHARBOR CITY — The Lumen Coast Museum opened its doors this weekend, unveiling a waterfront campus dedicated to maritime art, climate science, and local history. The 42,000-square-foot building features three permanent galleries, a children's discovery lab, and a rooftop terrace overlooking the bay. Museum director Elena Varga said the institution aims to welcome 300,000 visitors in its first year. Admission for residents is free on the first Sunday of every month.", "clear")
enBtn = Button("Ask a follow-up", @ToAssistant("Give me more details about the Lumen Coast Museum opening in English"), "secondary")
cardEs = Card([esHeader, esBody, esBtn])
esHeader = CardHeader("Español", "Inauguración del museo")
esBody = MarkDownRenderer("**Harbor City inaugura el Museo Lumen Coast**\n\nHARBOR CITY — El Museo Lumen Coast abrió sus puertas este fin de semana, presentando un campus junto al mar dedicado al arte marítimo, la ciencia climática y la historia local. El edificio, de 42.000 pies cuadrados, cuenta con tres galerías permanentes, un laboratorio de descubrimiento para niños y una terraza en la azotea con vista a la bahía. La directora del museo, Elena Varga, afirmó que la institución espera recibir 300.000 visitantes en su primer año. La entrada para residentes será gratuita el primer domingo de cada mes.", "clear")
esBtn = Button("Hacer una pregunta", @ToAssistant("Dame más detalles sobre la inauguración del Museo Lumen Coast en español"), "secondary")