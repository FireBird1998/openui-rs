root = Stack([header, kpiBlock, chartCard, analysisCard])
header = InlineHeader("Quarterly Earnings - FY2024", "Retailer performance overview")
kpiBlock = OverviewCardBlock([k1, k2, k3, k4])
k1 = OverviewCardItem("rev", k1top, k1m)
k1top = IconText(k1i, "neutral", "m", "Total Revenue", "FY2024", false, "horizontal")
k1i = Icon("circle-dollar-sign", "finance")
k1m = MetricIndicatorInline("$4.82B", "vs FY2023", { direction: "up", value: 7 })
k2 = OverviewCardItem("profit", k2top, k2m)
k2top = IconText(k2i, "neutral", "m", "Net Profit", "FY2024", false, "horizontal")
k2i = Icon("trending-up", "finance")
k2m = MetricIndicatorInline("$386M", "vs FY2023", { direction: "up", value: 11 })
k3 = OverviewCardItem("margin", k3top, k3m)
k3top = IconText(k3i, "neutral", "m", "Net Margin", "FY2024", false, "horizontal")
k3i = Icon("percent", "finance")
k3m = MetricIndicatorInline("8.0%", "vs 7.7%", { direction: "up", value: 4 })
k4 = OverviewCardItem("sss", k4top, k4m)
k4top = IconText(k4i, "neutral", "m", "Same-Store Sales", "FY2024", false, "horizontal")
k4i = Icon("store", "shopping")
k4m = MetricIndicatorInline("+3.2%", "YoY", { direction: "up", value: 3 })
chartCard = Card([chartHeader, chart])
chartHeader = CardHeader("Revenue and Profit by Quarter", "In $ millions")
chart = BarChart(["Q1", "Q2", "Q3", "Q4"], [s1, s2], "grouped", "Quarter", "$ millions")
s1 = Series("Revenue", [1050, 1090, 1130, 1550])
s2 = Series("Profit", [74, 82, 88, 142])
analysisCard = Card([analysisHeader, analysisText, note])
analysisHeader = CardHeader("Analysis")
analysisText = TextContent("Revenue grew 7% year over year, with **Q4 contributing about 32%** of annual sales thanks to holiday demand. Profit rose faster than revenue (11%), lifting net margin from 7.7% to 8.0% as promotional spend was better controlled and supply chain costs eased. Q1 to Q3 were steady, with modest sequential growth of 3-4% per quarter.")
note = Callout("info", "Outlook", "Watch inventory levels and consumer spending heading into next year; margin gains depend on keeping markdowns in check.")