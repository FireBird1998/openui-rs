root = Stack([header, infoCallout, form])
header = CardHeader("Community Tool Library", "Borrow a tool for your next project")
infoCallout = Callout("info", "Deposit required", "A refundable deposit is held until the tool is returned in good condition.")
form = Form("borrow", btns, [nameField, emailField, toolField, startField, endField, careField, depositField])
nameField = FormControl("Full Name", Input("name", "Your name", "text", { required: true, minLength: 2 }))
emailField = FormControl("Email", Input("email", "you@example.com", "email", { required: true, email: true }))
toolField = FormControl("Tool", Select("tool", toolOpts, "Select a tool...", { required: true }))
toolOpts = [SelectItem("drill", "Cordless Drill"), SelectItem("saw", "Circular Saw"), SelectItem("ladder", "Extension Ladder"), SelectItem("sander", "Orbital Sander"), SelectItem("pressure", "Pressure Washer"), SelectItem("tiller", "Garden Tiller")]
startField = FormControl("Pickup Date", DatePicker("startDate", "single", { required: true }))
endField = FormControl("Return Date", DatePicker("endDate", "single", { required: true }), "Loans are typically up to 7 days")
careField = FormControl("Care Checklist", careGroup, "Please confirm each item")
careGroup = CheckBoxGroup("care", [c1, c2, c3, c4], { required: true })
c1 = CheckBoxItem("Inspect on pickup", "I checked the tool for damage before leaving", "inspect")
c2 = CheckBoxItem("Use as intended", "I will only use the tool for its designed purpose", "intended")
c3 = CheckBoxItem("Clean before return", "I will clean the tool and remove debris", "clean")
c4 = CheckBoxItem("Report problems", "I will report any damage or malfunction promptly", "report")
depositField = FormControl("Deposit", depositGroup)
depositGroup = CheckBoxGroup("deposit", [d1], { required: true })
d1 = CheckBoxItem("I acknowledge the deposit", "I understand a $20 refundable deposit is required and may be forfeited for damage or late return", "depositAck")
btns = Buttons([Button("Submit Request", @ToAssistant("Submit tool borrowing request"), "primary"), Button("Cancel", @ToAssistant("Cancel borrowing request"), "secondary")])