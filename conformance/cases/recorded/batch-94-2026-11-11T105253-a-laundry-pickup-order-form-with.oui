root = Stack([header, form])
header = InlineHeader("Laundry Pickup", "Schedule a pickup and we'll handle the rest")
form = Form("laundryOrder", formButtons, [serviceField, garmentField, slotField, summaryField, notesField])
serviceField = FormControl("Service", serviceCards, "Choose how you want your laundry cleaned")
serviceCards = OptionCards("service", "single", [svcWash, svcDry, svcPremium])
svcWash = OptionCard("wash-fold", "Wash & Fold", "Washed, dried and folded, $1.50/lb", svcWashIcon)
svcWashIcon = Icon("washing-machine", "laundry")
svcDry = OptionCard("dry-clean", "Dry Cleaning", "Professional care for delicate fabrics, from $8/item", svcDryIcon)
svcDryIcon = Icon("shirt", "laundry")
svcPremium = OptionCard("premium", "Premium Express", "24-hour turnaround with hand finishing, $2.50/lb", svcPremiumIcon)
svcPremiumIcon = Icon("zap", "laundry")
garmentField = FormControl("Garment Count", garmentInputs, "Estimate how many items of each type")
garmentInputs = Stack([shirtInput, pantsInput, bedInput], "row", "m", "start", "start", true)
shirtInput = Input("shirts", "0", "number", { min: 0, max: 99, numeric: true })
pantsInput = Input("pants", "0", "number", { min: 0, max: 99, numeric: true })
bedInput = Input("bedding", "0", "number", { min: 0, max: 20, numeric: true })
slotField = FormControl("Pickup Slot", slotSelect, "We pick up within a 2-hour window")
slotSelect = Select("pickupSlot", slotItems, "Select a time slot", { required: true })
slotItems = [SelectItem("mon-am", "Mon, 8:00 AM - 10:00 AM"), SelectItem("mon-pm", "Mon, 5:00 PM - 7:00 PM"), SelectItem("wed-am", "Wed, 8:00 AM - 10:00 AM"), SelectItem("fri-pm", "Fri, 5:00 PM - 7:00 PM")]
summaryField = FormControl("Price Summary", summaryCard, "Estimated total, final price confirmed at pickup")
summaryCard = Card([summaryRows, summaryTotal], "sunk")
summaryRows = EntityList([summaryService, summaryGarments, summaryFee], "default")
summaryService = { left: "Service", right: "Wash & Fold, 12 lb", rightVariant: "text" }
summaryGarments = { left: "Garments (est.)", right: "$18.00", rightVariant: "number" }
summaryFee = { left: "Pickup fee", right: "$5.00", rightVariant: "number" }
summaryTotal = BoldText("number", "Estimated total: $23.00", "Tax included", "text", "md")
notesField = FormControl("Notes", notesInput, "Pocket checks, stain treatments, special instructions")
notesInput = TextArea("notes", "e.g. hang shirts, no fabric softener", 3)
formButtons = Buttons([Button("Schedule Pickup", @ToAssistant("Schedule my laundry pickup"), "primary"), Button("Cancel", @ToAssistant("Cancel laundry order"), "secondary")])