root = Stack([heading, transcript, decisionCallout])
heading = TextContent("Press Conference Transcript", "large-heavy")
transcript = Card([cardHeader, excerpt])
cardHeader = CardHeader("Excerpt", "Speaker labels and timestamps")
excerpt = Stack([line1, line2, line3, line4, line5], "column", "s")
line1 = TextContent("**[00:00:12] MODERATOR:** Good afternoon, everyone. Thank you for joining us today.")
line2 = TextContent("**[00:00:25] REPORTER (Jane Cole, Daily Ledger):** Can you confirm whether the board has reached a decision on the proposed merger?")
line3 = TextContent("**[00:00:41] CEO (Maria Lopez):** Yes. After months of review, the board has voted to proceed with the merger, subject to regulatory approval.")
line4 = TextContent("**[00:01:03] REPORTER (Tom Reiss, Wire News):** What does this mean for employees and current contracts?")
line5 = TextContent("**[00:01:15] CEO (Maria Lopez):** All current employees will be retained for at least twelve months, and existing contracts will be honored in full.")
decisionCallout = Callout("success", "Announced Decision", "The board has voted to proceed with the merger, subject to regulatory approval.")