root = Stack([notebookHeader, profilesHeader, profileCards, citationsHeader, citationsCard, questionsHeader, questionsCard])
notebookHeader = InlineHeader("Whitfield Family Research Notebook", "Ancestor profiles, source citations and open questions")
profilesHeader = InlineHeader("Ancestor Profiles", "Core biographical records")
profileCards = CompositeCardBlock([p1, p2, p3])
p1 = CompositeCardItem("margaret-whitfield", p1header, [p1body], p1footer)
p1header = IconText(p1icon, "neutral", "m", "Margaret Whitfield", "b. 1868, Leeds, England", true, "horizontal")
p1icon = Icon("user", "people")
p1body = EntityList([p1r1, p1r2, p1r3, p1r4], "small")
p1r1 = { left: "Spouse", right: "John Whitfield (m. 1889)" }
p1r2 = { left: "Occupation", right: "Textile mill worker" }
p1r3 = { left: "Immigrated", right: "1892, New York" }
p1r4 = { left: "Died", right: "1941, Pittsburgh, PA" }
p1footer = { price: BoldText("text", "3 sources"), button: p1btn }
p1btn = Button("View Record", @ToAssistant("Show full record for Margaret Whitfield"), "secondary")
p2 = CompositeCardItem("john-whitfield", p2header, [p2body], p2footer)
p2header = IconText(p2icon, "neutral", "m", "John Whitfield", "b. 1862, Yorkshire, England", true, "horizontal")
p2icon = Icon("user", "people")
p2body = EntityList([p2r1, p2r2, p2r3, p2r4], "small")
p2r1 = { left: "Spouse", right: "Margaret Whitfield (m. 1889)" }
p2r2 = { left: "Occupation", right: "Coal miner, later foreman" }
p2r3 = { left: "Immigrated", right: "1891, Philadelphia, PA" }
p2r4 = { left: "Died", right: "1915, Pittsburgh, PA" }
p2footer = { price: BoldText("text", "2 sources"), button: p2btn }
p2btn = Button("View Record", @ToAssistant("Show full record for John Whitfield"), "secondary")
p3 = CompositeCardItem("elsie-whitfield", p3header, [p3body], p3footer)
p3header = IconText(p3icon, "neutral", "m", "Elsie Whitfield Hart", "b. 1894, Pittsburgh, PA", true, "horizontal")
p3icon = Icon("user", "people")
p3body = EntityList([p3r1, p3r2, p3r3], "small")
p3r1 = { left: "Parents", right: "John & Margaret Whitfield" }
p3r2 = { left: "Spouse", right: "Walter Hart (m. 1916)" }
p3r3 = { left: "Died", right: "1972, Pittsburgh, PA" }
p3footer = { price: BoldText("text", "4 sources"), button: p3btn }
p3btn = Button("View Record", @ToAssistant("Show full record for Elsie Whitfield Hart"), "secondary")
citationsHeader = InlineHeader("Document Citations", "Sources supporting each record")
citationsCard = Card([citationTable])
citationTable = Table([Col("Document", docs), Col("Type", types), Col("Date", dates), Col("Ancestor", ancestors), Col("Location", locations)])
docs = ["Marriage Register, St. Peter's Church", "Passenger Manifest, SS Germanic", "Pennsylvania Death Index", "1900 US Federal Census", "Parish Baptism Record", "Mine Employment Ledger"]
types = ["Church record", "Immigration", "Vital record", "Census", "Church record", "Employment"]
dates = ["1889-06-14", "1892-05-03", "1915-08-22", "1900-06-05", "1868-03-19", "1906-11-30"]
ancestors = ["John & Margaret Whitfield", "Margaret Whitfield", "John Whitfield", "Whitfield Household", "Margaret Whitfield", "John Whitfield"]
locations = ["Leeds, England", "New York, NY", "Pittsburgh, PA", "Pittsburgh, PA", "Leeds, England", "Pittsburgh, PA"]
questionsHeader = InlineHeader("Unresolved Questions", "Leads to investigate next")
questionsCard = Card([questionsCallout, questionsTags])
questionsCallout = Callout("warning", "Open Research Questions", "Several records conflict or remain unfound. Review before drawing conclusions.")
questionsTags = TagBlock(["Unknown mother of John Whitfield", "Conflicting immigration year", "Missing 1910 census", "Possible name variant: Whitfeld", "Elsie's first marriage?"])