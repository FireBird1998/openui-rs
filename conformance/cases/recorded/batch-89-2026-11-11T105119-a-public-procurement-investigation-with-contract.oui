root = Stack([header, kpis, alert1, alert2, tabs, followup])
header = CardHeader("Public Procurement Investigation", "Municipal Infrastructure Tenders, FY2023–2024")
kpis = SnippetCardBlock([k1, k2, k3, k4])
k1 = SnippetCardItem("total", k1l, k1r)
k1l = IconText(Icon("banknote", "finance"), "neutral", "m", "Total Awarded", "7 suppliers", false, "horizontal")
k1r = BoldText("number", "$84.6M")
k2 = SnippetCardItem("tenders", k2l, k2r)
k2l = IconText(Icon("file-text", "documents"), "neutral", "m", "Tenders Reviewed", "Since Jan 2023", false, "horizontal")
k2r = BoldText("number", "38")
k3 = SnippetCardItem("single", k3l, k3r)
k3l = IconText(Icon("user", "people"), "warning", "m", "Single-Bidder Awards", "Of all tenders", false, "horizontal")
k3r = BoldText("number", "11", "29%", "text")
k4 = SnippetCardItem("missing", k4l, k4r)
k4l = IconText(Icon("triangle-alert", "alerts"), "danger", "m", "Missing Disclosures", "Flagged contracts", false, "horizontal")
k4r = BoldText("number", "9")
alert1 = Callout("error", "Missing beneficial ownership disclosure", "Northgate Civil Works and Meridian Logistics Ltd. did not disclose beneficial owners in 5 contracts totaling $23.1M.")
alert2 = Callout("warning", "Missing conflict-of-interest declarations", "4 evaluation committee members have no signed declarations on file for tenders T-2023-014, T-2023-021 and T-2024-003.")
tabs = Tabs([tabSupplier, tabTimeline, tabTenders])
tabSupplier = TabItem("suppliers", "By Supplier", [supChart, supPie])
supChart = BarChart(supNames, [Series("Contract Value ($M)", supVals)], "grouped", "Supplier", "Value ($M)")
supPie = PieChart(supNames, supVals, "donut")
supNames = ["Northgate Civil Works", "Meridian Logistics", "Apex Builders", "Castellan Engineering", "Hollis & Rowe", "BlueRiver Utilities", "Tanner Group"]
supVals = [24.8, 18.3, 12.5, 9.7, 8.1, 6.4, 4.8]
tabTimeline = TabItem("timeline", "Tender Timeline", [lineChart])
lineChart = LineChart(months, [Series("Awarded ($M)", monthVals), Series("Single-bidder ($M)", singleVals)], "natural", "Award month", "Value ($M)")
months = ["Jan 23", "Apr 23", "Jul 23", "Oct 23", "Jan 24", "Apr 24", "Jul 24", "Oct 24"]
monthVals = [6.2, 9.8, 12.4, 8.9, 14.1, 10.5, 13.7, 9.0]
singleVals = [1.5, 3.2, 5.9, 2.1, 6.8, 2.4, 4.6, 1.9]
tabTenders = TabItem("tenders", "Tender Register", [tbl])
tbl = Table([Col("Tender ID", ids), Col("Supplier", tSup), Col("Tender Date", dates), Col("Value ($M)", vals, "number"), Col("Bidders", bidders, "number"), Col("Disclosure", disc)])
ids = ["T-2023-014", "T-2023-021", "T-2023-033", "T-2024-003", "T-2024-011", "T-2024-019"]
tSup = ["Northgate Civil Works", "Meridian Logistics", "Apex Builders", "Northgate Civil Works", "Castellan Engineering", "Hollis & Rowe"]
dates = ["2023-03-14", "2023-06-02", "2023-09-21", "2024-01-30", "2024-05-17", "2024-08-09"]
vals = [8.4, 6.9, 5.2, 7.6, 4.3, 3.8]
bidders = [1, 1, 4, 1, 3, 2]
disc = [Tag("Missing", null, "sm", "danger"), Tag("Missing", null, "sm", "danger"), Tag("Complete", null, "sm", "success"), Tag("Missing", null, "sm", "danger"), Tag("Partial", null, "sm", "warning"), Tag("Complete", null, "sm", "success")]
followup = Buttons([Button("Draft information request", @ToAssistant("Draft a formal information request for the missing disclosures"), "primary"), Button("Profile Northgate Civil Works", @ToAssistant("Profile Northgate Civil Works and its contracts"), "secondary")])