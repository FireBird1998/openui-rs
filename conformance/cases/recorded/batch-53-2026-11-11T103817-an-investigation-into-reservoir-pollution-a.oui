root = Stack([header, summary, timelineHeader, timeline, chartCard, docsHeader, docCards])
header = CardHeader("Reservoir Pollution Investigation", "Lakeview Reservoir – sampling campaign, March to August")
summary = Callout("warning", "Elevated nitrate and lead levels", "Nitrate exceeded the 50 mg/L guideline in June and July. Lead peaked at 14 µg/L in July, above the 10 µg/L limit.")
timelineHeader = InlineHeader("Sampling Timeline", "Key dates and findings")
timeline = Steps([st1, st2, st3, st4, st5])
st1 = StepsItem("Mar 12 – Baseline sampling", "Five sites sampled. All contaminants within limits.")
st2 = StepsItem("Apr 18 – Routine sampling", "Slight rise in nitrate near the northern inlet.")
st3 = StepsItem("Jun 05 – Alert sampling", "Following fish die-off reports, nitrate exceeded the guideline at 3 of 5 sites.")
st4 = StepsItem("Jul 10 – Source tracing", "Lead peak detected near the old industrial outfall. Upstream samples collected.")
st5 = StepsItem("Aug 14 – Post-remediation", "After inlet diversion, levels falling but still above baseline.")
chartCard = Card([chartHeader, chart])
chartHeader = CardHeader("Contaminant Levels Over Time", "Nitrate (mg/L, left scale) and lead (µg/L), mean of all sites")
chart = LineChart(months, [nitrate, lead, limitNitrate], "natural", "Sampling date", "Concentration")
months = ["Mar 12", "Apr 18", "May 20", "Jun 05", "Jul 10", "Aug 14"]
nitrate = Series("Nitrate (mg/L)", [18, 29, 41, 58, 63, 44])
lead = Series("Lead (µg/L)", [2, 3, 6, 11, 14, 9])
limitNitrate = Series("Nitrate guideline (50)", [50, 50, 50, 50, 50, 50])
docsHeader = InlineHeader("Evidence Documents", "Source reports and lab results")
docCards = CompositeCardBlock([d1, d2, d3, d4])
d1 = CompositeCardItem("lab-june", d1h, [d1b], d1f)
d1h = IconText(i1, "info", "m", "Lab Report – June 05", "Accredited lab, 5 sites", true, "horizontal")
i1 = Icon("flask-conical", "science")
d1b = Text("text", "Nitrate and phosphate results with chain-of-custody forms.")
d1f = { button: d1btn }
d1btn = Button("Open document", @ToAssistant("Open Lab Report – June 05"), "secondary")
d2 = CompositeCardItem("lead-july", d2h, [d2b], d2f)
d2h = IconText(i2, "danger", "m", "Heavy Metals Analysis – July 10", "Lead, cadmium, zinc", true, "horizontal")
i2 = Icon("test-tube", "science")
d2b = Text("text", "Lead peaked at 14 µg/L near the old industrial outfall.")
d2f = { button: d2btn }
d2btn = Button("Open document", @ToAssistant("Open Heavy Metals Analysis – July 10"), "secondary")
d3 = CompositeCardItem("site-survey", d3h, [d3b], d3f)
d3h = IconText(i3, "warning", "m", "Catchment Site Survey", "Field inspection notes", true, "horizontal")
i3 = Icon("map-pin", "navigation")
d3b = Text("text", "Photos and notes on farm runoff and discharge points upstream.")
d3f = { button: d3btn }
d3btn = Button("Open document", @ToAssistant("Open Catchment Site Survey"), "secondary")
d4 = CompositeCardItem("remediation", d4h, [d4b], d4f)
d4h = IconText(i4, "success", "m", "Remediation Report – August", "Inlet diversion results", true, "horizontal")
i4 = Icon("file-check", "files")
d4b = Text("text", "Post-diversion monitoring shows nitrate down 30% from its peak.")
d4f = { button: d4btn }
d4btn = Button("Open document", @ToAssistant("Open Remediation Report – August"), "secondary")