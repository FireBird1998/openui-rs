root = Stack([header, standingsCard, pairingsCard])
header = InlineHeader("Chess Tournament: Spring Open 2025", "Round 5 of 7 · Swiss system")
standingsCard = Card([standingsTitle, standingsTable])
standingsTitle = CardHeader("Standings", "Ranked by points, then tie-break scores")
standingsTable = Table([colRank, colPlayer, colRating, colPoints, colBuchholz, colSonneborn])
colRank = Col("Rank", ["1", "2", "3", "4", "5", "6", "7", "8"])
colPlayer = Col("Player", ["Anna Petrova", "Liam Chen", "Sofia Rossi", "Marcus Weber", "Yuki Tanaka", "Omar Haddad", "Elena Volkova", "David Okafor"])
colRating = Col("Rating", [2510, 2465, 2420, 2398, 2375, 2344, 2310, 2288], "number")
colPoints = Col("Points", [4.0, 3.5, 3.5, 3.0, 3.0, 2.5, 2.0, 1.5], "number")
colBuchholz = Col("Buchholz", [14.5, 13.0, 13.5, 12.0, 11.5, 11.0, 10.5, 9.5], "number")
colSonneborn = Col("Sonneborn-Berger", [6.25, 5.75, 5.5, 4.75, 4.5, 3.75, 3.25, 2.0], "number")
pairingsCard = Card([pairingsTitle, pairingsTable])
pairingsTitle = CardHeader("Round 6 Pairings", "Board assignments for the next round")
pairingsTable = Table([colBoard, colWhite, colBlack, colResult])
colBoard = Col("Board", ["1", "2", "3", "4"])
colWhite = Col("White", ["Anna Petrova", "Sofia Rossi", "Yuki Tanaka", "Elena Volkova"])
colBlack = Col("Black", ["Liam Chen", "Marcus Weber", "Omar Haddad", "David Okafor"])
colResult = Col("Status", ["Scheduled", "Scheduled", "Scheduled", "Scheduled"])