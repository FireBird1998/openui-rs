root = Stack([header, filterCard, expertsHeader, cards])
header = CardHeader("Newsroom Source Directory", "Vetted experts available for comment and background interviews")
filterCard = Card([filterForm])
filterForm = Form("subjectFilter", filterBtns, [subjectField])
subjectField = FormControl("Filter by subject", subjectChips, "Choose a subject to narrow the list")
subjectChips = Chips("subject", "single", [c1, c2, c3, c4, c5, c6])
c1 = ChipItem("all", "All")
c2 = ChipItem("climate", "Climate")
c3 = ChipItem("health", "Public Health")
c4 = ChipItem("economics", "Economics")
c5 = ChipItem("cyber", "Cybersecurity")
c6 = ChipItem("law", "Law & Policy")
filterBtns = Buttons([Button("Apply filter", @ToAssistant("Filter the source directory by the selected subject"), "primary")])
expertsHeader = InlineHeader("Experts", "Five sources on file")
cards = Stack([e1, e2, e3, e4, e5])

e1 = Card([e1h, e1tags, e1list, e1btns])
e1h = CardHeader("Dr. Amara Okonkwo", "Professor of Climate Science, Lakeshore University")
e1tags = TagBlock(["Climate", "Extreme weather", "Policy"], "sm")
e1list = EntityList([{left: "Institution", right: "Lakeshore University"}, {left: "Languages", right: "English, Igbo"}, {left: "Availability", right: "Weekdays, 9am-6pm"}])
e1btns = Buttons([Button("Email", @OpenUrl("mailto:a.okonkwo@example.com"), "primary"), Button("Call", @OpenUrl("tel:+15550100101"), "secondary")])

e2 = Card([e2h, e2tags, e2list, e2btns])
e2h = CardHeader("Dr. Luis Fernandez", "Epidemiologist, Northbridge School of Public Health")
e2tags = TagBlock(["Public Health", "Infectious disease", "Vaccines"], "sm")
e2list = EntityList([{left: "Institution", right: "Northbridge School of Public Health"}, {left: "Languages", right: "English, Spanish"}, {left: "Availability", right: "Same-day for breaking news"}])
e2btns = Buttons([Button("Email", @OpenUrl("mailto:l.fernandez@example.com"), "primary"), Button("Call", @OpenUrl("tel:+15550100102"), "secondary")])

e3 = Card([e3h, e3tags, e3list, e3btns])
e3h = CardHeader("Prof. Mei Tanaka", "Labor Economist, Harbor Institute for Economic Research")
e3tags = TagBlock(["Economics", "Labor markets", "Inflation"], "sm")
e3list = EntityList([{left: "Institution", right: "Harbor Institute for Economic Research"}, {left: "Languages", right: "English, Japanese"}, {left: "Availability", right: "Mornings, by appointment"}])
e3btns = Buttons([Button("Email", @OpenUrl("mailto:m.tanaka@example.com"), "primary"), Button("Call", @OpenUrl("tel:+15550100103"), "secondary")])

e4 = Card([e4h, e4tags, e4list, e4btns])
e4h = CardHeader("Samir Haddad", "Senior Researcher, Digital Defense Lab")
e4tags = TagBlock(["Cybersecurity", "Ransomware", "Privacy"], "sm")
e4list = EntityList([{left: "Institution", right: "Digital Defense Lab"}, {left: "Languages", right: "English, Arabic, French"}, {left: "Availability", right: "Evenings and weekends"}])
e4btns = Buttons([Button("Email", @OpenUrl("mailto:s.haddad@example.com"), "primary"), Button("Call", @OpenUrl("tel:+15550100104"), "secondary")])

e5 = Card([e5h, e5tags, e5list, e5btns])
e5h = CardHeader("Hon. Rebecca Lindqvist", "Constitutional Law Scholar, Meridian Law School")
e5tags = TagBlock(["Law & Policy", "Constitutional law", "Elections"], "sm")
e5list = EntityList([{left: "Institution", right: "Meridian Law School"}, {left: "Languages", right: "English, Swedish"}, {left: "Availability", right: "Weekdays, 10am-4pm"}])
e5btns = Buttons([Button("Email", @OpenUrl("mailto:r.lindqvist@example.com"), "primary"), Button("Call", @OpenUrl("tel:+15550100105"), "secondary")])