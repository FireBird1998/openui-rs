root = Stack([header, c1, c2, c3])
header = InlineHeader("Corrections and Clarifications", "Recent corrections to previously published content")
c1 = Card([CardHeader("Correction 1", "Published March 3, 2025"), TextContent("**Original:** The company reported quarterly revenue of $4.2 billion, up 12% year over year."), TextContent("**Corrected:** The company reported quarterly revenue of $4.02 billion, up 9% year over year."), TextCallout("neutral", "Reason", "Figures were transposed from a preliminary earnings table.")])
c2 = Card([CardHeader("Correction 2", "Published February 18, 2025"), TextContent("**Original:** The new transit line will open in fall 2026 and serve 40,000 riders daily."), TextContent("**Corrected:** The new transit line will open in spring 2026 and serve an estimated 14,000 riders daily."), TextCallout("neutral", "Reason", "The original schedule and ridership figures were from an outdated city proposal.")])
c3 = Card([CardHeader("Correction 3", "Published January 27, 2025"), TextContent("**Original:** The study involved 1,200 participants across six countries."), TextContent("**Corrected:** The study involved 1,020 participants across four countries."), TextCallout("neutral", "Reason", "The participant count and country total were misreported in the initial summary.")])