root = Stack([title, intro, rentCard, incomeHeader, incomeCards, incomeTable, methodology])
title = TextContent("Housing Affordability Report", "large-heavy")
intro = TextContent("Median monthly rent compared with household income across city districts, with the share of income spent on rent.")
rentCard = Card([rentHeader, rentChart])
rentHeader = CardHeader("Median Monthly Rent by District", "USD, 2-bedroom units")
rentChart = HorizontalBarChart(districts, [rentSeries], "grouped", "Monthly rent (USD)", "District")
districts = ["Downtown", "Riverside", "Midtown", "Harbor Point", "Oakwood", "Eastgate", "Northfield", "Southpark"]
rentSeries = Series("Median Rent", [2850, 2420, 2190, 2010, 1760, 1540, 1425, 1310])
incomeHeader = InlineHeader("Household Income", "Median annual household income, citywide and select districts")
incomeCards = OverviewCardBlock([o1, o2, o3])
o1 = OverviewCardItem("city", o1top, o1bottom)
o1top = IconText(o1icon, "neutral", "m", "Citywide Median", "All households", false, "horizontal")
o1icon = Icon("users", "people")
o1bottom = MetricIndicatorInline("$71,400", "per year", { direction: "up", value: 3.2 })
o2 = OverviewCardItem("rent-burden", o2top, o2bottom)
o2top = IconText(o2icon, "warning", "m", "Rent Burden", "Rent as % of income", false, "horizontal")
o2icon = Icon("percent", "finance")
o2bottom = MetricIndicatorInline("32%", "citywide average", { direction: "up", value: 1.4 })
o3 = OverviewCardItem("renters", o3top, o3bottom)
o3icon = Icon("house", "buildings")
o3top = IconText(o3icon, "info", "m", "Renter Households", "Share of all households", false, "horizontal")
o3bottom = MetricIndicatorInline("46%", "of households", { direction: "down", value: 0.8 })
incomeTable = Table([Col("District", tDistricts), Col("Median Income", tIncome, "number"), Col("Median Rent", tRent, "number"), Col("Rent / Income %", tShare, "number")])
tDistricts = ["Downtown", "Riverside", "Midtown", "Harbor Point", "Oakwood", "Eastgate", "Northfield", "Southpark"]
tIncome = [96500, 88200, 79800, 72300, 64100, 52800, 55400, 47900]
tRent = [2850, 2420, 2190, 2010, 1760, 1540, 1425, 1310]
tShare = [35.4, 32.9, 32.9, 33.4, 32.9, 35.0, 30.9, 32.8]
methodology = Callout("info", "Methodology", "Rent figures are medians of active 2-bedroom listings and lease renewals from the past 12 months. Income figures come from the American Community Survey 5-year estimates. Rent burden is median annual rent divided by median household income; values above 30% are considered cost-burdened. District boundaries follow municipal planning zones. Figures are illustrative.")