root = Stack([header, detailsCard, threadHeader, thread, actionsHeader, actionBtns])
header = CardHeader("Ticket #48213", "Unable to export reports to CSV")
detailsCard = Card([detailsList, tags])
detailsList = EntityList([r1, r2, r3, r4, r5], "default")
r1 = { left: "Status", right: "Open" }
r2 = { left: "Priority", right: "High" }
r3 = { left: "Requester", right: "Dana Whitfield (dana@acme.io)" }
r4 = { left: "Assignee", right: "Marcus Chen" }
r5 = { left: "Created", right: "2024-06-12 09:41" }
tags = TagBlock(["export", "reports", "bug"], "sm")
threadHeader = InlineHeader("Conversation", "4 messages")
thread = Stack([m1, m2, m3, m4])
m1 = Card([m1h, m1t], "card")
m1h = CardHeader("Dana Whitfield", "Customer · Jun 12, 09:41")
m1t = TextContent("Hi, when I click Export CSV on the monthly report page nothing downloads. It worked last week.")
m2 = Card([m2h, m2t], "sunk")
m2h = CardHeader("Marcus Chen", "Support · Jun 12, 10:05")
m2t = TextContent("Thanks for reaching out, Dana. Which browser and version are you using? Any error shown in the console?")
m3 = Card([m3h, m3t], "card")
m3h = CardHeader("Dana Whitfield", "Customer · Jun 12, 10:22")
m3t = TextContent("Chrome 125. The console shows a `403` on `/api/reports/export`.")
m4 = Card([m4h, m4t], "sunk")
m4h = CardHeader("Marcus Chen", "Support · Jun 12, 10:40")
m4t = TextContent("Found it — a permissions change affected export tokens. I'm escalating to engineering and will update you shortly.")
actionsHeader = InlineHeader("Actions", "Update ticket status")
actionBtns = Buttons([b1, b2, b3, b4], "row")
b1 = Button("Reply", @ToAssistant("Draft a reply to the customer for ticket #48213"), "primary")
b2 = Button("Mark Pending", @ToAssistant("Set ticket #48213 to Pending"), "secondary")
b3 = Button("Resolve", @ToAssistant("Resolve ticket #48213"), "secondary")
b4 = Button("Close Ticket", @ToAssistant("Close ticket #48213"), "tertiary", "destructive")