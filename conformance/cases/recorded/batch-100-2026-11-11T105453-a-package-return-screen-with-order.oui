root = Stack([header, itemsCard, reasonCard, addressCard, refundCard, actionsRow])
header = InlineHeader("Return a Package", "Order #48213 · Delivered Mar 12")
itemsCard = Card([itemsHeader, itemsTable])
itemsHeader = CardHeader("Order Items", "Select the items you want to return")
itemsTable = Table([Col("Item", itemNames), Col("Qty", itemQty, "number"), Col("Price", itemPrices, "number")])
itemNames = ["Wireless Headphones", "USB-C Charging Cable", "Phone Case"]
itemQty = [1, 2, 1]
itemPrices = [89.99, 12.5, 19.0]
reasonCard = Card([reasonHeader, reasonForm])
reasonHeader = CardHeader("Return Reason", "Tell us why you're returning these items")
reasonForm = Form("returnReason", reasonButtons, [reasonField])
reasonField = FormControl("Reason", reasonSelect, "Required to process your return")
reasonSelect = Select("reason", reasonItems, "Choose a reason", { required: true })
reasonItems = [SelectItem("defective", "Defective or damaged"), SelectItem("wrong-item", "Wrong item received"), SelectItem("not-as-described", "Not as described"), SelectItem("no-longer-needed", "No longer needed"), SelectItem("other", "Other")]
reasonButtons = Buttons([Button("Continue", @ToAssistant("Continue with return reason"), "primary")])
addressCard = Card([addressHeader, addressForm])
addressHeader = CardHeader("Pickup Address", "Where should we collect the package?")
addressForm = Form("pickupAddress", addressButtons, [streetField, cityField, zipField])
streetField = FormControl("Street Address", streetInput)
streetInput = Input("street", "123 Main St", "text", { required: true, minLength: 5 })
cityField = FormControl("City", cityInput)
cityInput = Input("city", "Springfield", "text", { required: true })
zipField = FormControl("ZIP Code", zipInput)
zipInput = Input("zip", "62704", "text", { required: true, numeric: true, minLength: 5, maxLength: 5 })
addressButtons = Buttons([Button("Save Address", @ToAssistant("Save pickup address"), "secondary")])
refundCard = Card([refundHeader, refundForm])
refundHeader = CardHeader("Refund Method", "Choose how you'd like to be refunded")
refundForm = Form("refundMethod", refundButtons2, [refundField])
refundField = FormControl("Refund To", refundRadio)
refundRadio = RadioGroup("refundType", refundItems, "original", { required: true })
refundItems = [RadioItem("Original payment method", "Refund to the card used at purchase, 3–5 business days", "original"), RadioItem("Store credit", "Instant credit, plus a 10% bonus", "credit"), RadioItem("Bank transfer", "Direct deposit, 5–7 business days", "bank")]
refundButtons2 = Buttons([Button("Confirm Refund Method", @ToAssistant("Confirm refund method"), "secondary")])
actionsRow = Buttons([Button("Submit Return", @ToAssistant("Submit return request"), "primary", "normal", "large"), Button("Cancel", @ToAssistant("Cancel return"), "tertiary")], "row")