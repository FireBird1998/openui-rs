root = Stack([title, tabs])
title = TextContent("Top Headlines by Section", "large-heavy")
tabs = Tabs([tabWorld, tabBusiness, tabTech, tabSport])
tabWorld = TabItem("world", "World", worldContent)
tabBusiness = TabItem("business", "Business", businessContent)
tabTech = TabItem("tech", "Tech", techContent)
tabSport = TabItem("sport", "Sport", sportContent)
