root = Stack([title, tabs])
title = TextContent("Bistro Menu", "large-heavy")
tabs = Tabs([startersTab, mainsTab, dessertsTab])
startersTab = TabItem("starters", "Starters", [startersList])
mainsTab = TabItem("mains", "Mains", [mainsList])
dessertsTab = TabItem("desserts", "Desserts", [dessertsList])
startersList = EntityList([s1, s2, s3, s4], "default")
s1 = {left: "Burrata with heirloom tomatoes", right: "$14"}
s2 = {left: "Crispy calamari", right: "$12"}
s3 = {left: "Roasted beet salad", right: "$11"}
s4 = {left: "Soup of the day", right: "$8"}
mainsList = EntityList([m1, m2, m3, m4], "default")
m1 = {left: "Pan-seared salmon", right: "$28"}
m2 = {left: "Ribeye steak, 300g", right: "$36"}
m3 = {left: "Wild mushroom risotto", right: "$22"}
m4 = {left: "Chicken milanese", right: "$24"}
dessertsList = EntityList([d1, d2, d3], "default")
d1 = {left: "Dark chocolate fondant", right: "$10"}
d2 = {left: "Lemon posset", right: "$9"}
d3 = {left: "Seasonal fruit sorbet", right: "$7"}