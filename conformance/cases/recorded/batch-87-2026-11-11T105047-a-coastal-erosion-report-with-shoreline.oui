root = Stack([title, intro, kpiHeader, kpiBlock, retreatCard, tableCard, imgHeader, imgNote, scheduleHeader, scheduleTable, nextSteps])
title = TextContent("Coastal Erosion Report 2024", "large-heavy")
intro = Callout("warning", "Accelerating Retreat", "Three of five monitored beaches exceeded their 5-year average shoreline retreat this year, driven by winter storm surges.")
kpiHeader = InlineHeader("Key Findings", "Annual summary across five monitored beaches")
kpiBlock = SnippetCardBlock([k1, k2, k3])
k1 = SnippetCardItem("avg", k1l, k1r)
k1l = IconText(k1i, "neutral", "m", "Avg. Retreat", "All beaches", false, "horizontal")
k1i = Icon("waves", "nature")
k1r = BoldText("number", "1.9 m", "+0.4 m", "metric")
k2 = SnippetCardItem("max", k2l, k2r)
k2l = IconText(k2i, "neutral", "m", "Max Retreat", "Harlow Point", false, "horizontal")
k2i = Icon("triangle-alert", "alerts")
k2r = BoldText("number", "3.4 m", "+0.9 m", "metric")
k3 = SnippetCardItem("stable", k3l, k3r)
k3l = IconText(k3i, "neutral", "m", "Stable Beaches", "Under 1 m", false, "horizontal")
k3i = Icon("shield-check", "security")
k3r = BoldText("number", "1 of 5")
retreatCard = Card([retreatHeader, retreatChart])
retreatHeader = CardHeader("Shoreline Retreat by Beach", "Metres lost, 2022 to 2024")
retreatChart = BarChart(beaches, [s22, s23, s24], "grouped", "Beach", "Retreat (m)")
beaches = ["Harlow Point", "Sandy Cove", "Gull Bay", "Pine Strand", "Marlow Sands"]
s22 = Series("2022", [2.1, 1.2, 1.5, 0.6, 1.0])
s23 = Series("2023", [2.5, 1.4, 1.8, 0.7, 1.3])
s24 = Series("2024", [3.4, 2.0, 2.3, 0.8, 1.2])
tableCard = Card([tableHeader, measureTable])
tableHeader = CardHeader("Measurement Details", "Survey data and risk rating")
measureTable = Table([Col("Beach", beaches), Col("Retreat 2024 (m)", r24, "number"), Col("5-yr Avg (m)", avg5, "number"), Col("Risk", risk)])
r24 = [3.4, 2.0, 2.3, 0.8, 1.2]
avg5 = [2.3, 1.5, 1.7, 0.7, 1.1]
risk = [Tag("High", null, "sm", "danger"), Tag("Moderate", null, "sm", "warning"), Tag("Moderate", null, "sm", "warning"), Tag("Low", null, "sm", "success"), Tag("Low", null, "sm", "success")]
imgHeader = InlineHeader("Before and After", "Harlow Point cliff edge, 2019 vs 2024")
imgNote = Callout("info", "Image Comparison", "Paired photos were not available in this report. Upload site photos from the same vantage point to add the comparison here.")
scheduleHeader = InlineHeader("Monitoring Schedule", "Planned survey activity")
scheduleTable = Table([Col("Beach", beaches), Col("Method", methods), Col("Frequency", freq), Col("Next Survey", nextDates)])
methods = ["Drone LiDAR", "GPS transect", "Drone LiDAR", "GPS transect", "Photo monitoring"]
freq = ["Monthly", "Quarterly", "Monthly", "Biannual", "Quarterly"]
nextDates = ["2025-01-10", "2025-02-05", "2025-01-17", "2025-04-20", "2025-02-12"]
nextSteps = Buttons([Button("Request detailed analysis", @ToAssistant("Provide a detailed analysis of Harlow Point erosion"), "primary"), Button("Suggest mitigation options", @ToAssistant("Suggest erosion mitigation options"), "secondary")])