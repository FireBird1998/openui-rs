root = Stack([header, missedCard, addressCard, requestForm])
header = InlineHeader("Delivery Notice", "We noticed some recent newspaper deliveries were missed")
missedCard = Card([missedHeader, missedTable])
missedHeader = CardHeader("Missed Deliveries", "Dates we did not deliver your paper")
missedTable = Table([Col("Date", missedDates), Col("Edition", editions), Col("Status", statuses, "string")])
missedDates = ["Mon, Mar 3", "Wed, Mar 5", "Sat, Mar 8"]
editions = ["Daily", "Daily", "Sunday"]
statuses = ["Open", "Open", "Open"]
addressCard = Card([addrHeader, addrInfo])
addrHeader = InlineHeader("Current Delivery Address", "Confirm this is still correct")
addrInfo = EntityList([addrName, addrLine, addrCity, addrAccount], "default")
addrName = {left: "Name", right: "Jordan Patel"}
addrLine = {left: "Street", right: "418 Maple Avenue, Apt 3B"}
addrCity = {left: "City", right: "Springfield, IL 62704"}
addrAccount = {left: "Account", right: "SUB-204817"}
requestForm = Form("replacement", formButtons, [dateField, deliveryField, notesField])
dateField = FormControl("Missed Date", dateInput, "Select the date you did not receive your paper")
dateInput = DatePicker("missedDate", "single", {required: true})
deliveryField = FormControl("Replacement Preference", deliveryChoice)
deliveryChoice = RadioGroup("replacementType", [replaceOpt, creditOpt], "replace", {required: true})
replaceOpt = RadioItem("Send a replacement copy", "Delivered within 24 hours", "replace")
creditOpt = RadioItem("Credit my account", "Applied to your next billing cycle", "credit")
notesField = FormControl("Additional Notes", notesInput)
notesInput = TextArea("notes", "Anything we should know?", 3)
formButtons = Buttons([Button("Request Replacement", @ToAssistant("Request a replacement copy for the missed deliveries"), "primary"), Button("Cancel", @ToAssistant("Cancel replacement request"), "secondary")])