root = Stack([title, intro, compareHeader, tbl, imgHeader, imgNote, glossHeader, gloss, callout])
title = TextContent("Two Windows on the Universe: Hubble vs. James Webb", "large-heavy")
intro = TextContent("Two space telescopes, two landmark discoveries. The Hubble Deep Field (1995) showed that the 'empty' sky holds thousands of galaxies. Webb's First Deep Field (2022) looked even farther back, revealing galaxies shaped when the universe was very young.")
compareHeader = InlineHeader("Observation Facts", "Side-by-side comparison of the two discoveries")
tbl = Table([Col("Feature", features), Col("Hubble Deep Field", hubble), Col("Webb's First Deep Field", webb)])
features = ["Year", "Telescope launched", "Main light observed", "Mirror size", "Patch of sky", "Galaxies seen", "Furthest look-back", "Key finding"]
hubble = ["1995", "1990", "Visible and some ultraviolet", "2.4 m", "About a grain of sand held at arm's length", "About 3,000", "About 12 billion years", "The dark sky patch is crowded with galaxies"]
webb = ["2022", "2021", "Infrared", "6.5 m", "About a grain of sand held at arm's length", "Thousands, in far greater detail", "More than 13 billion years", "Very early galaxies, already surprisingly mature"]
imgHeader = InlineHeader("Images", "Look up the official pictures at the links below")
imgNote = Buttons([b1, b2])
b1 = Button("View Hubble Deep Field", @OpenUrl("https://esahubble.org/images/heic0611b/"), "secondary")
b2 = Button("View Webb's First Deep Field", @OpenUrl("https://webbtelescope.org/contents/media/images/2022/035/01G7DDBW5NHZNJ9DZ4E4XQ3BPX"), "secondary")
glossHeader = InlineHeader("Plain-Language Glossary", "Key terms explained simply")
gloss = Accordion([g1, g2, g3, g4, g5])
g1 = AccordionItem("infrared", "Infrared light", [TextContent("Light our eyes can't see, felt by us as heat. It passes through dust clouds and is how Webb sees the earliest galaxies.")])
g2 = AccordionItem("redshift", "Redshift", [TextContent("As the universe expands, light from far-away galaxies is stretched to longer, redder wavelengths. More redshift means a more distant, older galaxy.")])
g3 = AccordionItem("lookback", "Look-back time", [TextContent("Light takes time to travel. Seeing a galaxy 13 billion light-years away means seeing it as it was 13 billion years ago.")])
g4 = AccordionItem("deepfield", "Deep field", [TextContent("A long exposure of a tiny, seemingly empty patch of sky, collecting faint light over many hours to reveal distant objects.")])
g5 = AccordionItem("gravlens", "Gravitational lensing", [TextContent("Massive objects bend space, acting like a magnifying glass that stretches and brightens light from galaxies behind them.")])
callout = Callout("info", "The story in one line", "Hubble showed us the universe was full of galaxies; Webb is showing us how the first of them began.")