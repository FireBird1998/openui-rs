root = Stack([card])
card = Card([header, verdictTag, claimHeader, claimText, Separator(), verdictCallout, sourcesHeader, sourcesList, actions])
header = CardHeader("Fact Check", "Viral claim review · Rating: Mostly False")
verdictTag = Tag("Mostly False", warnIcon, "lg", "warning")
warnIcon = Icon("triangle-alert", "alerts")
claimHeader = InlineHeader("The Claim", "As shared widely on social media")
claimText = TextContent("\"Drinking hot lemon water every morning cures and prevents most types of cancer, according to doctors at a leading research hospital.\"", "large")
verdictCallout = Callout("warning", "Verdict: Mostly False", "There is no clinical evidence that lemon water cures or prevents cancer. Lemons contain vitamin C and antioxidants, which are part of a healthy diet, but no study shows they treat cancer. The hospital named in the posts has publicly denied making the claim.")
sourcesHeader = InlineHeader("Sources", "Three references reviewed")
sourcesList = ListBlock([s1, s2, s3], "number")
s1 = ListItem("National Cancer Institute: Cancer Prevention Overview", "Evidence-based review of established risk factors and prevention", null, "Open", @OpenUrl("https://www.cancer.gov"))
s2 = ListItem("World Health Organization: Cancer Fact Sheet", "Global guidance on prevention and treatment", null, "Open", @OpenUrl("https://www.who.int/news-room/fact-sheets/detail/cancer"))
s3 = ListItem("Cochrane Library: Dietary Interventions and Cancer", "Systematic reviews finding no cure from single foods", null, "Open", @OpenUrl("https://www.cochranelibrary.com"))
actions = Buttons([Button("Explain the rating", @ToAssistant("Explain why this claim was rated mostly false"), "primary"), Button("Check another claim", @ToAssistant("I want to fact-check another claim"), "secondary")])