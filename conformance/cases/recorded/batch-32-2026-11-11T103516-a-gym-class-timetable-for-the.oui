root = Stack([header, timetable])
header = TextContent("Weekly Gym Class Timetable", "large-heavy")
timetable = Table([colDay, colTime, colClass, colInstructor, colType])
colDay = Col("Day", ["Monday", "Monday", "Tuesday", "Wednesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"])
colTime = Col("Time", ["06:30", "18:00", "07:00", "12:15", "19:00", "06:30", "17:30", "09:00", "10:00"])
colClass = Col("Class", ["Spin", "Yoga", "HIIT", "Pilates", "Boxing", "Spin", "Zumba", "Strength", "Stretch & Recover"])
colInstructor = Col("Instructor", ["Maya", "Jordan", "Chris", "Priya", "Alex", "Maya", "Sofia", "Chris", "Priya"])
colType = Col("Type", [tagSpin, tagYoga, tagHiit, tagPilates, tagBoxing, tagSpin2, tagZumba, tagStrength, tagYoga2])
tagSpin = Tag("Cardio", null, "sm", "info")
tagYoga = Tag("Flexibility", null, "sm", "success")
tagHiit = Tag("HIIT", null, "sm", "danger")
tagPilates = Tag("Core", null, "sm", "warning")
tagBoxing = Tag("Combat", null, "sm", "danger")
tagSpin2 = Tag("Cardio", null, "sm", "info")
tagZumba = Tag("Dance", null, "sm", "neutral")
tagStrength = Tag("Strength", null, "sm", "warning")
tagYoga2 = Tag("Recovery", null, "sm", "success")