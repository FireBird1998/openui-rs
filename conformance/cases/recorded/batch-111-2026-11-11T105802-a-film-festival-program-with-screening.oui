root = Stack([title, intro, summary, scheduleCard, soldOutCard, chartCard])
title = TextContent("Riverside Film Festival — Program", "large-heavy")
intro = Callout("info", "Friday Schedule", "Screenings across four rooms. Sold-out sessions are tagged; join the waitlist at the box office.")
summary = SnippetCardBlock([k1, k2, k3])
k1 = SnippetCardItem("screenings", k1l, k1r)
k1l = IconText(k1i, "neutral", "m", "Screenings", "Today", false, "horizontal")
k1i = Icon("film", "media")
k1r = BoldText("number", "8")
k2 = SnippetCardItem("soldout", k2l, k2r)
k2l = IconText(k2i, "neutral", "m", "Sold Out", "Sessions", false, "horizontal")
k2i = Icon("ticket-x", "tickets")
k2r = BoldText("number", "3")
k3 = SnippetCardItem("rooms", k3l, k3r)
k3l = IconText(k3i, "neutral", "m", "Rooms", "In use", false, "horizontal")
k3i = Icon("door-open", "building")
k3r = BoldText("number", "4")
scheduleCard = Card([schedHeader, schedTable])
schedHeader = CardHeader("Screening Schedule", "Rooms, start times and run lengths")
schedTable = Table([Col("Film", films), Col("Room", rooms), Col("Start", starts), Col("Length (min)", lengths, "number"), Col("Status", statuses)])
films = ["The Last Lighthouse", "Paper Cities", "Echoes of Salt", "Midnight Orchard", "Quiet Machines", "Neon Harvest", "A Summer in Lisbon", "The Cartographer"]
rooms = ["Room A", "Room B", "Room C", "Room D", "Room A", "Room B", "Room C", "Room D"]
starts = ["10:00", "10:30", "11:15", "12:00", "13:30", "14:45", "16:00", "18:30"]
lengths = [112, 94, 128, 87, 105, 119, 98, 136]
statuses = [t1, t2, t3, t4, t5, t6, t7, t8]
t1 = Tag("Sold Out", null, "sm", "danger")
t2 = Tag("Available", null, "sm", "success")
t3 = Tag("Available", null, "sm", "success")
t4 = Tag("Sold Out", null, "sm", "danger")
t5 = Tag("Few Seats", null, "sm", "warning")
t6 = Tag("Available", null, "sm", "success")
t7 = Tag("Sold Out", null, "sm", "danger")
t8 = Tag("Few Seats", null, "sm", "warning")
soldOutCard = Card([soldHeader, soldTags, soldList])
soldHeader = CardHeader("Sold-Out Sessions", "No tickets remaining")
soldTags = TagBlock(["The Last Lighthouse · 10:00", "Midnight Orchard · 12:00", "A Summer in Lisbon · 16:00"], "md")
soldList = EntityList([r1, r2, r3], "default")
r1 = { left: "Room A — The Last Lighthouse", right: "10:00 · 112 min" }
r2 = { left: "Room D — Midnight Orchard", right: "12:00 · 87 min" }
r3 = { left: "Room C — A Summer in Lisbon", right: "16:00 · 98 min" }
chartCard = Card([chartHeader, lenChart])
chartHeader = CardHeader("Film Lengths", "Running time in minutes")
lenChart = HorizontalBarChart(films, [Series("Minutes", lengths)])