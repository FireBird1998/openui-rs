root = Stack([header, plantCards, careTabs])
header = InlineHeader("Indoor Plant Care Guide", "Light, watering, and seasonal notes for three easy houseplants")
plantCards = CompositeCardBlock([pothos, snake, peace])
pothos = CompositeCardItem("pothos", pothosHeader, [pothosBody], pothosFooter)
pothosHeader = IconText(pothosIcon, "success", "m", "Pothos", "Epipremnum aureum", true, "horizontal")
pothosIcon = Icon("leaf", "nature")
pothosBody = EntityList([pothosL1, pothosL2, pothosL3], "small")
pothosL1 = {left: "Light", right: "Bright indirect"}
pothosL2 = {left: "Water every", right: "7-10 days"}
pothosL3 = {left: "Humidity", right: "Average"}
pothosFooter = {price: BoldText("text", "Easy care"), button: pothosBtn}
pothosBtn = Button("Care tips", @ToAssistant("Give me more care tips for pothos"), "secondary")
snake = CompositeCardItem("snake-plant", snakeHeader, [snakeBody], snakeFooter)
snakeHeader = IconText(snakeIcon, "info", "m", "Snake Plant", "Sansevieria trifasciata", true, "horizontal")
snakeIcon = Icon("sprout", "nature")
snakeBody = EntityList([snakeL1, snakeL2, snakeL3], "small")
snakeL1 = {left: "Light", right: "Low to bright"}
snakeL2 = {left: "Water every", right: "2-6 weeks"}
snakeL3 = {left: "Humidity", right: "Low"}
snakeFooter = {price: BoldText("text", "Very low maintenance"), button: snakeBtn}
snakeBtn = Button("Care tips", @ToAssistant("Give me more care tips for snake plant"), "secondary")
peace = CompositeCardItem("peace-lily", peaceHeader, [peaceBody], peaceFooter)
peaceHeader = IconText(peaceIcon, "warning", "m", "Peace Lily", "Spathiphyllum", true, "horizontal")
peaceIcon = Icon("flower-2", "nature")
peaceBody = EntityList([peaceL1, peaceL2, peaceL3], "small")
peaceL1 = {left: "Light", right: "Medium indirect"}
peaceL2 = {left: "Water every", right: "5-7 days"}
peaceL3 = {left: "Humidity", right: "High"}
peaceFooter = {price: BoldText("text", "Droops when thirsty"), button: peaceBtn}
peaceBtn = Button("Care tips", @ToAssistant("Give me more care tips for peace lily"), "secondary")
careTabs = Tabs([tabSeasons, tabLight])
tabSeasons = TabItem("seasons", "Seasonal Care", [seasonNote, seasonCallout])
seasonNote = MarkDownRenderer("**Spring:** Resume regular watering and fertilize monthly as new growth appears.\n\n**Summer:** Water more often for pothos and peace lily; keep snake plant on the drier side.\n\n**Autumn:** Reduce watering and stop fertilizing as growth slows.\n\n**Winter:** Water sparingly, keep plants away from cold drafts and heating vents.")
seasonCallout = Callout("info", "Tip", "Check soil moisture with a finger two inches deep before watering any plant.")
tabLight = TabItem("light", "Light Guide", [lightNote])
lightNote = MarkDownRenderer("- **Pothos:** Bright indirect light. Leggy growth or pale leaves mean it needs more light.\n- **Snake plant:** Tolerates low light. Bright indirect light gives faster growth.\n- **Peace lily:** Medium indirect light. Direct sun scorches the leaves.")