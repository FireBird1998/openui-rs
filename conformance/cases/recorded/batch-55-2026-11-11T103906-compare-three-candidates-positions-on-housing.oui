root = Stack([title, note, tbl, quotesHeader, quotes, sourcesHeader, sources])
title = TextContent("Candidate Comparison: Housing, Transport & Schools", "large-heavy")
note = Callout("info", "Illustrative data", "These candidates and quotes are fictional examples. Replace with verified statements and links before publishing.")
tbl = Table([Col("Candidate", names), Col("Housing", housing), Col("Transport", transport), Col("Schools", schools)])
names = ["Maria Alvarez", "David Chen", "Priya Nair"]
housing = ["Build 5,000 affordable units; relax zoning near transit", "Tax incentives for private developers; first-time buyer grants", "Rent stabilization and expanded public housing"]
transport = ["Expand bus rapid transit and protected bike lanes", "Road repair first; modest rail extension", "Free fares for students and seniors; electrify bus fleet"]
schools = ["Raise teacher pay 8%; universal pre-K", "School choice expansion; more charter capacity", "Smaller class sizes; fund after-school programs"]
quotesHeader = InlineHeader("In their own words", "Short quotes from each candidate")
quotes = Stack([q1, q2, q3])
q1 = Card([TextContent("**Maria Alvarez**", "small-heavy"), TextContent("\"Housing near transit is the fastest way to cut costs for working families.\"")], "sunk")
q2 = Card([TextContent("**David Chen**", "small-heavy"), TextContent("\"Let builders build, and let families keep more of what they earn.\"")], "sunk")
q3 = Card([TextContent("**Priya Nair**", "small-heavy"), TextContent("\"Every child deserves a well-funded classroom and an affordable place to call home.\"")], "sunk")
sourcesHeader = InlineHeader("Sources", "Candidate platform pages")
sources = Buttons([b1, b2, b3])
b1 = Button("Alvarez platform", @OpenUrl("https://example.com/alvarez/platform"), "secondary")
b2 = Button("Chen platform", @OpenUrl("https://example.com/chen/platform"), "secondary")
b3 = Button("Nair platform", @OpenUrl("https://example.com/nair/platform"), "secondary")