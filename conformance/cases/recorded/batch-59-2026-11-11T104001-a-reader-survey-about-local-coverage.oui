root = Stack([title, intro, form])
title = TextContent("Local Coverage Reader Survey", "large-heavy")
intro = TextContent("Help us shape how we cover your community. It takes about two minutes.")
form = Form("survey", btns, [topicsField, editionField, suggestionField])
topicsField = FormControl("Which topics matter most to you?", topics, "Select all that apply")
topics = CheckBoxGroup("topics", [t1, t2, t3, t4, t5, t6], { required: true })
t1 = CheckBoxItem("Local government", "City council, budgets and elections", "government")
t2 = CheckBoxItem("Schools & education", "Districts, colleges and youth programs", "schools")
t3 = CheckBoxItem("Crime & safety", "Police, fire and emergency news", "safety")
t4 = CheckBoxItem("Business & development", "Openings, closings and construction", "business")
t5 = CheckBoxItem("Arts & events", "Festivals, concerts and community calendar", "arts")
t6 = CheckBoxItem("High school sports", "Scores, schedules and profiles", "sports")
editionField = FormControl("Preferred edition", edition, "Choose how you like to read")
edition = RadioGroup("edition", [e1, e2, e3, e4], "digital", { required: true })
e1 = RadioItem("Digital", "Website and mobile app", "digital")
e2 = RadioItem("Print", "Daily newspaper delivered to your door", "print")
e3 = RadioItem("Email newsletter", "Morning briefing in your inbox", "newsletter")
e4 = RadioItem("Weekend print only", "Saturday and Sunday editions", "weekend")
suggestionField = FormControl("Suggestions", suggestion, "Tell us what we're missing in local coverage")
suggestion = TextArea("suggestion", "What stories or neighborhoods would you like us to cover more?", 5, { maxLength: 1000 })
btns = Buttons([submitBtn, resetBtn])
submitBtn = Button("Submit Survey", @ToAssistant("Submit local coverage survey"), "primary")
resetBtn = Button("Clear", @ToAssistant("Clear survey"), "secondary")