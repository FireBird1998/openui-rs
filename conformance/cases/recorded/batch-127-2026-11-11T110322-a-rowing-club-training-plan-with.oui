root = Stack([title, kpis, chartCard, planCard, crewCard])
title = TextContent("Riverside Rowing Club – Weekly Training Plan", "large-heavy")
kpis = OverviewCardBlock([k1, k2, k3])
k1 = OverviewCardItem("dist", k1top, k1m)
k1top = IconText(k1i, "info", "m", "Weekly Distance")
k1i = Icon("route", "sports")
k1m = MetricIndicatorInline("86 km", "Planned this week", { direction: "up", value: 6 })
k2 = OverviewCardItem("sessions", k2top, k2m)
k2top = IconText(k2i, "success", "m", "Sessions")
k2i = Icon("calendar-check", "time")
k2m = MetricIndicatorInline("7", "Water and land")
k3 = OverviewCardItem("crews", k3top, k3m)
k3top = IconText(k3i, "warning", "m", "Active Crews")
k3i = Icon("users", "people")
k3m = MetricIndicatorInline("4", "Across all sessions")
chartCard = Card([chartHeader, chart])
chartHeader = CardHeader("Distance by Day", "Kilometres planned per session day")
chart = BarChart(days, [Series("Distance (km)", dists)], "grouped", "Day", "km")
days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
dists = [12, 10, 14, 8, 12, 20, 10]
planCard = Card([planHeader, planTable])
planHeader = CardHeader("Session Plan", "Intensity, distance and crew per session")
planTable = Table([Col("Day", pDays), Col("Session", pSessions), Col("Intensity", pInt), Col("Distance (km)", pDist, "number"), Col("Crew", pCrew)])
pDays = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
pSessions = ["Steady state UT2", "Technique drills", "Intervals 6x1000m", "Recovery paddle", "Race pace pieces", "Long distance row", "Ergo and core"]
pInt = [t1, t2, t3, t4, t5, t6, t7]
t1 = Tag("Moderate", null, "sm", "info")
t2 = Tag("Low", null, "sm", "success")
t3 = Tag("High", null, "sm", "danger")
t4 = Tag("Low", null, "sm", "success")
t5 = Tag("High", null, "sm", "danger")
t6 = Tag("Moderate", null, "sm", "warning")
t7 = Tag("Moderate", null, "sm", "info")
pDist = [12, 10, 14, 8, 12, 20, 10]
pCrew = ["Eight A", "Quad 1", "Eight A", "Pair crews", "Eight B", "Eight A + B", "All squads"]
crewCard = Card([crewHeader, crewList])
crewHeader = CardHeader("Crew Assignments", "Boats and coaches")
crewList = EntityList([r1, r2, r3, r4], "default")
r1 = { left: "Eight A – Coach Morgan", right: "Cox: Priya S." }
r2 = { left: "Eight B – Coach Alvarez", right: "Cox: Tom H." }
r3 = { left: "Quad 1 – Coach Lindqvist", right: "Stroke: Hana K." }
r4 = { left: "Pair crews – Coach Morgan", right: "4 rowers" }