root = Stack([header, kpis, statusCallout, tabs, checkoutHeader, checkoutForm])
header = CardHeader("Lab Equipment Checkout", "Track instruments, calibration status, borrowers and return deadlines")
kpis = SnippetCardBlock([k1, k2, k3])
k1 = SnippetCardItem("total", k1l, k1r)
k1l = IconText(k1i, "neutral", "m", "Total Instruments", "In inventory", false, "horizontal")
k1i = Icon("microscope", "science")
k1r = BoldText("number", "8")
k2 = SnippetCardItem("out", k2l, k2r)
k2l = IconText(k2i, "neutral", "m", "Checked Out", "Currently borrowed", false, "horizontal")
k2i = Icon("arrow-right-left", "tools")
k2r = BoldText("number", "5")
k3 = SnippetCardItem("overdue", k3l, k3r)
k3l = IconText(k3i, "danger", "m", "Overdue", "Past deadline", false, "horizontal")
k3i = Icon("alarm-clock", "time")
k3r = BoldText("number", "1")
statusCallout = Callout("warning", "Overdue item", "LAB-005 (Spectrophotometer) was due on 2025-05-12 and is still checked out by Priya Nair.")
tabs = Tabs([allTab, availTab, outTab])
allTab = TabItem("all", "All Equipment", [allTable])
availTab = TabItem("avail", "Available", [availTable])
outTab = TabItem("out", "Checked Out", [outTable])
allTable = Table([Col("Instrument ID", ids), Col("Name", names), Col("Last Calibrated", cal), Col("Borrower", borrowers), Col("Return Deadline", deadlines), Col("Status", statusTags)])
ids = ["LAB-001", "LAB-002", "LAB-003", "LAB-004", "LAB-005", "LAB-006", "LAB-007", "LAB-008"]
names = ["Digital Oscilloscope", "Analytical Balance", "Centrifuge", "pH Meter", "Spectrophotometer", "Function Generator", "Compound Microscope", "Multimeter"]
cal = ["2025-03-10", "2025-02-18", "2025-01-27", "2025-04-02", "2024-11-30", "2025-03-22", "2025-02-05", "2025-04-15"]
borrowers = ["Maya Chen", "-", "Liam O'Brien", "-", "Priya Nair", "Daniel Ortiz", "-", "Sofia Rossi"]
deadlines = ["2025-05-20", "-", "2025-05-22", "-", "2025-05-12", "2025-05-24", "-", "2025-05-21"]
statusTags = [Tag("Checked Out", null, "sm", "info"), Tag("Available", null, "sm", "success"), Tag("Checked Out", null, "sm", "info"), Tag("Available", null, "sm", "success"), Tag("Overdue", null, "sm", "danger"), Tag("Checked Out", null, "sm", "info"), Tag("Available", null, "sm", "success"), Tag("Checked Out", null, "sm", "info")]
availTable = Table([Col("Instrument ID", ["LAB-002", "LAB-004", "LAB-007"]), Col("Name", ["Analytical Balance", "pH Meter", "Compound Microscope"]), Col("Last Calibrated", ["2025-02-18", "2025-04-02", "2025-02-05"]), Col("Action", [reserve1, reserve2, reserve3])])
reserve1 = Button("Reserve", @ToAssistant("Reserve LAB-002 Analytical Balance"), "secondary", "normal", "small")
reserve2 = Button("Reserve", @ToAssistant("Reserve LAB-004 pH Meter"), "secondary", "normal", "small")
reserve3 = Button("Reserve", @ToAssistant("Reserve LAB-007 Compound Microscope"), "secondary", "normal", "small")
outTable = Table([Col("Instrument ID", ["LAB-001", "LAB-003", "LAB-005", "LAB-006", "LAB-008"]), Col("Borrower", ["Maya Chen", "Liam O'Brien", "Priya Nair", "Daniel Ortiz", "Sofia Rossi"]), Col("Return Deadline", ["2025-05-20", "2025-05-22", "2025-05-12", "2025-05-24", "2025-05-21"])])
checkoutHeader = InlineHeader("Check Out Equipment", "Fill in the form to borrow an instrument")
checkoutForm = Form("checkout", checkoutBtns, [fcName, fcId, fcDate])
fcName = FormControl("Student Name", Input("student", "Full name", "text", { required: true, minLength: 2 }))
fcId = FormControl("Instrument", Select("instrument", instrumentOpts, "Select instrument...", { required: true }))
fcDate = FormControl("Return Deadline", DatePicker("deadline", "single", { required: true }))
instrumentOpts = [SelectItem("LAB-002", "LAB-002 – Analytical Balance"), SelectItem("LAB-004", "LAB-004 – pH Meter"), SelectItem("LAB-007", "LAB-007 – Compound Microscope")]
checkoutBtns = Buttons([Button("Confirm Checkout", @ToAssistant("Submit equipment checkout"), "primary"), Button("Clear", @ToAssistant("Clear checkout form"), "secondary")])