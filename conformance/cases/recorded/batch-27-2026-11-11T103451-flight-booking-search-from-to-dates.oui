root = Stack([title, searchCard, resultsHeader, results])
title = TextContent("Flight Search", "large-heavy")
searchCard = Card([searchForm])
searchForm = Form("flightSearch", searchBtns, [fromField, toField, dateField, paxField])
fromField = FormControl("From", Input("from", "City or airport", "text", { required: true }))
toField = FormControl("To", Input("to", "City or airport", "text", { required: true }))
dateField = FormControl("Travel Dates", DatePicker("dates", "range", { required: true }))
paxField = FormControl("Passengers", Select("passengers", paxOpts, "Select passengers", { required: true }))
paxOpts = [SelectItem("1", "1 Passenger"), SelectItem("2", "2 Passengers"), SelectItem("3", "3 Passengers"), SelectItem("4", "4 Passengers")]
searchBtns = Buttons([Button("Search Flights", @ToAssistant("Search flights with the entered details"), "primary")])
resultsHeader = InlineHeader("Available Flights", "New York (JFK) to London (LHR) · 2 passengers")
results = CompositeCardBlock([f1, f2, f3])
f1 = CompositeCardItem("f1", f1h, [f1b], f1f)
f1h = IconText(Icon("plane", "travel"), "info", "m", "SkyJet 214", "Nonstop · 7h 05m", true, "horizontal")
f1b = MetricIndicatorInline("08:15 → 20:20", "JFK → LHR")
f1f = { price: BoldText("text", "$642"), button: Button("Select", @ToAssistant("Select flight SkyJet 214"), "primary") }
f2 = CompositeCardItem("f2", f2h, [f2b], f2f)
f2h = IconText(Icon("plane", "travel"), "info", "m", "AeroBlue 88", "1 stop · 9h 40m", true, "horizontal")
f2b = MetricIndicatorInline("11:30 → 00:10", "JFK → LHR")
f2f = { price: BoldText("text", "$519"), button: Button("Select", @ToAssistant("Select flight AeroBlue 88"), "primary") }
f3 = CompositeCardItem("f3", f3h, [f3b], f3f)
f3h = IconText(Icon("plane", "travel"), "info", "m", "Atlantic Air 502", "Nonstop · 6h 55m", true, "horizontal")
f3b = MetricIndicatorInline("19:45 → 07:40", "JFK → LHR")
f3f = { price: BoldText("text", "$705"), button: Button("Select", @ToAssistant("Select flight Atlantic Air 502"), "primary") }