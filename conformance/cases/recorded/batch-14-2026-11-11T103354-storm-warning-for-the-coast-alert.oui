root = Stack([alertHeader, alertCallout, areasHeader, areasTable, timelineHeader, timeline, safetyHeader, safetyTips])
alertHeader = InlineHeader("Coastal Storm Warning", "Current alert level and status")
alertCallout = Callout("error", "Alert Level: Red (Severe)", "Severe coastal storm expected. Wind gusts up to 110 km/h, storm surge of 2 to 3 meters, and heavy rainfall. Coastal flooding is likely at high tide.")
areasHeader = InlineHeader("Affected Areas", "Coastal zones under warning")
areasTable = Table([Col("Area", areaNames), Col("Warning", areaLevels, "string"), Col("Expected Surge (m)", areaSurge, "number")])
areaNames = ["Northern Harbor", "Riverside District", "Eastern Beaches", "Old Town Shoreline", "Southern Cliffs"]
areaLevels = ["Red", "Red", "Orange", "Orange", "Yellow"]
areaSurge = [3.0, 2.5, 2.0, 1.8, 1.0]
timelineHeader = InlineHeader("Timeline", "What to expect and when")
timeline = Steps([t1, t2, t3, t4])
t1 = StepsItem("Now to 6 hours", "Gale-force winds build and coastal roads begin to close. Secure loose outdoor items.")
t2 = StepsItem("6 to 12 hours", "Storm reaches peak intensity. Heavy rain and wind gusts up to 110 km/h. Avoid all coastal areas.")
t3 = StepsItem("12 to 18 hours", "Storm surge coincides with high tide, causing the most serious flooding. Stay indoors on higher floors.")
t4 = StepsItem("18 to 30 hours", "Winds ease and surge recedes. Wait for official all-clear before inspecting damage or returning to coastal areas.")
safetyHeader = InlineHeader("Safety Tips", "Actions to protect yourself and your property")
safetyTips = TagBlock(["Stay indoors away from windows", "Move vehicles to higher ground", "Keep phones charged and emergency kit ready", "Do not walk or drive through floodwater", "Follow evacuation orders immediately", "Monitor official updates on local radio"])