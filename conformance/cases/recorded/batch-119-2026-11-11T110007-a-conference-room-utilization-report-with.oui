root = Stack([title, kpis, roomHeader, roomChart, peakHeader, peakChart, tbl, recHeader, recs, followBtn])
title = TextContent("Conference Room Utilization Report", "large-heavy")
kpis = OverviewCardBlock([k1, k2, k3])
k1 = OverviewCardItem("total", k1top, k1m)
k1top = IconText(Icon("clock", "time"), "neutral", "m", "Total Booked Hours", "Last 4 weeks")
k1m = MetricIndicatorInline("1,284 hrs", "vs prior period", { direction: "up", value: 6 })
k2 = OverviewCardItem("avg", k2top, k2m)
k2top = IconText(Icon("gauge", "charts"), "neutral", "m", "Avg Utilization", "Business hours")
k2m = MetricIndicatorInline("58%", "across 8 rooms", { direction: "up", value: 3 })
k3 = OverviewCardItem("under", k3top, k3m)
k3top = IconText(Icon("triangle-alert", "alerts"), "warning", "m", "Underused Rooms", "Below 35%")
k3m = MetricIndicatorInline("3 rooms", "needs review", { direction: "down", value: 1 })
roomHeader = InlineHeader("Booked Hours by Room", "Last 4 weeks")
roomChart = HorizontalBarChart(rooms, [Series("Booked hours", hours)])
rooms = ["Atlas", "Boardroom", "Cedar", "Delta", "Everest", "Focus 1", "Focus 2", "Garden"]
hours = [248, 231, 205, 176, 142, 118, 96, 68]
peakHeader = InlineHeader("Peak Time Slots", "Average utilization % by hour, weekdays")
peakChart = BarChart(slots, [Series("Utilization %", util)], "grouped", "Time of day", "Utilization %")
slots = ["8am", "9am", "10am", "11am", "12pm", "1pm", "2pm", "3pm", "4pm", "5pm"]
util = [32, 74, 91, 88, 41, 52, 79, 84, 56, 24]
tbl = Table([Col("Room", rooms), Col("Capacity", caps, "number"), Col("Booked hrs", hours, "number"), Col("Utilization", utilPct), Col("Status", statuses)])
caps = [12, 20, 8, 10, 14, 4, 4, 6]
utilPct = ["81%", "76%", "68%", "58%", "47%", "39%", "32%", "23%"]
statuses = ["Busy", "Busy", "Healthy", "Healthy", "Healthy", "Low", "Underused", "Underused"]
recHeader = InlineHeader("Recommendations", "Underused rooms")
recs = Accordion([r1, r2, r3])
r1 = AccordionItem("garden", "Garden (23%)", [Callout("warning", "Convert to flex space", "Garden is booked mainly for ad-hoc chats. Convert to a drop-in huddle space or release it for hot-desking.")])
r2 = AccordionItem("focus2", "Focus 2 (32%)", [Callout("info", "Merge or repurpose", "Demand for 4-person rooms is concentrated at 10-11am. Keep Focus 1 bookable and convert Focus 2 to a phone-booth area.")])
r3 = AccordionItem("focus1", "Focus 1 (39%)", [Callout("success", "Promote off-peak use", "Encourage bookings at 8am, 12pm and after 4pm through calendar defaults and room suggestions.")])
followBtn = Buttons([Button("Draft room consolidation plan", @ToAssistant("Draft a room consolidation plan based on this report"), "primary")])