root = Stack([header, kpis, masteryCard, hardHeader, hardTable, nextCard])
header = CardHeader("Spanish Review Summary", "Session of 40 flashcards · 18 minutes")
kpis = SnippetCardBlock([k1, k2, k3, k4])
k1 = SnippetCardItem("mastered", k1l, k1r)
k1l = IconText(k1i, "success", "m", "Words Mastered", "Total", false, "horizontal")
k1i = Icon("circle-check", "education")
k1r = BoldText("number", "286", "+14%", "metric")
k2 = SnippetCardItem("accuracy", k2l, k2r)
k2l = IconText(k2i, "info", "m", "Accuracy", "This session", false, "horizontal")
k2i = Icon("target", "education")
k2r = BoldText("number", "82%", "+5%", "metric")
k3 = SnippetCardItem("streak", k3l, k3r)
k3l = IconText(k3i, "warning", "m", "Study Streak", "Days in a row", false, "horizontal")
k3i = Icon("flame", "education")
k3r = BoldText("number", "12 days")
k4 = SnippetCardItem("difficult", k4l, k4r)
k4l = IconText(k4i, "danger", "m", "Difficult Words", "Needs review", false, "horizontal")
k4i = Icon("triangle-alert", "education")
k4r = BoldText("number", "23", "-4%", "metric")
masteryCard = Card([masteryHeader, masteryChart])
masteryHeader = CardHeader("Weekly Words Mastered", "New words moved to mastered")
masteryChart = BarChart(days, [Series("Mastered", mastered)], "grouped", "Day", "Words", 220)
days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
mastered = [8, 11, 6, 14, 9, 17, 12]
hardHeader = InlineHeader("Difficult Vocabulary", "Words you missed most often")
hardTable = Table([Col("Word", words), Col("Meaning", meanings), Col("Misses", misses, "number"), Col("Type", types)])
words = ["embarazada", "desarrollar", "sobremesa", "tampoco", "madrugada"]
meanings = ["pregnant", "to develop", "after-meal chat", "neither / either", "early morning"]
misses = [7, 6, 5, 4, 4]
types = ["False friend", "Verb", "Noun", "Adverb", "Noun"]
nextCard = Card([nextHeader, nextText, nextTags, nextBtns], "sunk")
nextHeader = CardHeader("Suggested Next Exercise", "Targeted practice · about 10 minutes")
nextText = TextContent("Try a **fill-in-the-blank sentence drill** using your 5 hardest words. Seeing them in context will help with false friends like *embarazada* and the verb *desarrollar*.")
nextTags = TagBlock(["Sentence drill", "10 min", "Intermediate"], "md")
nextBtns = Buttons([Button("Start Exercise", @ToAssistant("Start a fill-in-the-blank drill with my difficult Spanish words"), "primary"), Button("Review Difficult Words", @ToAssistant("Show flashcards for my difficult Spanish words"), "secondary")])