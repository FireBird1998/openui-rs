root = Stack([header, table])
header = InlineHeader("Campsite Comparison", "Nightly rates, amenities, and availability for three sites")
table = Table([colSite, colRate, colAmenities, colTent, colAvail, colAccess])
colSite = Col("Site", ["Pine Hollow", "Lakeside Meadow", "Cedar Ridge", "Hilltop Grove"])
colRate = Col("Nightly Rate", [32, 45, 28, 38], "number")
colAmenities = Col("Amenities", [amenA, amenB, amenC, amenD])
amenA = TagBlock(["Water", "Fire Pit", "Restrooms"])
amenB = TagBlock(["Water", "Electric Hookup", "Showers", "Lake Access"])
amenC = TagBlock(["Water", "Picnic Table"])
colTent = Col("Max Tent Size", ["10x12 ft", "12x16 ft", "9x9 ft", "11x14 ft"])
colAvail = Col("Availability", [availA, availB, availC, availD])
availA = Tag("Available", null, "sm", "success")
availB = Tag("Limited", null, "sm", "warning")
availC = Tag("Sold Out", null, "sm", "danger")
amenD = TagBlock(["Water", "Fire Pit", "Showers"])
availD = Tag("Available", null, "sm", "success")
colAccess = Col("Wheelchair Accessible", [accessA, accessB, accessC, accessD])
accessA = Tag("Accessible", null, "sm", "success")
accessB = Tag("Accessible", null, "sm", "success")
accessC = Tag("Not Accessible", null, "sm", "neutral")
accessD = Tag("Accessible", null, "sm", "success")