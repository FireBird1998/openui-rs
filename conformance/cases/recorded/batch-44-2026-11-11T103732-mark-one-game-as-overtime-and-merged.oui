root = Stack([header, gamesRow])
header = InlineHeader("Tonight's Basketball", "Four games on the board")
gamesRow = Stack([game1, game2, game3, game4], "row", "m", "stretch", "start", true)
game1 = Card([game1Status, game1Teams, game1Score, game1Btns], "card", "column", "s")
game1Status = Tag("Final (OT)", null, "sm", "neutral")
game1Teams = EntityList([{left: "Boston Celtics", right: "112"}, {left: "Miami Heat", right: "104"}], "default")
game1Score = TextContent("Final (OT) · Celtics win by 8", "small")
game2 = Card([game2Status, game2Teams, game2Score], "card", "column", "s")
game2Status = Tag("Q3 8:14", null, "sm", "success")
game2Teams = EntityList([{left: "Los Angeles Lakers", right: "78"}, {left: "Golden State Warriors", right: "81"}], "default")
game2Score = TextContent("In progress · Warriors lead by 3", "small")
game3 = Card([game3Status, game3Teams, game3Score, game3Btns], "card", "column", "s")
game3Status = Tag("Final", null, "sm", "neutral")
game3Teams = EntityList([{left: "New York Knicks", right: "98"}, {left: "Philadelphia 76ers", right: "101"}], "default")
game3Score = TextContent("Final · 76ers win by 3", "small")
game4 = Card([game4Status, game4Teams, game4Score], "card", "column", "s")
game4Status = Tag("Q2 4:30", null, "sm", "success")
game4Teams = EntityList([{left: "Denver Nuggets", right: "52"}, {left: "Dallas Mavericks", right: "49"}], "default")
game4Score = TextContent("In progress · Nuggets lead by 3", "small")
game1Btns = Buttons([game1Btn])
game1Btn = Button("Watch highlights", @ToAssistant("Show highlights for Boston Celtics vs Miami Heat"), "secondary", "normal", "small")
game3Btns = Buttons([game3Btn])
game3Btn = Button("Watch highlights", @ToAssistant("Show highlights for New York Knicks vs Philadelphia 76ers"), "secondary", "normal", "small")