root = Stack([shelfHeader, unreadSection, finishedSection])
shelfHeader = InlineHeader("Saved Stories", "Your reading shelf")
unreadSection = Card([unreadHeader, unreadList])
unreadHeader = CardHeader("Unread", "Stories you have not started yet")
unreadList = Stack([unread2, unread3], "column", "m")
unread2 = Card([u2Stack, u2Actions], "card", "row", "between", "center")
unread3 = Card([u3Stack, u3Actions], "card", "row", "between", "center")
u2Info = IconText(Icon("newspaper", "reading"), "info", "m", "Inside the Grid Failure", "Daniel Ortiz · Investigation · 8 min read", false, "horizontal")
u3Info = IconText(Icon("flask-conical", "reading"), "info", "m", "Why Sleep Research Keeps Changing", "Priya Natarajan · Science · 6 min read", false, "horizontal")
u2Actions = Buttons([Button("Start Reading", @ToAssistant("Open Inside the Grid Failure"), "primary", "normal", "small"), Button("Remove", @ToAssistant("Remove Inside the Grid Failure from my shelf"), "tertiary", "destructive", "small")], "row")
u3Actions = Buttons([Button("Start Reading", @ToAssistant("Open Why Sleep Research Keeps Changing"), "primary", "normal", "small"), Button("Remove", @ToAssistant("Remove Why Sleep Research Keeps Changing from my shelf"), "tertiary", "destructive", "small")], "row")
finishedSection = Card([finishedHeader, finishedList])
finishedHeader = CardHeader("Finished", "Stories you have completed")
finishedList = Stack([done1, done2, done3], "column", "m")
done1 = Card([d1Stack, d1Actions], "card", "row", "between", "center")
done2 = Card([d2Stack, d2Actions], "card", "row", "between", "center")
d1Info = IconText(Icon("circle-check", "status"), "success", "m", "The Last Lighthouse Keeper", "Eleanor Vance · Essay · 15 min read", false, "horizontal")
d2Info = IconText(Icon("circle-check", "status"), "success", "m", "Notes on a Slower City", "Tomas Reyes · Long read · 22 min read", false, "horizontal")
d1Actions = Buttons([Button("Remove", @ToAssistant("Remove The Last Lighthouse Keeper from my shelf"), "tertiary", "destructive", "small")], "row")
d2Actions = Buttons([Button("Remove", @ToAssistant("Remove Notes on a Slower City from my shelf"), "tertiary", "destructive", "small")], "row")
u2Stack = Stack([u2Info, u2Tags], "column", "xs")
u3Stack = Stack([u3Info, u3Tags], "column", "xs")
u2Tags = TagBlock(["Investigation"], "sm")
u3Tags = TagBlock(["Science"], "sm")
done3 = Card([d3Stack, d3Actions], "card", "row", "between", "center")
d1Stack = Stack([d1Info, d1Tags], "column", "xs")
d2Stack = Stack([d2Info, d2Tags], "column", "xs")
d3Stack = Stack([d3Info, d3Tags], "column", "xs")
d1Tags = TagBlock(["Essay"], "sm")
d2Tags = TagBlock(["Long read"], "sm")
d3Tags = TagBlock(["Literary fiction"], "sm")
