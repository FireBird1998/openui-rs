root = Stack([header, catalogTable, reserveNote])
header = InlineHeader("Board Game Lending Library", "Browse titles, check availability, and reserve a copy")
catalogTable = Table([colTitle, colPlayers, colTime, colAvail, colReserve])
colTitle = Col("Game", ["Catan", "Ticket to Ride", "Pandemic", "Azul", "Wingspan", "Codenames"])
colPlayers = Col("Players", ["3-4", "2-5", "2-4", "2-4", "1-5", "2-8"])
colTime = Col("Playing Time", ["60-120 min", "30-60 min", "45 min", "30-45 min", "40-70 min", "15-30 min"])
colAvail = Col("Availability", @Each(["Catan", "Ticket to Ride", "Pandemic", "Azul", "Wingspan", "Codenames"], "g", Tag("Available", null, "sm", "success")))
colReserve = Col("Reserve", @Each(["Catan", "Ticket to Ride", "Pandemic", "Azul", "Wingspan", "Codenames"], "g", Button("Reserve", @ToAssistant("Reserve a copy of " + g), "secondary", "normal", "small")))
reserveNote = Callout("info", "Reservations", "Reserved games can be picked up at the front desk within 48 hours.")