root = Stack([header, kpis, chartCard, tableCard])
header = CardHeader("Disaster Recovery Spending Tracker", "Pledged vs. disbursed funds by project")
kpis = SnippetCardBlock([k1, k2, k3])
k1 = SnippetCardItem("pledged", k1l, k1r)
k1l = IconText(k1i, "neutral", "m", "Total Pledged", "All projects", false, "horizontal")
k1i = Icon("hand-coins", "finance")
k1r = BoldText("number", "$48.6M")
k2 = SnippetCardItem("disbursed", k2l, k2r)
k2l = IconText(k2i, "success", "m", "Total Disbursed", "To date", false, "horizontal")
k2i = Icon("banknote", "finance")
k2r = BoldText("number", "$31.2M", "64% of pledged")
k3 = SnippetCardItem("remaining", k3l, k3r)
k3l = IconText(k3i, "warning", "m", "Remaining", "Awaiting release", false, "horizontal")
k3i = Icon("hourglass", "time")
k3r = BoldText("number", "$17.4M")
chartCard = Card([chartHead, chart])
chartHead = CardHeader("Pledged vs. Disbursed ($M)", "By project")
chart = BarChart(projects, [sPledged, sDisbursed], "grouped", "Project", "USD millions")
projects = ["Road Repair", "Housing Rebuild", "Water System", "School Rebuild", "Hospital Wing", "Power Grid"]
sPledged = Series("Pledged", [9.5, 14.2, 6.8, 5.4, 8.1, 4.6])
sDisbursed = Series("Disbursed", [9.5, 8.7, 5.1, 3.2, 2.9, 1.8])
tableCard = Card([tableHead, tbl])
tableHead = CardHeader("Project Status", "Completion tags and funding progress")
tbl = Table([cProject, cPledged, cDisbursed, cPct, cStatus])
cProject = Col("Project", projects)
cPledged = Col("Pledged ($M)", [9.5, 14.2, 6.8, 5.4, 8.1, 4.6], "number")
cDisbursed = Col("Disbursed ($M)", [9.5, 8.7, 5.1, 3.2, 2.9, 1.8], "number")
cPct = Col("% Disbursed", ["100%", "61%", "75%", "59%", "36%", "39%"], "string")
cStatus = Col("Status", [t1, t2, t3, t4, t5, t6])
t1 = Tag("Complete", null, "sm", "success")
t2 = Tag("In Progress", null, "sm", "info")
t3 = Tag("In Progress", null, "sm", "info")
t4 = Tag("Delayed", null, "sm", "warning")
t5 = Tag("At Risk", null, "sm", "danger")
t6 = Tag("Not Started", null, "sm", "neutral")