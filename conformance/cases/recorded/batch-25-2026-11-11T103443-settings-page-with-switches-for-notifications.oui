root = Stack([title, form])
title = TextContent("Settings", "large-heavy")
form = Form("settings", btns, [notifField, themeField])
notifField = FormControl("Notifications", notifSwitches, "Choose which alerts you receive")
notifSwitches = SwitchGroup("notifications", [swEmail, swPush, swSms, swDigest], "card")
swEmail = SwitchItem("Email notifications", "Receive updates by email", "email", true)
swPush = SwitchItem("Push notifications", "Alerts on your device", "push", true)
swSms = SwitchItem("SMS notifications", "Text messages for urgent alerts", "sms", false)
swDigest = SwitchItem("Weekly digest", "A summary of activity every Monday", "digest", true)
themeField = FormControl("Theme", themeRadio, "Select your preferred appearance")
themeRadio = RadioGroup("theme", [rLight, rDark, rSystem], "system")
rLight = RadioItem("Light", "Always use the light theme", "light")
rDark = RadioItem("Dark", "Always use the dark theme", "dark")
rSystem = RadioItem("System", "Match your device settings", "system")
btns = Buttons([saveBtn])
saveBtn = Button("Save", @ToAssistant("Save settings"), "primary")