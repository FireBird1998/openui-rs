root = Stack([header, summary, tableCard, chartCard, note])
header = CardHeader("Regional Broadband Coverage Report", "Speed tier availability and unserved households by town")
summary = OverviewCardBlock([o1, o2, o3])
o1 = OverviewCardItem("towns", o1top, o1bot)
o1top = IconText(o1icon, "neutral", "m", "Towns Covered", "Regional total", false, "horizontal")
o1icon = Icon("map-pin", "places")
o1bot = MetricIndicatorInline("8", "Towns in report")
o2 = OverviewCardItem("gig", o2top, o2bot)
o2top = IconText(o2icon, "success", "m", "Gigabit Access", "Avg. coverage", false, "horizontal")
o2icon = Icon("zap", "tools")
o2bot = MetricIndicatorInline("52%", "of households", { direction: "up", value: 6 })
o3 = OverviewCardItem("unserved", o3top, o3bot)
o3top = IconText(o3icon, "danger", "m", "Unserved Households", "Below 25/3 Mbps", false, "horizontal")
o3icon = Icon("wifi-off", "devices")
o3bot = MetricIndicatorInline("7,180", "Households", { direction: "down", value: 9 })
tableCard = Card([tableHeader, tbl])
tableHeader = InlineHeader("Speed Tiers by Town", "Percent of households with access to each tier")
tbl = Table([Col("Town", towns), Col("Under 25 Mbps (%)", t1, "number"), Col("25-100 Mbps (%)", t2, "number"), Col("100-500 Mbps (%)", t3, "number"), Col("1 Gbps+ (%)", t4, "number")])
towns = ["Ashford", "Brookdale", "Cedar Falls", "Dunmore", "Eastwick", "Fairview", "Glenhaven", "Hartley"]
t1 = [4, 11, 7, 18, 14, 3, 21, 9]
t2 = [12, 24, 16, 30, 27, 8, 33, 20]
t3 = [31, 38, 34, 32, 35, 27, 29, 33]
t4 = [53, 27, 43, 20, 24, 62, 17, 38]
chartCard = Card([chartHeader, chart])
chartHeader = InlineHeader("Households Still Unserved", "Households without 25/3 Mbps service, by town")
chart = BarChart(towns, [s1], "grouped", "Town", "Households", 320)
s1 = Series("Unserved households", [310, 940, 560, 1420, 1180, 240, 1650, 880])
note = Callout("warning", "Priority Areas", "Glenhaven and Dunmore account for over 40% of unserved households and are top candidates for infrastructure funding.")