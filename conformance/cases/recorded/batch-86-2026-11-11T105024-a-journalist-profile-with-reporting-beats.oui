root = Stack([header, beatsHeader, beatsBlock, awardsHeader, awardsBlock, bioCard, investigationsHeader, investigationsBlock])
header = CardHeader("Maya Okafor", "Senior Investigative Correspondent, Metro Ledger")
beatsHeader = InlineHeader("Reporting Beats", "Areas of sustained coverage")
beatsBlock = TagBlock(["Municipal Finance", "Housing Policy", "Public Health", "Police Accountability", "Environmental Justice"], "md")
awardsHeader = InlineHeader("Awards", "Recognition for published work")
awardsBlock = Stack([award1, award2, award3], "row", "m", "stretch", "start", true)
award1 = Card([awardIcon1, award1title, award1sub], "card", "column", "s")
awardIcon1 = Icon("award", "achievement")
award1title = BoldText("text", "National Reporting Award", "2023", "text", "sm")
award1sub = TextContent("For a series exposing unlicensed eviction practices across three counties.", "small")
award2 = Card([awardIcon2, award2title, award2sub], "card", "column", "s")
awardIcon2 = Icon("trophy", "achievement")
award2title = BoldText("text", "Investigative Journalism Prize", "2020", "text", "sm")
award2sub = TextContent("Honored for reporting on municipal contract overruns in the transit authority.", "small")
award3 = Card([awardIcon3, award3title, award3sub], "card", "column", "s")
awardIcon3 = Icon("medal", "achievement")
award3title = BoldText("text", "Local Press Club Excellence Award", "2017", "text", "sm")
award3sub = TextContent("Recognized for a multi-part investigation into lead contamination in school buildings.", "small")
bioCard = Card([bioHeader, bioText])
bioHeader = InlineHeader("Biography", "Background and career")
bioText = MarkDownRenderer("Maya Okafor has spent over fifteen years covering city government, public health, and housing. She began her career as a general assignment reporter at a regional daily before joining the Metro Ledger's investigations desk in 2016. Her work has prompted policy reviews, two council hearings, and a state audit. She holds a degree in journalism from the University of Michigan and is a frequent guest lecturer on data-driven reporting methods.", "clear")
investigationsHeader = InlineHeader("Selected Investigations", "Notable long-form projects")
investigationsBlock = Stack([inv1, inv2, inv3], "row", "m", "stretch", "start", true)
inv1 = Card([inv1title, inv1desc, inv1tags], "card", "column", "s")
inv1title = BoldText("text", "Cracks in the Foundation", "2023", "text", "sm")
inv1desc = TextContent("A year-long review of building code violations and the inspectors who overlooked them.", "small")
inv1tags = TagBlock(["Housing", "Code Enforcement"], "sm")
inv2 = Card([inv2title, inv2desc, inv2tags], "card", "column", "s")
inv2title = BoldText("text", "The Water Below", "2021", "text", "sm")
inv2desc = TextContent("Tracing industrial runoff into municipal wells and the delayed regulatory response.", "small")
inv2tags = TagBlock(["Environment", "Public Health"], "sm")
inv3 = Card([inv3title, inv3desc, inv3tags], "card", "column", "s")
inv3title = BoldText("text", "Off the Books", "2019", "text", "sm")
inv3desc = TextContent("An analysis of overtime spending in the police department and missing audit records.", "small")
inv3tags = TagBlock(["Police Accountability", "Municipal Finance"], "sm")