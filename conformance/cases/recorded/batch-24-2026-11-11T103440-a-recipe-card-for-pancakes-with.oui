root = Stack([header, prepCard, ingredientsCard, stepsCard])
header = InlineHeader("Classic Pancakes", "Fluffy breakfast pancakes for the whole family")
prepCard = Card([prepInfo])
prepInfo = EntityList([prepRow, cookRow, servRow], "default")
prepRow = {left: "Prep time", right: "10 min"}
cookRow = {left: "Cook time", right: "15 min"}
servRow = {left: "Servings", right: "4 pancakes"}
ingredientsCard = Card([ingHeader, ingList])
ingHeader = CardHeader("Ingredients", "Pantry staples")
ingList = TagBlock(["1 cup all-purpose flour", "2 tbsp sugar", "2 tsp baking powder", "1/4 tsp salt", "1 cup milk", "1 egg", "2 tbsp melted butter", "1 tsp vanilla extract"])
stepsCard = Card([stepsHeader, stepsList])
stepsHeader = CardHeader("Steps", "Makes about 8 pancakes")
stepsList = Steps([s1, s2, s3, s4, s5])
s1 = StepsItem("Mix dry ingredients", "Whisk the flour, sugar, baking powder and salt in a large bowl.")
s2 = StepsItem("Combine wet ingredients", "In a separate bowl, beat the milk, egg, melted butter and vanilla.")
s3 = StepsItem("Join the batter", "Pour the wet mixture into the dry and stir until just combined. Lumps are fine.")
s4 = StepsItem("Rest the batter", "Let the batter sit for 5 minutes while you heat a lightly greased skillet over medium heat.")
s5 = StepsItem("Cook", "Pour about 1/4 cup batter per pancake. Flip when bubbles form and edges look set, then cook 1 to 2 minutes more.")