root = Stack([title, intro, chartCard, tableCard, note])
title = TextContent("City Budget Explainer: Proposed vs. Approved Spending", "large-heavy")
intro = TextContent("How the City Council's approved budget differs from the Mayor's original proposal, by department (in $ millions).")
chartCard = Card([chartHeader, chart])
chartHeader = CardHeader("Spending by Department", "Proposed vs. approved, $ millions")
chart = BarChart(depts, [sProposed, sApproved], "grouped", "Department", "Spending ($M)")
depts = ["Police", "Fire", "Public Works", "Parks", "Libraries", "Housing", "Transit", "Health"]
sProposed = Series("Proposed", [310, 185, 142, 64, 38, 72, 120, 88])
sApproved = Series("Approved", [298, 192, 151, 71, 41, 85, 118, 96])
tableCard = Card([tableHeader, tbl])
tableHeader = CardHeader("Changes by Department", "Approved minus proposed")
tbl = Table([Col("Department", depts), Col("Proposed ($M)", proposed, "number"), Col("Approved ($M)", approved, "number"), Col("Change ($M)", changes, "number"), Col("Change (%)", pct, "string"), Col("Direction", dirTags)])
proposed = [310, 185, 142, 64, 38, 72, 120, 88]
approved = [298, 192, 151, 71, 41, 85, 118, 96]
changes = [-12, 7, 9, 7, 3, 13, -2, 8]
pct = ["-3.9%", "+3.8%", "+6.3%", "+10.9%", "+7.9%", "+18.1%", "-1.7%", "+9.1%"]
dirTags = [t1, t2, t3, t4, t5, t6, t7, t8]
t1 = Tag("Cut", null, "sm", "danger")
t2 = Tag("Increase", null, "sm", "success")
t3 = Tag("Increase", null, "sm", "success")
t4 = Tag("Increase", null, "sm", "success")
t5 = Tag("Increase", null, "sm", "success")
t6 = Tag("Increase", null, "sm", "success")
t7 = Tag("Cut", null, "sm", "danger")
t8 = Tag("Increase", null, "sm", "success")
note = Callout("info", "Key takeaway", "Total spending rose from $1,019M proposed to $1,052M approved (+3.2%). Housing saw the largest percentage boost, while Police had the largest dollar reduction.")