root = Stack([heading, intro, fig1, fig2, fig3, fig4, fig5, creditsHeader, credits])
heading = TextContent("The Lantern Theatre: A Restoration in Four Frames", "large-heavy")
intro = TextContent("For three years, the 1921 Lantern Theatre sat behind scaffolding and plywood while crews worked to bring back its gilded proscenium, hand-painted ceiling, and original oak seating. These four images follow the work from first demolition to the reopening night.", "default")
fig1 = Card([img1, cap1], "card", "column", "s")
img1 = Image("Workers removing plaster from the theatre's east wall to expose original lath", "")
cap1 = TextContent("Stripping decades of plaster from the east wall revealed the original lath and hand-mixed lime mortar beneath.", "small")
fig2 = Card([img2, cap2], "card", "column", "s")
img2 = Image("Restorer applying gold leaf to a carved column capital in the auditorium", "")
cap2 = TextContent("A restorer applies 23-karat gold leaf to a carved capital, matching a pattern found in the 1921 archives.", "small")
fig3 = Card([img3, cap3], "card", "column", "s")
img3 = Image("Ceiling mural partially uncovered with conservators working on scaffolding", "")
cap3 = TextContent("Conservators clean the ceiling mural one square foot at a time, using cotton swabs and solvent gels.", "small")
fig4 = Card([img4, cap4], "card", "column", "s")
img4 = Image("Audience filling restored seats on opening night under warm house lights", "")
cap4 = TextContent("On reopening night, the restored house lights came up over 480 seats refinished in their original oak.", "small")
creditsHeader = InlineHeader("Photographer Credits", "Images used in this essay")
credits = EntityList([creditRow1, creditRow2, creditRow3, creditRow4])
creditRow1 = { left: "Figure 1", right: "Maya Ortiz" }
creditRow2 = { left: "Figure 2", right: "Daniel Okafor" }
creditRow3 = { left: "Figure 3", right: "Hannah Lindqvist" }
creditRow4 = { left: "Figure 4", right: "Samuel Reyes" }
fig5 = Card([img5, cap5], "card", "column", "s")
img5 = Image("The reopened Lantern Theatre auditorium at dusk, with its restored proscenium lit for a performance", "")
cap5 = TextContent("Restoration was completed on March 14, 2024, when the Lantern Theatre's gilded proscenium and hand-painted ceiling were lit for the first full season.", "small")