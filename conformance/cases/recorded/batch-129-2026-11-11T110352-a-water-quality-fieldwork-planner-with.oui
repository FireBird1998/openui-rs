root = Stack([header, kpis, sitesHeader, sitesTable, bottlesHeader, bottleChart, transHeader, transTable, cocHeader, cocSteps, cocForm])
header = CardHeader("Water-Quality Fieldwork Planner", "Sampling run: Tues 14 May — Riverbend Watershed")
kpis = SnippetCardBlock([k1, k2, k3, k4])
k1 = SnippetCardItem("sites", k1l, k1r)
k1l = IconText(k1i, "neutral", "m", "Sampling Sites", "Planned", false, "horizontal")
k1i = Icon("map-pin", "places")
k1r = BoldText("number", "6")
k2 = SnippetCardItem("bottles", k2l, k2r)
k2l = IconText(k2i, "neutral", "m", "Bottles", "Total required", false, "horizontal")
k2i = Icon("flask-conical", "science")
k2r = BoldText("number", "38")
k3 = SnippetCardItem("vehicles", k3l, k3r)
k3l = IconText(k3i, "neutral", "m", "Vehicles", "Assigned", false, "horizontal")
k3i = Icon("truck", "transport")
k3r = BoldText("number", "2")
k4 = SnippetCardItem("holdtime", k4l, k4r)
k4l = IconText(k4i, "neutral", "m", "Max Hold Time", "To lab", false, "horizontal")
k4i = Icon("clock", "time")
k4r = BoldText("text", "6 hrs")
sitesHeader = InlineHeader("Sampling Sites", "Locations, parameters and priority")
sitesTable = Table([Col("Site ID", siteIds), Col("Location", siteNames), Col("Waterbody", bodies), Col("Parameters", params), Col("Priority", prios)])
siteIds = ["RB-01", "RB-02", "RB-03", "RB-04", "RB-05", "RB-06"]
siteNames = ["Headwaters Bridge", "Mill Creek Confluence", "Oak Street Outfall", "Hatchery Pond", "Lower Weir", "Estuary Mouth"]
bodies = ["Riverbend River", "Mill Creek", "Riverbend River", "Pond", "Riverbend River", "Estuary"]
params = ["Nutrients, E. coli", "Metals, Nutrients", "E. coli, Metals, BOD", "Nutrients, DO", "Full suite", "Salinity, Nutrients"]
prios = [Tag("Routine", null, "sm", "neutral"), Tag("Routine", null, "sm", "neutral"), Tag("High", null, "sm", "danger"), Tag("Routine", null, "sm", "neutral"), Tag("Medium", null, "sm", "warning"), Tag("Medium", null, "sm", "warning")]
bottlesHeader = InlineHeader("Required Bottles", "By site and bottle type")
bottleChart = BarChart(siteIds, [b1, b2, b3], "stacked", "Site", "Bottles")
b1 = Series("1 L Plastic (nutrients)", [2, 2, 2, 2, 3, 2])
b2 = Series("250 mL Sterile (E. coli)", [1, 0, 2, 0, 2, 0])
b3 = Series("125 mL Acid-washed (metals)", [0, 2, 2, 0, 3, 0])
transHeader = InlineHeader("Transport Assignments", "Drivers, vehicles and cooler setup")
transTable = Table([Col("Vehicle", vehicles), Col("Driver", drivers), Col("Sites", routes), Col("Departs", departs), Col("Cooler", coolers)])
vehicles = ["Truck A", "Truck B"]
drivers = ["Maria Santos", "Tom Okafor"]
routes = ["RB-01, RB-02, RB-03", "RB-04, RB-05, RB-06"]
departs = ["07:30", "08:00"]
coolers = ["Cooler 1 — ice packs, 4°C", "Cooler 2 — ice packs, 4°C"]
cocHeader = InlineHeader("Chain-of-Custody Checklist", "Complete at each handoff")
cocSteps = Steps([s1, s2, s3, s4, s5])
s1 = StepsItem("Label bottles", "Pre-label with site ID, date, time, sampler initials and preservative.")
s2 = StepsItem("Record field data", "Log pH, temperature, conductivity and DO on the field sheet at collection.")
s3 = StepsItem("Seal and cool", "Place samples in the cooler at 4°C, seal with custody tape and note the temperature.")
s4 = StepsItem("Sign custody form", "Sampler signs, dates and times the relinquished section at every transfer.")
s5 = StepsItem("Lab receipt", "Lab verifies seals, temperature and bottle count, then signs the received section.")
cocForm = Form("custody", cocBtns, [f1, f2, f3])
f1 = FormControl("Checklist items completed", cocChecks)
cocChecks = CheckBoxGroup("coc", [c1, c2, c3, c4])
c1 = CheckBoxItem("Bottles labeled", "All labels legible and waterproof", "labeled")
c2 = CheckBoxItem("Field data recorded", "Field sheet complete", "fielddata")
c3 = CheckBoxItem("Cooler at 4°C", "Temperature logged", "cooler")
c4 = CheckBoxItem("Custody seal applied", "Seal number noted", "seal")
f2 = FormControl("Relinquished by", Input("sampler", "Sampler name", "text", { required: true }))
f3 = FormControl("Notes", TextArea("notes", "Deviations, damaged bottles, access issues...", 3))
cocBtns = Buttons([Button("Submit Custody Record", @ToAssistant("Submit chain-of-custody record"), "primary"), Button("Flag Issue", @ToAssistant("Flag a custody issue"), "secondary")])