root = Stack([header, table, statusCard])
header = InlineHeader("Spring Musical Auditions", "Performers, requested roles, slots and callback status")
table = Table([colPerformer, colRole, colSlot, colStatus])
colPerformer = Col("Performer", ["Maya Chen", "Diego Ramirez", "Priya Patel", "Owen Brooks", "Lena Fischer", "Jamal Carter"])
colRole = Col("Requested Role", ["Elphaba", "Fiyero", "Glinda", "Boq", "Nessarose", "Fiyero"])
colSlot = Col("Audition Slot", ["Sat 9:00 AM", "Sat 9:20 AM", "Sat 9:40 AM", "Sat 10:00 AM", "Sat 10:20 AM", "Sat 10:40 AM"])
colStatus = Col("Callback Status", [tagCallback1, tagPending, tagCallback2, tagDeclined, tagPending, tagCallback3], "action")
tagCallback1 = Tag("Callback", null, "sm", "success")
tagCallback2 = Tag("Callback", null, "sm", "success")
tagCallback3 = Tag("Callback", null, "sm", "success")
tagPending = Tag("Pending", null, "sm", "warning")
tagDeclined = Tag("Not Invited", null, "sm", "danger")
statusCard = Card([statusTitle, statusTags])
statusTitle = CardHeader("Callback Summary", "Current status across all auditioners")
statusTags = TagBlock(["3 Callbacks", "2 Pending", "1 Not Invited"], "md")