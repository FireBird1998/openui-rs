root = Stack([header, progressCard, nextCallout, stepsCard, actions])
header = InlineHeader("Welcome Onboarding", "Complete these five steps to get fully set up")
progressCard = Card([progressHeader, progressBar, progressList])
progressHeader = CardHeader("Your Progress", "2 of 5 steps completed (40%)")
progressBar = SingleStackedBarChart(["Completed", "Remaining"], [2, 3])
progressList = EntityList([{left: "Completed", right: "2", rightVariant: "number"}, {left: "Remaining", right: "3", rightVariant: "number"}], "default")
nextCallout = Callout("info", "Next up: Invite your team", "Step 3 is your next step. Invite at least one teammate to start collaborating.")
stepsCard = Card([stepsHeader, stepsList])
stepsHeader = CardHeader("Checklist", "Steps in order")
stepsList = Stack([s1, s2, s3, s4, s5], "column", "s")
s1 = Card([s1row], "sunk")
s1row = Stack([s1icon, s1text, s1tag], "row", "m", "center")
s1icon = IconText(i1, "success", "m", "1. Create your account", "Done on signup", false, "horizontal")
i1 = Icon("circle-check", "status")
s1text = TextContent("Account verified", "small")
s1tag = Tag("Completed", null, "sm", "success")
s2 = Card([s2row], "sunk")
s2row = Stack([s2icon, s2text, s2tag], "row", "m", "center")
s2icon = IconText(i2, "success", "m", "2. Complete your profile", "Name, photo and role", false, "horizontal")
i2 = Icon("circle-check", "status")
s2text = TextContent("Profile filled in", "small")
s2tag = Tag("Completed", null, "sm", "success")
s3 = Card([s3row, s3btn], "card")
s3row = Stack([s3icon, s3text, s3tag], "row", "m", "center")
s3icon = IconText(i3, "info", "m", "3. Invite your team", "Collaboration works best together", true, "horizontal")
i3 = Icon("users", "people")
s3text = TextContent("**Next step** — send invites by email", "small")
s3tag = Tag("Next", null, "sm", "info")
s3btn = Buttons([Button("Invite teammates", @ToAssistant("Help me invite my team"), "primary")])
s4 = Card([s4row], "sunk")
s4row = Stack([s4icon, s4text, s4tag], "row", "m", "center")
s4icon = IconText(i4, "neutral", "m", "4. Connect an integration", "Slack, GitHub or Google", false, "horizontal")
i4 = Icon("plug", "tools")
s4text = TextContent("Sync your tools", "small")
s4tag = Tag("Pending", null, "sm", "neutral")
s5 = Card([s5row], "sunk")
s5row = Stack([s5icon, s5text, s5tag], "row", "m", "center")
s5icon = IconText(i5, "neutral", "m", "5. Create your first project", "Start your first workspace", false, "horizontal")
i5 = Icon("folder-plus", "files")
s5text = TextContent("Kick off your work", "small")
s5tag = Tag("Pending", null, "sm", "neutral")
actions = Buttons([Button("Continue to step 3", @ToAssistant("Continue onboarding at step 3"), "primary"), Button("Skip for now", @ToAssistant("Skip the current onboarding step"), "tertiary")])