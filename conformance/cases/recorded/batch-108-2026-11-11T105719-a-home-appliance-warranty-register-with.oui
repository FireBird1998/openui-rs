root = Stack([header, table, actionsRow])
header = InlineHeader("Warranty Register", "Track coverage for your home appliances")
table = Table([colAppliance, colBrand, colPurchased, colExpiry, colStatus, colReceipts])
colAppliance = Col("Appliance", ["Refrigerator", "Washing Machine", "Dishwasher", "Oven", "Microwave"])
colBrand = Col("Brand", ["Samsung", "LG", "Bosch", "Whirlpool", "Panasonic"])
colPurchased = Col("Purchased", ["2023-03-14", "2022-11-02", "2024-01-20", "2021-07-08", "2023-09-30"])
colExpiry = Col("Coverage Expires", ["2026-03-14", "2025-11-02", "2027-01-20", "2024-07-08", "2026-09-30"])
colStatus = Col("Status", [statusFridge, statusWasher, statusDishwasher, statusOven, statusMicrowave])
statusFridge = Tag("Active", null, "sm", "success")
statusWasher = Tag("Expiring Soon", null, "sm", "warning")
statusDishwasher = Tag("Active", null, "sm", "success")
statusOven = Tag("Expired", null, "sm", "danger")
statusMicrowave = Tag("Active", null, "sm", "success")
colReceipts = Col("Receipts", [receiptFridge, receiptWasher, receiptDishwasher, receiptOven, receiptMicrowave], "action")
receiptFridge = Button("View Receipt", @ToAssistant("Show receipt for Samsung Refrigerator"), "secondary", "normal", "small")
receiptWasher = Button("View Receipt", @ToAssistant("Show receipt for LG Washing Machine"), "secondary", "normal", "small")
receiptDishwasher = Button("View Receipt", @ToAssistant("Show receipt for Bosch Dishwasher"), "secondary", "normal", "small")
receiptOven = Button("View Receipt", @ToAssistant("Show receipt for Whirlpool Oven"), "secondary", "normal", "small")
receiptMicrowave = Button("View Receipt", @ToAssistant("Show receipt for Panasonic Microwave"), "secondary", "normal", "small")
actionsRow = Buttons([addBtn, exportBtn])
addBtn = Button("Add Appliance", @ToAssistant("Add a new appliance to the warranty register"), "primary")
exportBtn = Button("Export Register", @ToAssistant("Export the warranty register"), "secondary")