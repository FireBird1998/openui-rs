root = Stack([header, measureCard, alterCard, scheduleCard, priceCard])
header = InlineHeader("Fitting Appointment", "Bespoke Tailoring Studio · Order #TLR-2847")
measureCard = Card([measureHeader, measureTable])
measureHeader = CardHeader("Garment Measurements", "Taken on 12 May 2025 by Marco Bellini")
measureTable = Table([Col("Measurement", measureLabels), Col("Inches", measureValues, "number"), Col("Notes", measureNotes)])
measureLabels = ["Chest", "Waist", "Hips", "Shoulder width", "Sleeve length", "Inseam", "Jacket length"]
measureValues = [40.0, 34.5, 39.0, 18.25, 25.5, 32.0, 29.0]
measureNotes = ["+0.5 ease", "Taken relaxed", "Standard", "Narrow shoulder", "Left arm 0.25 longer", "Trouser break 1 in", "Half-lined"]
alterCard = Card([alterHeader, alterList])
alterHeader = CardHeader("Requested Alterations", "Discussed with client")
alterList = ListBlock([alt1, alt2, alt3, alt4], "number")
alt1 = ListItem("Take in waist by 1 inch", "Darted back, center seam")
alt2 = ListItem("Shorten sleeves by 0.5 inch", "Maintain cuff button spacing")
alt3 = ListItem("Taper trouser legs", "Slim fit from knee to hem")
alt4 = ListItem("Replace horn buttons", "Mother-of-pearl, 6 pieces")
scheduleCard = Card([scheduleHeader, scheduleSteps])
scheduleHeader = CardHeader("Fitting Schedule", "Three sessions planned")
scheduleSteps = Steps([step1, step2, step3])
step1 = StepsItem("First fitting · 20 May 2025, 10:00", "Baste alterations and check drape and balance")
step2 = StepsItem("Second fitting · 27 May 2025, 14:30", "Refine shoulder line and trouser break")
step3 = StepsItem("Final fitting · 3 June 2025, 11:00", "Pressing and finishing check before collection")
priceCard = Card([priceHeader, priceList, priceTotal, priceButtons])
priceHeader = CardHeader("Estimated Price", "Excludes fabric already supplied")
priceList = EntityList([priceRow1, priceRow2, priceRow3, priceRow4], "default", priceHead, priceFoot)
priceHead = {left: "Item", right: "Cost", rightVariant: "text"}
priceRow1 = {left: "Alterations labour", right: "£185", rightVariant: "number"}
priceRow2 = {left: "Sleeve and cuff work", right: "£60", rightVariant: "number"}
priceRow3 = {left: "Button replacement (6)", right: "£36", rightVariant: "number"}
priceRow4 = {left: "Rush finishing", right: "£40", rightVariant: "number"}
priceFoot = {left: "Estimated total", right: "£321", rightVariant: "number"}
priceTotal = TextCallout("info", "Deposit paid", "£100 received; balance due at collection")
priceButtons = Buttons([confirmBtn, rescheduleBtn])
confirmBtn = Button("Confirm Appointment", @ToAssistant("Confirm my fitting appointment"), "primary")
rescheduleBtn = Button("Reschedule", @ToAssistant("I need to reschedule my fitting"), "secondary")