root = Stack([header, materialsCard, laborCard, summaryCard, actions])
header = InlineHeader("Workshop Cost Estimator", "Example estimate for a 20-person woodworking workshop")
materialsCard = Card([materialsHeader, materialsTable])
materialsHeader = CardHeader("Materials", "Quantities and unit prices")
materialsTable = Table([Col("Item", matItems), Col("Qty", matQty, "number"), Col("Unit Price ($)", matPrice, "number"), Col("Line Total ($)", matTotal, "number")])
matItems = ["Pine boards (6 ft)", "Wood screws (box)", "Wood glue (bottle)", "Sandpaper sheets", "Safety goggles", "Finish oil (quart)"]
matQty = [40, 10, 8, 100, 20, 5]
matPrice = [12.5, 8.75, 6.4, 0.9, 4.5, 18]
matTotal = [500, 87.5, 51.2, 90, 90, 90]
laborCard = Card([laborHeader, laborTable])
laborHeader = CardHeader("Labor", "Hours and hourly rates")
laborTable = Table([Col("Role", laborRoles), Col("Hours", laborHours, "number"), Col("Rate ($/hr)", laborRate, "number"), Col("Line Total ($)", laborTotal, "number")])
laborRoles = ["Lead instructor", "Assistant", "Setup and cleanup crew"]
laborHours = [6, 6, 4]
laborRate = [60, 30, 22]
laborTotal = [360, 180, 88]
summaryCard = Card([summaryHeader, summaryList, summaryNote])
summaryHeader = CardHeader("Summary", "Example total")
summaryList = EntityList([r1, r2, r3, r4], "default", null, footer)
r1 = { left: "Materials subtotal", right: "$908.70", rightVariant: "number" }
r2 = { left: "Labor subtotal", right: "$628.00", rightVariant: "number" }
r3 = { left: "Contingency (10%)", right: "$153.67", rightVariant: "number" }
r4 = { left: "Per attendee (20)", right: "$84.52", rightVariant: "number" }
footer = { left: "Estimated Total", right: "$1,690.37", rightVariant: "number" }
summaryNote = Callout("info", "Note", "Prices are sample values. Adjust quantities, rates and hours to match your workshop.")
actions = Buttons([Button("Adjust quantities", @ToAssistant("Help me adjust the material quantities"), "secondary"), Button("Export estimate", @ToAssistant("Export this estimate as a summary"), "primary")])