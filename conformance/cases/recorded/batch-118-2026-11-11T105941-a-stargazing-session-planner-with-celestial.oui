root = Stack([header, targetsHeader, targetCards, windowsHeader, windowsTable, checklistHeader, checklistCard, skyNote])
header = InlineHeader("Stargazing Session Planner", "Tonight's targets, viewing windows and gear")
targetsHeader = InlineHeader("Celestial Targets", "Ranked by altitude during the viewing window")
targetCards = OverviewCardBlock([t1, t2, t3])
t1 = OverviewCardItem("jupiter", t1top, t1bottom)
t1top = IconText(t1icon, "info", "m", "Jupiter", "Planet · Mag -2.4", true, "horizontal")
t1icon = Icon("planet", "space")
t1bottom = MetricIndicatorInline("68° altitude", "Best at 22:30")
t2 = OverviewCardItem("orion-nebula", t2top, t2bottom)
t2top = IconText(t2icon, "info", "m", "Orion Nebula (M42)", "Nebula · Mag 4.0", true, "horizontal")
t2icon = Icon("sparkles", "space")
t2bottom = MetricIndicatorInline("54° altitude", "Best at 23:10")
t3 = OverviewCardItem("andromeda", t3top, t3bottom)
t3top = IconText(t3icon, "info", "m", "Andromeda Galaxy (M31)", "Galaxy · Mag 3.4", true, "horizontal")
t3icon = Icon("telescope", "space")
t3bottom = MetricIndicatorInline("41° altitude", "Best at 00:20")
windowsHeader = InlineHeader("Viewing Windows", "Optimal observing times for each target")
windowsTable = Table([Col("Target", windowTargets), Col("Start", windowStart), Col("End", windowEnd), Col("Seeing", windowSeeing, "number")])
windowTargets = ["Jupiter", "Orion Nebula", "Andromeda Galaxy", "Pleiades"]
windowStart = ["21:30", "22:45", "23:30", "01:00"]
windowEnd = ["01:15", "03:00", "04:30", "05:15"]
windowSeeing = [4, 3, 3, 5]
checklistHeader = InlineHeader("Equipment Checklist", "Confirm gear before heading out")
checklistCard = Card([checklistItems, checklistBtns])
checklistItems = Form("gear", checklistBtns, [gearField1, gearField2])
gearField1 = FormControl("Equipment", gearChips, "Select everything you are bringing")
gearChips = Chips("gear", "multiple", [gear1, gear2, gear3, gear4, gear5])
gear1 = ChipItem("telescope", "Telescope", gear1icon)
gear1icon = Icon("telescope", "space")
gear2 = ChipItem("eyepieces", "Eyepieces", gear2icon)
gear2icon = Icon("eye", "tools")
gear3 = ChipItem("red-flashlight", "Red flashlight", gear3icon)
gear3icon = Icon("flashlight", "tools")
gear4 = ChipItem("star-chart", "Star chart / app", gear4icon)
gear4icon = Icon("map", "navigation")
gear5 = ChipItem("warm-layers", "Warm layers", gear5icon)
gear5icon = Icon("snowflake", "weather")
gearField2 = FormControl("Mount", mountOptions, "Choose your mount type")
mountOptions = RadioGroup("mount", [mountAlt, mountEq])
mountAlt = RadioItem("Alt-azimuth", "Simple and quick to set up", "altaz")
mountEq = RadioItem("Equatorial", "Tracks objects as the sky rotates", "eq")
checklistBtns = Buttons([Button("Save Checklist", @ToAssistant("Save my equipment checklist"), "primary"), Button("Reset", @ToAssistant("Reset equipment checklist"), "secondary")])
skyNote = Callout("info", "Sky Conditions", "Clear skies expected with light winds and about 15% humidity. Seeing is good after 22:00, though a thin haze may appear near the horizon around midnight.")