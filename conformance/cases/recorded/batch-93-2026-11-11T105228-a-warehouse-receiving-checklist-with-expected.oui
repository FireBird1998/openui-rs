root = Stack([header, summary, discrepancy, shipmentsHeader, shipTable, formHeader, form])
header = CardHeader("Warehouse Receiving Checklist", "Dock 3 · Inbound shipments for today")
summary = SnippetCardBlock([s1, s2, s3])
s1 = SnippetCardItem("expected", s1l, s1r)
s1l = IconText(s1i, "neutral", "m", "Expected Shipments", "Scheduled today", false, "horizontal")
s1i = Icon("truck", "shipping")
s1r = BoldText("number", "4")
s2 = SnippetCardItem("received", s2l, s2r)
s2l = IconText(s2i, "neutral", "m", "Fully Received", "Matches PO", false, "horizontal")
s2i = Icon("circle-check", "status")
s2r = BoldText("number", "1")
s3 = SnippetCardItem("issues", s3l, s3r)
s3l = IconText(s3i, "warning", "m", "With Discrepancies", "Needs review", false, "horizontal")
s3i = Icon("triangle-alert", "status")
s3r = BoldText("number", "3")
discrepancy = Callout("warning", "3 shipments have discrepancies", "SHP-2043 is short 12 units, SHP-2044 has 5 damaged cartons, and SHP-2046 is over by 8 units. Notify the purchasing team before signing off.")
shipmentsHeader = InlineHeader("Shipment Reconciliation", "Expected vs. counted quantities")
shipTable = Table([cId, cSup, cItem, cExp, cCnt, cVar, cDmg, cStatus])
cId = Col("Shipment", ["SHP-2041", "SHP-2043", "SHP-2044", "SHP-2046"])
cSup = Col("Supplier", ["Acme Packaging", "Northwind Foods", "Globex Parts", "Initech Supply"])
cItem = Col("Item", ["Corrugated boxes", "Canned tomatoes", "Pallet wrap", "Label rolls"])
cExp = Col("Expected", [200, 480, 150, 320], "number")
cCnt = Col("Counted", [200, 468, 150, 328], "number")
cVar = Col("Variance", [0, -12, 0, 8], "number")
cDmg = Col("Damaged Notes", ["None", "None", "5 cartons crushed, water stained", "Outer wrap torn, contents intact"])
cStatus = Col("Status", [t1, t2, t3, t4])
t1 = Tag("Matched", null, "sm", "success")
t2 = Tag("Short", null, "sm", "danger")
t3 = Tag("Damaged", null, "sm", "warning")
t4 = Tag("Over", null, "sm", "info")
formHeader = InlineHeader("Receiving Check", "Complete for each shipment")
form = Form("receiving", formBtns, [f1, f2, f3, f4, f5])
f1 = FormControl("Shipment", Select("shipment", shipOpts, "Select shipment", { required: true }))
shipOpts = [SelectItem("SHP-2041", "SHP-2041"), SelectItem("SHP-2043", "SHP-2043"), SelectItem("SHP-2044", "SHP-2044"), SelectItem("SHP-2046", "SHP-2046")]
f2 = FormControl("Counted Quantity", Input("counted", "Enter units counted", "number", { required: true, min: 0 }))
f3 = FormControl("Checklist", CheckBoxGroup("checks", [c1, c2, c3, c4]))
c1 = CheckBoxItem("Seals intact", "Trailer and carton seals unbroken", "seals")
c2 = CheckBoxItem("Packing slip matches PO", "Document verified against purchase order", "slip")
c3 = CheckBoxItem("Labels readable", "Barcodes scan correctly", "labels")
c4 = CheckBoxItem("Pallets in good condition", "No broken boards or leaning stacks", "pallets")
f4 = FormControl("Damaged Item Notes", TextArea("damageNotes", "Describe any damage, quantity affected, photos taken...", 4))
f5 = FormControl("Receiver Sign-off Date", DatePicker("signDate", "single", { required: true }))
formBtns = Buttons([Button("Submit Receipt", @ToAssistant("Submit receiving check"), "primary"), Button("Flag Discrepancy", @ToAssistant("Flag a discrepancy for this shipment"), "secondary", "destructive")])