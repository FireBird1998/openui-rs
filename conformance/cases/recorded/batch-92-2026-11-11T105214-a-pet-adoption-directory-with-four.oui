root = Stack([header, cards])
header = InlineHeader("Adoptable Pets", "Four friends looking for a home")
cards = Stack([petA, petB, petC, petD], "row", "m", "stretch", "start", true)
petA = Card([photoA, nameA, ageA, tagsA, btnA])
photoA = ImageBlock("https://images.unsplash.com/photo-1543466835-00a7907e9de1?w=600", "Golden retriever puppy")
nameA = CardHeader("Biscuit", "Golden Retriever")
ageA = TextContent("Age: 1 year", "small")
tagsA = TagBlock(["Playful", "Friendly", "Good with kids"])
btnA = Button("Meet & Greet", @ToAssistant("Schedule a meet and greet with Biscuit"), "primary")
petB = Card([photoB, nameB, ageB, tagsB, btnB])
photoB = ImageBlock("https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?w=600", "Tabby cat resting")
nameB = CardHeader("Mochi", "Domestic Shorthair Cat")
ageB = TextContent("Age: 3 years", "small")
tagsB = TagBlock(["Calm", "Affectionate", "Indoor"])
btnB = Button("Meet & Greet", @ToAssistant("Schedule a meet and greet with Mochi"), "primary")
petC = Card([photoC, nameC, ageC, tagsC, btnC])
photoC = ImageBlock("https://images.unsplash.com/photo-1583511655857-d19b40a7a54e?w=600", "Gray and white rabbit")
nameC = CardHeader("Clover", "Holland Lop Rabbit")
ageC = TextContent("Age: 2 years", "small")
tagsC = TagBlock(["Gentle", "Quiet", "Litter trained"])
btnC = Button("Meet & Greet", @ToAssistant("Schedule a meet and greet with Clover"), "primary")
petD = Card([photoD, nameD, ageD, tagsD, btnD])
photoD = ImageBlock("https://images.unsplash.com/photo-1518717758536-85ae29035b6d?w=600", "Grey dog with a sunny face")
nameD = CardHeader("Ranger", "Australian Shepherd Mix")
ageD = TextContent("Age: 5 years", "small")
tagsD = TagBlock(["Energetic", "Loyal", "Trained"])
btnD = Button("Meet & Greet", @ToAssistant("Schedule a meet and greet with Ranger"), "primary")