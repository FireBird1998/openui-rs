root = Stack([header, kpis, overdueCallout, tabs])
header = CardHeader("Civic Data Request Tracker", "Public records requests, agency responses, and overdue notices")
kpis = SnippetCardBlock([k1, k2, k3, k4])
k1 = SnippetCardItem("total", k1l, k1r)
k1l = IconText(k1i, "neutral", "m", "Total Requests", "All time", false, "horizontal")
k1i = Icon("file-text", "files")
k1r = BoldText("number", "8")
k2 = SnippetCardItem("fulfilled", k2l, k2r)
k2l = IconText(k2i, "success", "m", "Fulfilled", "Documents received", false, "horizontal")
k2i = Icon("circle-check", "status")
k2r = BoldText("number", "3")
k3 = SnippetCardItem("pending", k3l, k3r)
k3l = IconText(k3i, "info", "m", "Pending", "Within deadline", false, "horizontal")
k3i = Icon("clock", "time")
k3r = BoldText("number", "2")
k4 = SnippetCardItem("overdue", k4l, k4r)
k4l = IconText(k4i, "danger", "m", "Overdue", "Past deadline", false, "horizontal")
k4i = Icon("triangle-alert", "status")
k4r = BoldText("number", "3")
overdueCallout = Callout("warning", "3 requests are overdue", "Agencies have exceeded the statutory response window. Consider sending follow-up notices or filing an appeal.")
tabs = Tabs([tAll, tOver])
tAll = TabItem("all", "All Requests", [allTable])
tOver = TabItem("overdue", "Overdue Notices", [overdueList, overdueTable])
allTable = Table([Col("ID", ids), Col("Document Requested", docs), Col("Agency", agencies), Col("Submitted", dates), Col("Status", statusTags)])
ids = ["REQ-1041", "REQ-1042", "REQ-1043", "REQ-1044", "REQ-1045", "REQ-1046", "REQ-1047", "REQ-1048"]
docs = ["City budget FY2024 line items", "Police use-of-force reports 2023", "Water quality test results", "School district bus contracts", "Zoning variance approvals", "Road repair expenditures", "Health inspection records", "Public transit ridership data"]
agencies = ["Finance Dept.", "Police Dept.", "Water Authority", "School District", "Planning Commission", "Public Works", "Health Dept.", "Transit Agency"]
dates = ["2024-01-08", "2024-01-15", "2024-02-02", "2024-02-20", "2024-03-05", "2024-03-18", "2024-04-02", "2024-04-10"]
statusTags = [Tag("Fulfilled", null, "sm", "success"), Tag("Overdue", null, "sm", "danger"), Tag("Fulfilled", null, "sm", "success"), Tag("Overdue", null, "sm", "danger"), Tag("Fulfilled", null, "sm", "success"), Tag("Overdue", null, "sm", "danger"), Tag("Pending", null, "sm", "info"), Tag("Pending", null, "sm", "info")]
overdueList = Callout("error", "Action needed", "The requests below have passed the 20 business day response deadline.")
overdueTable = Table([Col("ID", oIds), Col("Agency", oAg), Col("Due Date", oDue), Col("Days Overdue", oDays, "number"), Col("Action", oActs)])
oIds = ["REQ-1042", "REQ-1044", "REQ-1046"]
oAg = ["Police Dept.", "School District", "Public Works"]
oDue = ["2024-02-13", "2024-03-19", "2024-04-15"]
oDays = [96, 61, 34]
oActs = [b1, b2, b3]
b1 = Button("Send Notice", @ToAssistant("Draft an overdue notice for REQ-1042 to the Police Dept."), "primary", "destructive", "small")
b2 = Button("Send Notice", @ToAssistant("Draft an overdue notice for REQ-1044 to the School District"), "primary", "destructive", "small")
b3 = Button("Send Notice", @ToAssistant("Draft an overdue notice for REQ-1046 to Public Works"), "primary", "destructive", "small")