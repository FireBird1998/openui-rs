root = Stack([heroCard, summaryCard, accessCard, screeningsCard])
heroCard = Card([posterImg, heroHeader, heroTags])
posterImg = Image("Official poster for the documentary Harbor Lights")
heroHeader = CardHeader("Harbor Lights", "Documentary · 96 min · Directed by Maya Ortiz")
heroTags = TagBlock(["Documentary", "English / Spanish", "PG-13"])
summaryCard = Card([sumHeader, criticQuote, ratingList])
sumHeader = InlineHeader("Critic's Summary", "Consensus from 42 reviews")
criticQuote = TextContent("A patient, deeply humane portrait of a fishing town facing its last season. Ortiz trusts her subjects and her audience, letting silence do much of the work. The score occasionally oversteps, but the film's emotional honesty carries it.")
ratingList = EntityList([ratingCritic, ratingAudience, ratingReviews], "default")
ratingCritic = {left: "Critic score", right: "4.5 / 5", rightVariant: "number"}
ratingAudience = {left: "Audience score", right: "88%", rightVariant: "number"}
ratingReviews = {left: "Reviews counted", right: "42", rightVariant: "number"}
accessCard = Card([accHeader, accList])
accHeader = InlineHeader("Accessibility", "Plan your visit")
accList = EntityList([accCaptions, accAudio, accWheelchair, accHearing, accSensory], "default")
accCaptions = {left: "Closed captions", right: "English and Spanish"}
accAudio = {left: "Audio description", right: "Select screenings"}
accWheelchair = {left: "Wheelchair access", right: "Step-free entrance, reserved seating"}
accHearing = {left: "Hearing loop", right: "Installed in Theater 2"}
accSensory = {left: "Sensory-friendly", right: "Monthly, lights up, lower volume"}
screeningsCard = Card([scrHeader, scrTable])
scrHeader = InlineHeader("Upcoming Screenings", "Access options are listed per showing")
scrTable = Table([Col("Date", dates), Col("Venue", venues), Col("Time", times), Col("Access", access)])
dates = ["Sat, Jun 14", "Sun, Jun 15", "Thu, Jun 19", "Sat, Jun 21"]
venues = ["Harbor Cinema", "Riverside Arts Hall", "Harbor Cinema", "Old Town Theater"]
times = ["6:30 PM", "2:00 PM", "7:15 PM", "4:00 PM"]
access = ["Captions, Step-free", "Audio description", "Sensory-friendly", "Hearing loop, Captions"]