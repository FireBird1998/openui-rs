root = Stack([header, cards])
header = InlineHeader("Weekend Weather", "Saturday and Sunday forecast")
cards = Stack([cardNyc, cardLon, cardTok], "row", "m", "stretch", "start", true)
cardNyc = Card([nycHeader, nycBody], "card", "column", "s")
nycHeader = CardHeader("New York", "Sat & Sun")
nycBody = Stack([nycHi, nycLo, nycFc], "column", "xs")
nycHi = Text("number", "High: 72°F", "", "text", "lg")
nycLo = Text("number", "Low: 58°F", "", "text", "md")
nycFc = TextContent("Partly cloudy, light breeze, dry both days.", "small")
cardLon = Card([lonHeader, lonBody], "card", "column", "s")
lonHeader = CardHeader("London", "Sat & Sun")
lonBody = Stack([lonHi, lonLo, lonFc], "column", "xs")
lonHi = Text("number", "High: 61°F", "", "text", "lg")
lonLo = Text("number", "Low: 49°F", "", "text", "md")
lonFc = TextContent("Overcast with occasional light rain Sunday.", "small")
cardTok = Card([tokHeader, tokBody], "card", "column", "s")
tokHeader = CardHeader("Tokyo", "Sat & Sun")
tokBody = Stack([tokHi, tokLo, tokFc], "column", "xs")
tokHi = Text("number", "High: 78°F", "", "text", "lg")
tokLo = Text("number", "Low: 63°F", "", "text", "md")
tokFc = TextContent("Sunny Saturday, clouds building Sunday afternoon.", "small")