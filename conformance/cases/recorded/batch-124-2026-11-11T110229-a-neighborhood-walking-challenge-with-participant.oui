root = Stack([header, summaryRow, progressCard, milestonesCard])
header = InlineHeader("Neighborhood Walking Challenge", "Weekly participant steps and milestones")
summaryRow = Stack([totalKpi, leaderKpi, avgKpi], "row", "m", "stretch", "start", true)
totalKpi = Card([TextContent("Total Steps", "small"), TextContent("" + @Sum(data.steps), "large-heavy")])
leaderKpi = Card([TextContent("Top Walker", "small"), TextContent("Maya R.", "large-heavy")])
avgKpi = Card([TextContent("Avg per Participant", "small"), TextContent("" + @Sum(data.steps) / @Count(data.names), "large-heavy")])
progressCard = Card([CardHeader("Weekly Progress", "Steps per participant this week"), chart])
chart = BarChart(data.names, [stepSeries], "grouped", "Participant", "Steps")
stepSeries = Series("Steps", data.steps)
milestonesCard = Card([CardHeader("Milestone Badges", "Earned by participants"), milestoneTable])
milestoneTable = Table([Col("Participant", data.names), Col("Steps", data.steps, "number"), Col("Badges", @Each(data.badges, "b", TagBlock(b)))])