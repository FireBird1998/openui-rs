root = Root([Text("x")])
$rows = [{n: 3, name: "b"}, {n: 1, name: "a"}, {n: 2, name: "C"}]
$count = @Count($rows)
$first = @First($rows)
$last = @Last($rows).name
$sum = @Sum($rows.n)
$avg = @Avg([1, 2, 4])
$min = @Min([3, "1", true])
$max = @Max([])
$sorted = @Sort($rows, "n")
$byName = @Sort($rows, "name", "desc")
$filtered = @Filter($rows, "n", ">", 1)
$contains = @Filter(["apple", "banana", "cherry"], "", "contains", "an")
$loose = @Filter([1, "1", true, null], "", "==", 1)
$round = @Round(2.5)
$negative = @Round(-2.5)
$roundList = @Round([1.234, [2.345, null]], 2)
$abs = @Abs(-3)
$floor = @Floor([1.5, -1.5])
$ceil = @Ceil("2.1")
$each = @Each([1, 2, 3], "x", x * 10)
$eachObj = @Each($rows, "r", r.name + "!")
$nested = @Each([[1, 2], [3]], "xs", @Sum(xs))
