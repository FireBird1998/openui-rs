a = 1 + 2 * 3 - 4 / 2 % 3
b = !$p == $q && -$r.s || $t != 1 >= 2
c = $a ? $b ? 1 : 2 : $c ? 3 : 4
d = ($a ? x : y).z[0]["k"].w
e = $x = $y = $z + 1
f = {$k: 1, "q": 2, 3: 4, Type: 5, [: 6, 7}
g = [1, , 2, ]
h = obj.$s + obj.12 + obj."s" + obj.Type + obj.)
i = @Each(xs, "x", Text(x.name)) + Action([@Set($a, 1)]) + Count(xs) + @Count
j = f(1) + -(-1) + !!$b + (1, 2)
k = $cond
  ? "multi"
  : "line"
root = Root([Text(a), Text(b), Text(c), Text(d), Text(e), Text(f), Text(g), Text(h), Text(i), Text(j), Text(k)])