root = Root([Text("x")])
$hex = ["0x1f" * 1, "0X1F" * 1, "0x" * 1, "0xg" * 1, "0x1fffffffffffffffffffffff" * 1]
$octal = ["0o17" * 1, "0O17" * 1, "0o8" * 1]
