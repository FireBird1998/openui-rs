$infinite = ["Infinity" * 1, "+Infinity" * 1, "-Infinity" * 1, "infinity" * 1, " Infinity " * 1]
$decimal = [" 12 " * 1, "1e3" * 1, "1E-2" * 1, "1e" * 1, "e3" * 1, ".5" * 1, "5." * 1, "." * 1, "+.5" * 1, "-5" * 1, "1e+2" * 1, "1.2.3" * 1, "12abc" * 1, "" * 1, "  " * 1, "0" * 1, "00" * 1, "-0x10" * 1, "1_0" * 1]
$asCompared = ["0x10" == 16, "0b11" == 3, "0o7" == 7, "Infinity" == 1 / 0, "1e3" == 1000, " 7 " == 7, "x" == 0, "0x" == 0, "0o" == 0, "0b" == 0, "0" == 0, "00" == 0, "1e" == 1, "-Infinity" == "Infinity" * -1, "Infinity" == "Infinity" * 1]
$exponents = ["1e+" == 0, "1ex" == 0, "1e5e5" == 0, "1.e5" * 1, ".e5" == 0, "1E05" * 1, "1e-" == 0, "1e+5" * 1, "-1.5e1" * 1, "1e5" == 100000, "1e" == 0]
