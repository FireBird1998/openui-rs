root = Root([Text("x")])
$rows = [{n: 1, t: "a"}, {n: 2, t: "b"}]
$members = @Each($rows, "r", r.n + 1)
$unary = @Each([1, 0, 3], "x", [-x, !x])
$ternary = @Each([1, 0], "x", x ? "on" : "off")
$nested = @Each([1, 2], "x", @Each([10, 20], "y", x + y))
$shadowed = @Each([1, 2], "x", @Each([10, 20], "x", x))
$outer = @Each([1, 2], "x", @Each([10], "y", [x, y, z]))
$unnamed = @Each([1, 2], "", 5)
$refName = @Each([1, 2], i, i * 2)
$objects = @Each([1, 2], "x", {v: x, w: [x, {u: x}], s: "x"})
$indexes = @Each([[5, 6], [7, 8]], "p", p[1])
$untouched = @Each([1, 2], "x", [3, "y", {k: 4}])
$calls = @Each([[3, 1, 2]], "a", @Sort(a, ""))
