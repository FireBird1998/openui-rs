{
  "schema": {
    "$defs": {
      "Box": {
        "properties": {
          "value": {},
          "action": {}
        }
      }
    }
  },
  "scenarios": [
    {
      "name": "settle, click with current state, double submit, retry, resume writes and events",
      "steps": [
        {
          "replace": "$n=1\n$tool=\"save\"\nm=Mutation($tool,{n:$n})\nq=Query(\"read\",{n:$n})\nroot=Box([m,q],Action([@OpenUrl(\"before\"),@Run(m),@Set($n,m.data),@ToAssistant(\"done\")]))",
          "streaming": true
        },
        {
          "settle": true
        },
        {
          "finish": 0,
          "value": 1
        },
        {
          "set": "$tool",
          "value": "new"
        },
        {
          "set": "$n",
          "value": 3
        },
        {
          "click": true
        },
        {
          "click": true
        },
        {
          "finish": 2,
          "failed": "offline"
        },
        {
          "click": true
        },
        {
          "finish": 3,
          "value": 8
        },
        {
          "finish": 4,
          "value": 8
        },
        {
          "replace": "$n=1\n$tool=\"save\"\nm=Mutation($tool,{n:$n})\nq=Query(\"read\",{n:$n})\nroot=Box([m,q],Action([@OpenUrl(\"before\"),@Run(m),@Set($n,m.data),@ToAssistant(\"done\")]))"
        }
      ]
    },
    {
      "name": "chained suspensions, failed tail and registration removal",
      "steps": [
        {
          "replace": "$n=2\nm=Mutation(\"first\", {n:$n})\nn=Mutation(\"second\",m.data)\nroot=Box([m,n],Action([@Set($n,$n+1),@Run(m),@OpenUrl(\"between\"),@Run(n),@OpenUrl(\"last\")]))"
        },
        {
          "click": true
        },
        {
          "finish": 0,
          "value": {
            "id": 9
          }
        },
        {
          "finish": 1,
          "failed": "offline"
        },
        {
          "click": true
        },
        {
          "replace": "root=Box(\"gone\")"
        },
        {
          "finish": 2,
          "value": 4
        }
      ]
    },
    {
      "name": "bounded-pending-mutation-plans",
      "maxContinuations": 1,
      "steps": [
        {
          "replace": "m=Mutation(\"old\")\nroot=Box(m,@Run(m))"
        },
        {
          "click": true
        },
        {
          "replace": "m=Mutation(\"new\")\nroot=Box(m,@Run(m))"
        },
        {
          "click": true
        }
      ]
    },
    {
      "name": "numeric-mutation-tool-name",
      "steps": [
        {"replace":"m=Mutation(7)\nroot=Box(m,@Run(m))"},
        {"click":true},
        {"finish":0,"failed":"offline"}
      ]
    },
    {
      "name": "mutation then query with success",
      "steps": [
        {"replace":"$n=1\nq=Query(\"read\",{n:$n},0)\nm=Mutation(\"save\",{n:$n})\nroot=Box([m,q,$n],Action([@Run(m),@Run(q),@Set($n,m.data),@OpenUrl(\"done\")]))"},
        {"finish":0,"value":10},
        {"click":true},
        {"finish":1,"value":2},
        {"finish":2,"value":20},
        {"finish":3,"value":30}
      ]
    },
    {
      "name": "mutation then query with failure",
      "steps": [
        {"replace":"$n=1\nq=Query(\"read\",{n:$n},0)\nm=Mutation(\"save\",{n:$n})\nroot=Box([m,q,$n],Action([@Run(m),@Run(q),@Set($n,m.data),@OpenUrl(\"done\")]))"},
        {"finish":0,"value":10},
        {"click":true},
        {"finish":1,"failed":"offline"}
      ]
    },
    {
      "name": "query then mutation with success",
      "steps": [
        {"replace":"$n=1\nq=Query(\"read\",{n:$n},0)\nm=Mutation(\"save\",{n:$n})\nroot=Box([m,q,$n],Action([@Run(q),@Run(m),@Set($n,m.data),@OpenUrl(\"done\")]))"},
        {"finish":0,"value":10},
        {"click":true},
        {"finish":2,"value":2},
        {"finish":1,"value":20},
        {"finish":3,"value":30}
      ]
    },
    {
      "name": "query then mutation with failure",
      "steps": [
        {"replace":"$n=1\nq=Query(\"read\",{n:$n},0)\nm=Mutation(\"save\",{n:$n})\nroot=Box([m,q,$n],Action([@Run(q),@Run(m),@Set($n,m.data),@OpenUrl(\"done\")]))"},
        {"finish":0,"value":10},
        {"click":true},
        {"finish":2,"failed":"offline"},
        {"finish":1,"value":20}
      ]
    },
    {
      "name": "write then query then mutation with success",
      "steps": [
        {"replace":"$n=1\nq=Query(\"read\",{n:$n},0)\nm=Mutation(\"save\",{n:$n})\nroot=Box([m,q,$n],Action([@Set($n,$n+1),@Run(q),@Run(m),@OpenUrl(\"done\")]))"},
        {"finish":0,"value":10},
        {"click":true},
        {"finish":2,"value":2},
        {"finish":1,"value":20},
        {"finish":3,"value":30}
      ]
    },
    {
      "name": "write then query then mutation with failure",
      "steps": [
        {"replace":"$n=1\nq=Query(\"read\",{n:$n},0)\nm=Mutation(\"save\",{n:$n})\nroot=Box([m,q,$n],Action([@Set($n,$n+1),@Run(q),@Run(m),@OpenUrl(\"done\")]))"},
        {"finish":0,"value":10},
        {"click":true},
        {"finish":2,"failed":"offline"},
        {"finish":1,"value":20},
        {"finish":3,"value":30}
      ]
    },
    {
      "name": "a bare streaming click uses the last registered tool and the current arguments",
      "steps": [
        {"replace":"m=Mutation(\"original\",{version:1})\nroot=Box(m,@Run(m))"},
        {"replace":"m=Mutation(\"renamed\",{version:2})\nn=Mutation(\"fresh\")\nroot=Box([m,n],Action([@Run(m),@Run(n),@OpenUrl(\"done\")]))","streaming":true},
        {"click":true},
        {"finish":0,"value":"before settle"},
        {"settle":true},
        {"click":true},
        {"finish":1,"value":"after settle"},
        {"finish":2,"value":"fresh result"}
      ]
    },
    {
      "name": "a shared statement id reads the mutation and runs the tagged target",
      "steps": [
        {"replace":"s=Query(\"read\",{},9)\n$plan={steps:[{type:\"run\",refType:\"query\",statementId:\"s\"},{type:\"run\",refType:\"mutation\",statementId:\"s\"},{type:\"run\",refType:\"query\",statementId:\"s\"},{type:\"open_url\",url:\"done\"}]}\nroot=Box(s,$plan)","alsoRegisterMutations":"s=Mutation(\"save\",{n:42})"},
        {"finish":0,"value":10},
        {"click":true},
        {"finish":2,"value":20},
        {"finish":1,"value":30},
        {"finish":3,"value":40}
      ]
    },
    {
      "name": "a resumed write changes reader arguments after its query run uses the registered arguments",
      "steps": [
        {
          "replace": "$n=0\nm=Mutation(\"save\")\na=Query(\"read\",{source:true})\nb=Query(\"read\",{v:a,n:$n,s:m.status})\nroot=Box([a,b,m],Action([@Run(m),@Set($n,m.data),@Run(b),@ToAssistant(\"done\")]))"
        },
        {
          "finish": 0,
          "value": "input"
        },
        {
          "finish": 1,
          "value": "first"
        },
        {
          "click": true
        },
        {
          "finish": 2,
          "value": 7
        },
        {
          "finish": 3,
          "value": "previous"
        },
        {
          "finish": 4,
          "value": "current"
        }
      ]
    },
    {
      "name": "a query-tagged read waits for query data and evaluates the mutation of the same name",
      "steps": [
        {
          "replace": "s=Query(\"read\",{})\nb=Query(\"read\",{phase:s.status,data:s.data})\n$plan={steps:[{type:\"run\",refType:\"mutation\",statementId:\"s\"}]}\nroot=Box([s,b],$plan)",
          "alsoRegisterMutations": "s=Mutation(\"save\")"
        },
        {
          "click": true
        },
        {
          "finish": 1,
          "value": "mutation"
        },
        {
          "finish": 0,
          "value": "query"
        },
        {
          "finish": 2,
          "value": "seen"
        }
      ]
    }
  ]
}
