        ]
      },
      {
        "name": "Content",
        "components": [
          "TextContent",
          "Table",
          "Missing",
          "Card"
        ]
      },
      {
        "name": "Forms",
        "components": [
          "Select",
          "SelectItem"
        ],
        "notes": []
      }
    ]
  },
  "promptOptions": {
    "tools": [
      "search"
    ],
