<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Sandbox, with network access for MCP and the Gateway. No Keychain access
	     group and no associated domains: the app is signed for local use
	     without a paid developer account, and its Keychain item belongs to
	     its own signature. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- The MCP browser hand-back listens on 127.0.0.1. -->
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
