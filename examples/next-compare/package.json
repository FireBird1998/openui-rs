{
  "name": "openui-next-compare",
  "private": true,
  "type": "module",
  "description": "Upstream OpenUI's JavaScript parser and openui-rs's WebAssembly core, side by side under the same React renderer.",
  "scripts": {
    "wasm": "node scripts/copy-wasm.mjs",
    "inputs": "node scripts/inputs.mjs",
    "predev": "npm run wasm && npm run inputs",
    "dev": "next dev",
    "prebuild": "npm run wasm && npm run inputs",
    "build": "next build --profile",
    "start": "next start",
    "precompare": "npm run wasm && npm run inputs",
    "compare": "node scripts/compare.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openuidev/lang-core": "1.1.0",
    "@openuidev/react-headless": "0.18.1",
    "@openuidev/react-lang": "1.1.0",
    "@openuidev/react-ui": "0.18.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.3.6",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
